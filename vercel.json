{
  "redirects": [
    {
      "source": "/",
      "destination": "/ko/",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/ko/about/",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "/ko/blog/",
      "permanent": false
    },
    {
      "source": "/library",
      "destination": "/ko/library/",
      "permanent": false
    },
    {
      "source": "/search",
      "destination": "/ko/search/",
      "permanent": false
    },
    {
      "source": "/paths",
      "destination": "/ko/paths/",
      "permanent": false
    },
    {
      "source": "/archive",
      "destination": "/ko/blog/",
      "permanent": false
    },
    {
      "source": "/:lang(ko|jp|en)/blog/tech/chat/:path*",
      "destination": "/:lang/blog/technical_note/chat/:path*",
      "permanent": false
    },
    {
      "source": "/blog/tech/chat/:path*",
      "destination": "/ko/blog/technical_note/chat/:path*",
      "permanent": false
    },
    {
      "source": "/:lang(ko|jp|en)/blog/page/:page",
      "destination": "/:lang/blog/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/decks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at https://giscus.app https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://giscus.app; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https: blob:; connect-src 'self' https://*.goatcounter.com https://giscus.app https://api.github.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://giscus.app; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
