# Future configuration keys for Study Engine. There is no executable CLI yet.
# Local runs by default (GitHub Actions only later, for public notes). Never load the blog's .env.
# Provider: gemini (default) | local (llama.cpp) | remote (OpenAI-compatible endpoint)
STUDY_PROVIDER=gemini
GEMINI_API_KEY=
# Exact API model ID verified for your own project; no default.
STUDY_GEMINI_MODEL=
# Optional returned/pinned revision, if the provider exposes one.
STUDY_GEMINI_MODEL_REVISION=
# local provider: path to a GGUF file
STUDY_LOCAL_MODEL_PATH=
# remote provider: OpenAI-compatible base URL reached over an authenticated tunnel
STUDY_REMOTE_BASE_URL=
STUDY_REMOTE_API_KEY=
STUDY_MAX_CARDS=5
STUDY_STATE_DIR=.study-engine
# Deck used when a note has neither anki.deck nor series.
STUDY_DEFAULT_DECK=Study
STUDY_EXPORT_DIR=.study-engine/exports
# Optional: only for `build --import` via AnkiConnect importPackage (loopback only).
STUDY_ANKI_URL=http://127.0.0.1:8765
STUDY_ANKI_API_KEY=
