---
import PostMeta from './PostMeta.astro';
import CategoryBadge from './CategoryBadge.astro';
import TagList from './TagList.astro';
import { normalizeCategory, type BlogPost } from '../utils/blog.ts';
import { getBlogUrlFromPost } from '../utils/blog-routing.ts';

export interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const postUrl = getBlogUrlFromPost(post);
const category = normalizeCategory(post.data.category);
---

<article class="group">
  <a href={postUrl} class="block border-t border-rule py-6 transition-colors hover:border-rule-strong">
    <div class="mb-3 flex items-center gap-3">
      <CategoryBadge category={category} />
      <PostMeta
        pubDate={post.data.pubDate}
        category={category}
        content={post.body}
        description={post.data.description}
      />
    </div>

    <h2 class="mb-2 line-clamp-2 font-serif text-xl text-ink transition-colors group-hover:text-accent">
      {post.data.title}
    </h2>

    {post.data.description && (
      <p class="mb-4 line-clamp-2 text-secondary">{post.data.description}</p>
    )}

    {post.data.tags && post.data.tags.length > 0 && <TagList tags={post.data.tags} maxTags={3} />}
  </a>
</article>
