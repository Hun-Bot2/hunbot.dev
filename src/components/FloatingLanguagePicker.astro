---
import { getLangFromUrl, languages, useTranslations } from '../i18n/ui';

interface Props {
	availableLangs?: string[];
}

const { availableLangs } = Astro.props as Props;
const currentLang = Astro.currentLocale || 'ko';
const t = useTranslations(getLangFromUrl(Astro.url));
const currentPath = Astro.url.pathname;
const languageKeys = Object.keys(languages);
const allowedLangs = availableLangs && availableLangs.length > 0
	? Array.from(new Set([...availableLangs, currentLang])).filter(lang => languageKeys.includes(lang))
	: languageKeys;

function getBasePath(path: string, lang: string) {
	const prefix = `/${lang}`;
	if (path === prefix) return '/';
	if (path.startsWith(`${prefix}/`)) {
		const remainder = path.slice(prefix.length);
		return remainder.startsWith('/') ? remainder : `/${remainder}`;
	}
	return path;
}

const basePath = getBasePath(currentPath, currentLang);

const languageUrls = allowedLangs.reduce((acc, lang) => {
	if (lang === 'ko') {
		acc[lang] = basePath === '/' ? '/ko/' : `/ko${basePath}`;
	} else {
		acc[lang] = basePath === '/' ? `/${lang}/` : `/${lang}${basePath}`;
	}
	return acc;
}, {} as Record<string, string>);
---

<div class="flp-wrap" id="floating-lang-wrap">
	<button
		type="button"
		id="floating-lang-toggle"
		class="flp-btn"
		aria-label={t('nav.language-select')}
		title={t('nav.language-select')}
		aria-haspopup="true"
		aria-expanded="false"
		aria-controls="floating-lang-menu"
	>
		<span class="flp-icon" aria-hidden="true"></span>
	</button>

	<div id="floating-lang-menu" class="flp-menu hidden">
		{Object.entries(languages)
			.filter(([lang]) => allowedLangs.includes(lang))
			.map(([lang, label]) => (
				<a
					href={languageUrls[lang]}
					class:list={['flp-option', { 'flp-option--active': lang === currentLang }]}
					data-lang={lang}
				>
					{label}
					{lang === currentLang && (
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<polyline points="20 6 9 17 4 12"/>
						</svg>
					)}
				</a>
		))}
	</div>
</div>

<script>
	import { clearPopoverPlacement, makeDraggable, placePopover } from '../utils/floating';

	document.addEventListener('DOMContentLoaded', () => {
		const toggle = document.getElementById('floating-lang-toggle');
		const menu = document.getElementById('floating-lang-menu');
		const wrap = document.getElementById('floating-lang-wrap');
		if (!toggle || !menu || !wrap) return;

		const place = () => {
			if (!menu.classList.contains('hidden')) placePopover(toggle, menu);
		};
		const drag = makeDraggable(wrap, { storageKey: 'hunbot-float-lang', onMove: place });

		const setOpen = (open: boolean) => {
			menu.classList.toggle('hidden', !open);
			toggle.setAttribute('aria-expanded', String(open));
			if (open) placePopover(toggle, menu);
			else clearPopoverPlacement(menu);
		};

		toggle.addEventListener('click', (e) => {
			e.stopPropagation();
			if (drag.wasDragged()) return;
			setOpen(menu.classList.contains('hidden'));
		});

		document.addEventListener('click', (e) => {
			if (!toggle.contains(e.target as Node) && !menu.contains(e.target as Node)) setOpen(false);
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});

		window.addEventListener('resize', place);
	});
</script>

<style is:global>
	/* Globe control near the top-right of the viewport, just below the sticky header.
	   Fixed so it stays in reach while reading; draggable (src/utils/floating.ts).
	   The TOC pill defaults lower on the right edge so the two never overlap. */
	.flp-wrap {
		position: fixed;
		top: calc(var(--header-height) + 12px);
		right: 1rem;
		z-index: 90;
	}

	.flp-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid var(--rule-strong);
		background: var(--paper);
		color: var(--ink);
		cursor: grab;
		user-select: none;
		-webkit-user-select: none;
	}

	.flp-wrap.is-dragging .flp-btn {
		cursor: grabbing;
	}

	.flp-btn:hover {
		border-color: var(--ink);
		color: var(--accent);
	}

	/* The original globe asset, tinted with currentColor so it follows the theme. */
	.flp-icon {
		display: block;
		width: 24px;
		height: 24px;
		background: currentColor;
		-webkit-mask: url('/images/earth-9-svgrepo-com.svg') center / contain no-repeat;
		mask: url('/images/earth-9-svgrepo-com.svg') center / contain no-repeat;
		pointer-events: none;
	}

	/* Placed beside the trigger by placePopover(), so it opens towards the side with room. */
	.flp-menu {
		position: fixed;
		min-width: 9rem;
		overflow-y: auto;
		border: 1px solid var(--rule-strong);
		background: var(--paper);
		z-index: 95;
	}

	.flp-menu.hidden {
		display: none;
	}

	.flp-option {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		min-height: 40px;
		padding: 0 0.9rem;
		border-top: 1px solid var(--rule);
		color: var(--secondary);
		font-size: 0.8125rem;
	}

	.flp-option:first-child {
		border-top: 0;
	}

	.flp-option:hover {
		color: var(--accent);
	}

	.flp-option--active {
		color: var(--ink);
	}

	@media (max-width: 639px) {
		.flp-wrap {
			top: calc(var(--header-height) + 8px);
			right: 0.75rem;
		}

		.flp-btn {
			width: 34px;
			height: 34px;
		}

		.flp-icon {
			width: 20px;
			height: 20px;
		}
	}
</style>
