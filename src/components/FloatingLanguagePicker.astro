---
import { getLangFromUrl, languages, useTranslations } from '../i18n/ui';

interface Props {
	availableLangs?: string[];
}

const { availableLangs } = Astro.props as Props;
const currentLang = Astro.currentLocale || 'ko';
const t = useTranslations(getLangFromUrl(Astro.url));
const currentPath = Astro.url.pathname;
const languageKeys = Object.keys(languages);
const allowedLangs = availableLangs && availableLangs.length > 0
	? Array.from(new Set([...availableLangs, currentLang])).filter(lang => languageKeys.includes(lang))
	: languageKeys;

function getBasePath(path: string, lang: string) {
	const prefix = `/${lang}`;
	if (path === prefix) return '/';
	if (path.startsWith(`${prefix}/`)) {
		const remainder = path.slice(prefix.length);
		return remainder.startsWith('/') ? remainder : `/${remainder}`;
	}
	return path;
}

const basePath = getBasePath(currentPath, currentLang);

const languageUrls = allowedLangs.reduce((acc, lang) => {
	if (lang === 'ko') {
		acc[lang] = basePath === '/' ? '/ko/' : `/ko${basePath}`;
	} else {
		acc[lang] = basePath === '/' ? `/${lang}/` : `/${lang}${basePath}`;
	}
	return acc;
}, {} as Record<string, string>);
---

<div class="flp-wrap">
	<button
		type="button"
		id="floating-lang-toggle"
		class="flp-btn"
		aria-label={t('nav.language')}
		title={t('nav.language')}
	>
		<span>{currentLang.toUpperCase()}</span>
		<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="m6 15 6-6 6 6" />
		</svg>
	</button>

	<div id="floating-lang-menu" class="flp-menu hidden">
		{Object.entries(languages)
			.filter(([lang]) => allowedLangs.includes(lang))
			.map(([lang, label]) => (
				<a
					href={languageUrls[lang]}
					class:list={['flp-option', { 'flp-option--active': lang === currentLang }]}
					data-lang={lang}
				>
					{label}
					{lang === currentLang && (
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<polyline points="20 6 9 17 4 12"/>
						</svg>
					)}
				</a>
		))}
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const toggle = document.getElementById('floating-lang-toggle');
		const menu   = document.getElementById('floating-lang-menu');
		if (!toggle || !menu) return;

		toggle.addEventListener('click', (e) => {
			e.stopPropagation();
			menu.classList.toggle('hidden');
		});

		document.addEventListener('click', (e) => {
			if (!toggle.contains(e.target as Node) && !menu.contains(e.target as Node)) {
				menu.classList.add('hidden');
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') menu.classList.add('hidden');
		});
	});
</script>

<style is:global>
	/* Small paper chip in the bottom-right corner; the menu opens upwards. */
	.flp-wrap {
		position: fixed;
		bottom: 1rem;
		right: 1rem;
		z-index: 150;
	}

	.flp-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 40px;
		padding: 0 0.85rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper);
		color: var(--ink);
		font: 400 0.6875rem/1 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.flp-btn:hover {
		border-color: var(--ink);
	}

	.flp-menu {
		position: absolute;
		bottom: calc(100% + 0.5rem);
		right: 0;
		min-width: 9rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper);
		z-index: 200;
	}

	.flp-menu.hidden {
		display: none;
	}

	.flp-option {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		min-height: 40px;
		padding: 0 0.9rem;
		border-top: 1px solid var(--rule);
		color: var(--secondary);
		font-size: 0.8125rem;
	}

	.flp-option:first-child {
		border-top: 0;
	}

	.flp-option:hover {
		color: var(--accent);
	}

	.flp-option--active {
		color: var(--ink);
	}
</style>
