---
import { useTranslations } from '../i18n/ui';
import type { UILanguage } from '../i18n/ui';

type Props = {
	lang?: UILanguage;
};

const { lang = 'ko' } = Astro.props as Props;
const t = useTranslations(lang);
---

<!--
	Table of contents as a compact dropdown: a small, draggable paper pill that opens
	a popover of the post's headings right under it (link styles live in
	src/styles/prose.css). Never a permanent column.
-->
<button
	type="button"
	id="toc-trigger"
	class="btn-pill"
	aria-label={t('toc.toggle')}
	aria-expanded="false"
	aria-controls="table-of-contents"
>
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
		<path d="M4 6h16M4 12h16M4 18h8" />
	</svg>
	<span class="toc-trigger-label">{t('toc.title')}</span>
</button>

<nav id="table-of-contents" class="article-toc" aria-label={t('toc.title')}>
	<h2 class="article-toc-title">{t('toc.title')}</h2>
	<ul id="toc-list"></ul>
</nav>

<style is:global>
	#toc-trigger {
		position: fixed;
		top: 12rem;
		right: var(--float-inset);
		z-index: 90;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 36px;
		background: var(--paper);
		cursor: grab;
		user-select: none;
		-webkit-user-select: none;
	}

	@media (max-width: 639px) {
		#toc-trigger {
			top: 8.5rem;
			right: 0.75rem;
			padding: 0.4rem 0.65rem;
		}

		#toc-trigger .toc-trigger-label {
			display: none;
		}
	}

	#toc-trigger.active {
		border-color: var(--ink);
	}

	#toc-trigger.is-dragging {
		cursor: grabbing;
	}

	/* Placed under the trigger by placePopover(); small, scrolls inside itself. */
	#table-of-contents {
		position: fixed;
		z-index: 95;
		width: min(18rem, calc(100vw - 1.5rem));
		max-height: min(60vh, 24rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.75rem 1rem 0.5rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper);
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		transition: opacity 120ms ease, visibility 120ms;
	}

	#table-of-contents.visible {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		#table-of-contents {
			transition: none;
		}
	}
</style>

<script>
	import { makeDraggable, placePopover } from '../utils/floating';

	document.addEventListener('DOMContentLoaded', () => {
		const idleCallback = (window as typeof window & { requestIdleCallback?: (cb: IdleRequestCallback) => number }).requestIdleCallback;

		const initTOC = () => {
			const tocTrigger = document.getElementById('toc-trigger');
			const tocContainer = document.getElementById('table-of-contents');
			const tocList = document.getElementById('toc-list');

			if (!tocTrigger || !tocContainer || !tocList) return;

			const headings = Array.from(
				document.querySelectorAll<HTMLElement>('.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6'),
			);

			if (headings.length === 0) {
				tocTrigger.style.display = 'none';
				tocContainer.style.display = 'none';
				return;
			}

			headings.forEach((heading, index) => {
				if (!heading.id) heading.id = `heading-${index}`;

				const li = document.createElement('li');
				const a = document.createElement('a');
				a.href = `#${heading.id}`;
				a.textContent = heading.textContent || '';
				a.className = `toc-link toc-${heading.tagName.toLowerCase()}`;
				li.appendChild(a);
				tocList.appendChild(li);
			});

			const tocLinks = Array.from(tocList.querySelectorAll<HTMLAnchorElement>('a'));

			const setOpen = (open: boolean) => {
				if (open) positionPanel();
				tocContainer.classList.toggle('visible', open);
				if (open) tocList.querySelector('.active')?.scrollIntoView({ block: 'nearest' });
				tocTrigger.classList.toggle('active', open);
				tocTrigger.setAttribute('aria-expanded', String(open));
			};

			// The dropdown opens under the trigger wherever it has been dragged to.
			const positionPanel = () => placePopover(tocTrigger, tocContainer);
			const drag = makeDraggable(tocTrigger, {
				storageKey: 'hunbot-float-toc',
				onMove: () => {
					if (tocContainer.classList.contains('visible')) positionPanel();
				},
			});
			window.addEventListener('resize', () => {
				if (tocContainer.classList.contains('visible')) positionPanel();
			});

			tocTrigger.addEventListener('click', (e) => {
				e.stopPropagation();
				if (drag.wasDragged()) return;
				setOpen(!tocContainer.classList.contains('visible'));
			});

			// Close on outside click and Escape.
			document.addEventListener('click', (e) => {
				const target = e.target;
				if (target instanceof Node && !tocContainer.contains(target) && !tocTrigger.contains(target)) {
					setOpen(false);
				}
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') setOpen(false);
			});

			// Smooth scroll; the panel closes after navigating.
			tocLinks.forEach((link) => {
				link.addEventListener('click', (e) => {
					e.preventDefault();
					const target = document.getElementById(link.getAttribute('href')?.slice(1) ?? '');
					if (!target) return;

					window.scrollTo({
						top: target.getBoundingClientRect().top + window.scrollY - 88,
						behavior: 'smooth',
					});
					setOpen(false);
				});
			});

			// Highlight the section currently at the top of the viewport.
			const updateActiveLink = () => {
				let current: HTMLElement | null = null;
				for (const heading of headings) {
					if (heading.getBoundingClientRect().top <= 120) current = heading;
				}

				tocLinks.forEach((link) => {
					link.classList.toggle('active', current !== null && link.getAttribute('href') === `#${current.id}`);
				});
			};

			let scrollTicking = false;
			window.addEventListener('scroll', () => {
				if (scrollTicking) return;
				scrollTicking = true;
				requestAnimationFrame(() => {
					updateActiveLink();
					scrollTicking = false;
				});
			});

			updateActiveLink();
		};

		if (idleCallback) {
			idleCallback(() => initTOC());
		} else {
			setTimeout(initTOC, 120);
		}
	});
</script>
