---
import { ui } from '../i18n/ui';

/**
 * Suggests a translation instead of redirecting to one.
 *
 * The signal is the reader's own browser language, not their IP address: IP says
 * where someone is, browser language says what they read. It also never moves the
 * reader, which matters because many posts exist in Korean only.
 *
 * Labels are rendered in the target language, so the invitation is readable by the
 * person it is aimed at.
 */
const suggestions = (['ko', 'jp', 'en'] as const).map((code) => ({
	code,
	label: ui[code]['language.suggest'],
	dismiss: ui[code]['language.suggest-dismiss'],
}));
---

<div class="language-suggestion" data-language-suggestion hidden>
	<a class="language-suggestion-link" data-language-suggestion-link href="#"></a>
	<button type="button" class="language-suggestion-dismiss" data-language-suggestion-dismiss></button>
</div>

{suggestions.map((suggestion) => (
	<template
		data-language-suggestion-copy={suggestion.code}
		data-label={suggestion.label}
		data-dismiss={suggestion.dismiss}
	></template>
))}

<style>
	.language-suggestion {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin: 0 auto 1.5rem;
		width: min(100%, 56rem);
		border: 1px solid var(--rule-strong);
		background: var(--paper-deep);
		padding: 0.7rem 0.9rem;
	}

	.language-suggestion[hidden] {
		display: none;
	}

	.language-suggestion-link {
		color: var(--ink);
		font-size: 0.9rem;
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}

	.language-suggestion-link:hover {
		color: var(--accent);
	}

	.language-suggestion-dismiss {
		min-height: 2.5rem;
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		background: transparent;
		padding: 0 0.9rem;
		color: var(--secondary);
		font: 400 0.6875rem/1 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.language-suggestion-dismiss:hover {
		border-color: var(--ink);
		color: var(--ink);
	}
</style>
