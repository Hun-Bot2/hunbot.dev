---
// The Library hero: a lit "stage" band at the top of /{lang}/library/ that
// auto-advances through the newest items. The one place on the site that moves on its own
// (docs/decisions/creative-direction.md, The Exceptions). It must:
//   - show a visible pause control, and pause on hover, focus and a hidden tab;
//   - render the first slide complete with no JavaScript (the controls and the
//     other slides only appear once hero-client.ts marks the section ready);
//   - not auto-advance, and show headlines at once, under reduced motion;
//   - use only the motion tokens (src/styles/tokens.css).
// Slide selection and word splitting: src/utils/hero.ts. Behaviour:
// ./library-hero-client.ts. Copy: `library.hero.*` in src/i18n/ui.ts.
import { formatPostDate } from '../../utils/display';
import { getExplainerUrl } from '../../utils/explainers';
import { splitHeadline, type HeroSlide } from '../../utils/hero';
import { getLibraryKindLabel } from '../../utils/library-labels';
import { getResponsivePublicImage } from '../../utils/responsive-public-images';
import { getSignalsUrl } from '../../utils/signals';
import { formatWeekRange, getWeeklyUrl } from '../../utils/weekly';
import { useTranslations, type UILanguage } from '../../i18n/ui';
import Stamp from './Stamp.astro';

interface Props {
	/** From selectHeroSlides() (src/utils/hero.ts): explainer, weekly note, today's signals, then 자료 items. */
	slides: HeroSlide[];
	lang: UILanguage;
}

const { slides, lang } = Astro.props;
const t = useTranslations(lang);
// A dynamic UI key; kept out of the template, where `as` casts do not parse.
const tk = (key: string) => t(key as Parameters<typeof t>[0]);
const total = slides.length;
const interactive = total > 1;

const items = slides.map((slide, index) => {
	const words = splitHeadline(slide.title, lang);
	const responsive = slide.image ? getResponsivePublicImage(slide.image.src) : null;
	const image = responsive && slide.image ? { ...responsive, width: responsive.width ?? slide.image.width, height: responsive.height ?? slide.image.height } : null;
	let href = '';
	let eyebrow: string[] = [];
	let external = false;
	// The plate (the media column when a slide has no image) is drawn by kind,
	// never from the title: explainer = the row's 해설 plate, weekly = a huge issue
	// numeral, signals = the day's stamps, 자료 = the host on ruled paper.
	let corner = '';
	let plate: Record<string, unknown> = {};
	let stamps: Array<{ tone: 'confirmed' | 'doubt' | 'try'; label: string }> = [];
	if (slide.kind === 'explainer') {
		href = getExplainerUrl(lang, slide.slug);
		eyebrow = [t('library.hero.kind.explainer'), tk(`explainer.source-language.${slide.sourceLanguage}`)];
		corner = tk(`explainer.source.kind.${slide.sourceKind}`);
		plate = { glyph: t('explainer.plate'), code: slide.sourceLanguage.toUpperCase(), ja: slide.sourceLanguage === 'ja' };
	} else if (slide.kind === 'weekly') {
		href = getWeeklyUrl(lang, slide.issue);
		eyebrow = [`${t('library.hero.kind.weekly')} ${t('weekly.issue').replace('{n}', String(slide.issue))}`];
		corner = t('library.hero.kind.weekly');
		plate = { prefix: t('weekly.issue').replace('{n}', '').trim(), issue: String(slide.issue), range: formatWeekRange(slide.weekOf) };
	} else if (slide.kind === 'signals') {
		href = getSignalsUrl(lang);
		eyebrow = [t('library.hero.kind.signals'), formatPostDate(new Date(slide.day))];
		corner = t('signal.count').replace('{n}', String(slide.count));
		plate = { date: slide.day.replaceAll('-', '.') };
		stamps = slide.items.map((item) => ({ tone: item.verdict as 'confirmed' | 'doubt' | 'try', label: tk(`signal.verdict.${item.verdict}`) }));
	} else {
		href = slide.url;
		external = true;
		eyebrow = [t('library.tab.resources'), getLibraryKindLabel(slide.itemKind, lang)];
		corner = getLibraryKindLabel(slide.itemKind, lang);
		let host = slide.url;
		try {
			host = new URL(slide.url).hostname.replace(/^www\./, '');
		} catch {
			/* keep the raw url */
		}
		plate = { host };
	}
	return {
		slide,
		index,
		words,
		image,
		href,
		external,
		eyebrow: eyebrow.join(' · '),
		corner,
		plate,
		stamps,
		label: t('library.hero.slide').replace('{n}', String(index + 1)).replace('{total}', String(total)),
	};
});
---

{
	total > 0 && (
		<section
			class="hero"
			data-hero
			data-interval="7000"
			aria-roledescription="carousel"
			aria-label={t('library.hero.label')}
			data-labels={JSON.stringify({ pause: t('library.hero.pause'), play: t('library.hero.play') })}
		>
			<div class="hero-stage">
				<div class="hero-slides" data-hero-slides aria-live="off">
					{items.map(({ slide, index, words, image, href, external, eyebrow, corner, plate, stamps, label }) => (
						<div
							class="hero-slide"
							role="group"
							aria-roledescription="slide"
							aria-label={label}
							data-hero-slide
							data-active={index === 0 ? '' : undefined}
							inert={index > 0}
							style={`--n:${words.length}`}
						>
							<span class="hero-glow" aria-hidden="true" />
							<div class="hero-copy">
								<a class="hero-link" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
									<p class="hero-eyebrow">{eyebrow}</p>
									<h2 class="hero-title">
										{words.map((word, i) => (
											<Fragment>
												<span class="hero-word" style={`--i:${i}`}>
													{word.text}
												</span>
												{word.spaceAfter && ' '}
											</Fragment>
										))}
									</h2>
									{slide.kind === 'signals' ? (
										<ul class="hero-signals">
											{slide.items.map((item) => (
												<li>
													<Stamp tone={item.verdict as 'confirmed' | 'doubt' | 'try'} label={tk(`signal.verdict.${item.verdict}`)} size="sm" />
													<span class="hero-signal-title" lang={lang !== 'ko' ? 'ko' : undefined}>{item.title}</span>
												</li>
											))}
										</ul>
									) : (
										slide.description && <p class="hero-desc">{slide.description}</p>
									)}
									<span class="btn-pill hero-cta">
										{t('library.hero.read')} <span aria-hidden="true">{external ? '↗' : '→'}</span>
									</span>
								</a>
							</div>
							<div class="hero-media" aria-hidden="true">
								{image ? (
									<picture>
										{image.webpSrcSet && (
											<source type="image/webp" srcset={image.webpSrcSet} sizes="(max-width: 799px) 100vw, 520px" />
										)}
										<img
											src={image.src}
											alt=""
											width={image.width}
											height={image.height}
											sizes="(max-width: 799px) 100vw, 520px"
											loading={index === 0 ? 'eager' : 'lazy'}
											decoding="async"
										/>
									</picture>
								) : (
									<div class:list={['hero-plate', `hero-plate--${slide.kind}`, { 'is-ja': plate.ja }]}>
										<span class="hero-plate-kind">{corner}</span>
										{slide.kind === 'explainer' && (
											<Fragment>
												<span class="hero-plate-glyph">{plate.glyph}</span>
												<span class="hero-plate-code">{plate.code}</span>
											</Fragment>
										)}
										{slide.kind === 'weekly' && (
											<Fragment>
												<span class="hero-plate-issue">
													<span class="hero-plate-issue-prefix">{plate.prefix}</span>
													<span class="hero-plate-issue-num">{plate.issue}</span>
												</span>
												<span class="hero-plate-range">{plate.range}</span>
											</Fragment>
										)}
										{slide.kind === 'signals' && (
											<Fragment>
												<span class="hero-plate-stamps">
													{stamps.map((stamp) => (
														<Stamp tone={stamp.tone} label={stamp.label} />
													))}
												</span>
												<span class="hero-plate-date">{plate.date}</span>
											</Fragment>
										)}
										{slide.kind === 'item' && <span class="hero-plate-host">{plate.host}</span>}
									</div>
								)}
							</div>
						</div>
					))}
				</div>
			</div>

			{interactive && (
				<div class="hero-controls" data-hero-controls>
					<button type="button" class="hero-toggle" data-hero-toggle aria-label={t('library.hero.pause')}>
						<svg class="hero-icon hero-icon--pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
							<path d="M5 3.5v9M11 3.5v9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
						</svg>
						<svg class="hero-icon hero-icon--play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
							<path d="M5.5 3.4v9.2l7-4.6z" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
						</svg>
					</button>
					<div class="hero-dots" role="group" aria-label={t('library.hero.label')}>
						{items.map(({ index }) => (
							<button
								type="button"
								class="hero-dot"
								data-hero-dot
								aria-label={t('library.hero.go').replace('{n}', String(index + 1))}
								aria-current={index === 0 ? 'true' : undefined}
							>
								<span class="hero-dot-bar">
									<span class="hero-dot-fill" />
								</span>
							</button>
						))}
					</div>
				</div>
			)}
		</section>
	)
}

<script>
	import { initHero } from './library-hero-client';

	document.querySelectorAll<HTMLElement>('[data-hero]').forEach(initHero);
</script>

<style>
	.hero {
		--hero-interval: 7s;
		margin-bottom: 2.25rem;
	}

	/* ── Stage: a lit band on the paper, dark in both themes ── */
	.hero-stage {
		position: relative;
		overflow: hidden;
		border-radius: 2px;
		background: var(--stage);
		color: var(--stage-ink);
	}

	/* In dark mode the stage is close to the paper: a rule marks its edge. */
	:global(html.dark) .hero-stage {
		border: 1px solid var(--rule-strong);
	}

	.hero-slides {
		display: grid;
	}

	.hero-slide {
		position: relative;
		grid-area: 1 / 1;
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
		gap: 2.5rem;
		align-items: center;
		min-height: 440px;
		padding: 2.5rem;
		touch-action: pan-y;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--dur-4) var(--ease-standard),
			visibility 0s linear var(--dur-4);
	}

	.hero-slide[data-active] {
		opacity: 1;
		visibility: visible;
		transition-delay: 0s;
	}

	/* No JavaScript: the first slide only, the controls never. */
	.hero:not([data-ready]) .hero-slide:not([data-active]) {
		display: none;
	}

	.hero:not([data-ready]) .hero-slide {
		transition: none;
	}

	.hero-glow {
		position: absolute;
		top: 50%;
		right: 4%;
		width: 62%;
		aspect-ratio: 1;
		transform: translateY(-50%);
		background: radial-gradient(closest-side, color-mix(in oklab, var(--accent) 22%, transparent), transparent);
		pointer-events: none;
	}

	/* ── Copy ── */
	.hero-copy {
		position: relative;
		z-index: 1;
		min-width: 0;
	}

	.hero-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	/* The whole slide is the click target; the link itself stays the copy. */
	.hero-link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
	}

	.hero-link:focus-visible {
		outline: none;
	}

	.hero-slide:has(.hero-link:focus-visible) {
		outline: 2px solid var(--stage-ink);
		outline-offset: -6px;
	}

	.hero-eyebrow {
		margin: 0 0 1.1rem;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--stage-accent);
	}

	.hero-title {
		margin: 0 0 1.1rem;
		font: 400 clamp(2rem, 1.2rem + 3.4vw, 3.5rem) / 1.15 var(--font-serif);
		letter-spacing: -0.02em;
		text-wrap: balance;
		overflow-wrap: break-word;
		color: var(--stage-ink);
	}

	:global(html:lang(ko)) .hero-title,
	:global(html:lang(jp)) .hero-title {
		word-break: keep-all;
	}

	.hero-word {
		display: inline-block;
	}

	.hero-desc {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		max-width: 34rem;
		margin: 0 0 1.5rem;
		font: 400 0.9375rem/1.65 var(--font-sans);
		color: var(--stage-muted);
	}

	/* Today's signals: up to three verdicts with their headlines. */
	.hero-signals {
		display: grid;
		gap: 0.7rem;
		max-width: 34rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
	}

	.hero-signals li {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 0 0.75rem;
		align-items: baseline;
	}

	.hero-signal-title {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font: 400 0.9375rem/1.5 var(--font-sans);
		color: var(--stage-ink);
	}

	/* Stamps on the stage: the same three tones, lifted for the dark ground. */
	.hero :global(.stamp) {
		--stamp-color: var(--stage-ink);
	}

	.hero :global(.stamp--doubt) {
		--stamp-color: var(--stage-accent);
	}

	.hero :global(.stamp--confirmed) {
		--stamp-color: var(--stage-ink);
	}

	.hero :global(.stamp--try) {
		--stamp-color: var(--stage-muted);
	}

	/* .btn-pill, made for the stage. */
	.hero-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.5rem;
		padding-inline: 1.15rem;
		border-color: color-mix(in oklab, var(--stage-ink) 45%, transparent);
		color: var(--stage-ink);
		transition:
			background-color var(--dur-2) var(--ease-standard),
			border-color var(--dur-2) var(--ease-standard),
			color var(--dur-2) var(--ease-standard);
	}

	.hero-cta > span {
		display: inline-block;
		transition: transform var(--dur-3) var(--ease-spring);
	}

	@media (hover: hover) {
		.hero-slide:hover .hero-cta {
			border-color: var(--stage-ink);
			background: var(--stage-ink);
			color: var(--stage);
		}

		.hero-slide:hover .hero-cta > span {
			transform: translateX(3px);
		}
	}

	/* ── Media ── */
	.hero-media {
		position: relative;
		z-index: 1;
		align-self: stretch;
		min-width: 0;
		overflow: hidden;
		border: 1px solid color-mix(in oklab, var(--stage-muted) 45%, transparent);
	}

	.hero-media picture,
	.hero-media img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-media img {
		object-fit: cover;
	}

	/* No image: a typographic plate, ruled paper in light on the stage. */
	.hero-plate {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		width: 100%;
		height: 100%;
		min-height: 14rem;
		padding: 1rem 1.25rem 0.9rem;
		container-type: inline-size;
		background-image: repeating-linear-gradient(
			0deg,
			transparent 0 27px,
			color-mix(in oklab, var(--stage-muted) 22%, transparent) 27px 28px
		);
	}

	.hero-plate-kind {
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--stage-muted);
	}

	/* explainer: the same plate as ExplainerRow, large: serif 해설, the source
	   language code in mono at the corner; a Japanese source takes the accent. */
	.hero-plate--explainer {
		align-items: flex-start;
	}

	.hero-plate-glyph {
		margin: auto 0;
		font: 400 clamp(4rem, 2.5rem + 7vw, 8rem) / 1 var(--font-serif);
		letter-spacing: -0.05em;
		word-break: keep-all;
		color: var(--stage-ink);
	}

	.hero-plate-code {
		position: absolute;
		right: 1.25rem;
		bottom: 0.9rem;
		font: 500 0.8125rem/1 var(--font-mono);
		letter-spacing: 0.12em;
		color: var(--stage-muted);
	}

	.hero-plate.is-ja .hero-plate-glyph,
	.hero-plate.is-ja .hero-plate-code {
		color: var(--stage-accent);
	}

	/* weekly: a huge issue numeral and the week in mono. */
	.hero-plate-issue {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin: auto 0;
		color: var(--stage-ink);
	}

	.hero-plate-issue-prefix {
		font: italic 400 clamp(1.5rem, 1rem + 2vw, 2.5rem) / 1 var(--font-serif);
		color: var(--stage-muted);
	}

	.hero-plate-issue-num {
		font: 400 clamp(6rem, 3.5rem + 11vw, 12rem) / 0.85 var(--font-serif);
		font-variant-numeric: lining-nums;
		letter-spacing: -0.06em;
	}

	.hero-plate-range,
	.hero-plate-date {
		font: 400 0.75rem/1.4 var(--font-mono);
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.06em;
		color: var(--stage-muted);
	}

	/* signals: the day's verdict stamps, a little rotated and overlapping. */
	.hero-plate-stamps {
		display: grid;
		justify-items: start;
		margin: auto 0;
		padding-left: 0.5rem;
	}

	.hero-plate-stamps :global(.stamp) {
		padding: 0.35rem 1.1rem 0.25rem;
		border-width: 2px;
		font-size: clamp(1.1rem, 0.9rem + 1vw, 1.6rem);
		background: var(--stage);
	}

	.hero-plate-stamps :global(.stamp:nth-child(1)) {
		transform: rotate(-5deg);
	}

	.hero-plate-stamps :global(.stamp:nth-child(2)) {
		margin: -0.5rem 0 0 2.2rem;
		transform: rotate(3deg);
	}

	.hero-plate-stamps :global(.stamp:nth-child(3)) {
		margin: -0.5rem 0 0 0.8rem;
		transform: rotate(-2deg);
	}

	/* 자료 without an image: the host in mono on the ruled plate. */
	.hero-plate-host {
		margin: auto 0;
		padding: 0.15rem 0.6rem;
		background: var(--stage);
		font: 400 clamp(1rem, 0.8rem + 1vw, 1.5rem) / 1.3 var(--font-mono);
		letter-spacing: 0.02em;
		overflow-wrap: anywhere;
		color: var(--stage-ink);
	}

	.hero-plate-host::before {
		content: '';
		display: inline-block;
		width: 0.5em;
		height: 0.5em;
		margin-right: 0.55em;
		background: var(--stage-accent);
	}

	/* ── Reveal: words, then the rest of the copy, then the media ── */
	@keyframes hero-word {
		from {
			opacity: 0;
			filter: blur(10px);
			transform: translateY(0.35em);
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	@keyframes hero-media {
		from {
			opacity: 0;
			transform: translateY(6%) scale(0.97);
		}
	}

	@keyframes hero-glow {
		from {
			opacity: 0;
		}
	}

	/* Reveal only while the script has confirmed the timeline is running
	   (.hero[data-motion]); without it every element rests visible. */
	.hero[data-motion] .hero-slide[data-active] .hero-word {
		animation: hero-word var(--dur-5) var(--ease-out) both;
		animation-delay: calc(min(var(--i), 14) * 60ms + 120ms);
	}

	.hero[data-motion] .hero-slide[data-active] .hero-eyebrow {
		animation: hero-rise var(--dur-5) var(--ease-out) both;
		animation-delay: 40ms;
	}

	.hero[data-motion] .hero-slide[data-active] .hero-desc {
		animation: hero-rise var(--dur-5) var(--ease-out) both;
		animation-delay: calc(min(var(--n), 14) * 60ms + 260ms);
	}

	.hero[data-motion] .hero-slide[data-active] .hero-cta {
		animation: hero-rise var(--dur-5) var(--ease-out) both;
		animation-delay: calc(min(var(--n), 14) * 60ms + 380ms);
	}

	.hero[data-motion] .hero-slide[data-active] .hero-media {
		animation: hero-media var(--dur-5) var(--ease-out) both;
		animation-delay: 80ms;
	}

	.hero[data-motion] .hero-slide[data-active] .hero-glow {
		animation: hero-glow var(--dur-5) var(--ease-standard) both;
	}

	/* ── Controls ── */
	.hero-controls {
		display: none;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0.9rem;
	}

	.hero[data-ready] .hero-controls {
		display: flex;
	}

	.hero-toggle {
		display: inline-grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
		transition:
			border-color var(--dur-2) var(--ease-standard),
			color var(--dur-2) var(--ease-standard),
			transform var(--dur-1) var(--ease-standard);
	}

	.hero-toggle:hover {
		border-color: var(--ink);
	}

	.hero-toggle:active {
