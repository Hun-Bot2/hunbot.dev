---
// One simple line icon per Library 분야 (and 전체): 24px grid drawn at 20px,
// 1.5px stroke, currentColor, so the tab sets its tint. Decorative, aria-hidden.
interface Props {
	area: string;
	size?: number;
}

const { area, size = 20 } = Astro.props;
---

<svg class="area-icon" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
	{area === 'all' && <Fragment><rect x="4" y="4" width="6.5" height="6.5" rx="1" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="1" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="1" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1" /></Fragment>}
	{area === 'design' && <Fragment><path d="M12 3 6.5 12l3 7h5l3-7z" /><path d="M12 8v4.5" /><circle cx="12" cy="14" r="1" /></Fragment>}
	{area === 'code' && <Fragment><path d="m8 7-5 5 5 5" /><path d="m16 7 5 5-5 5" /><path d="m13.5 5-3 14" /></Fragment>}
	{area === 'ai-engineering' && <Fragment><path d="M11 3c.6 4.5 2.5 6.4 7 7-4.5.6-6.4 2.5-7 7-.6-4.5-2.5-6.4-7-7 4.5-.6 6.4-2.5 7-7z" /><path d="M19 16v5M16.5 18.5h5" /></Fragment>}
	{area === 'data-viz' && <Fragment><path d="M5 19v-7M12 19V5M19 19v-9" /><path d="M3 21h18" /></Fragment>}
	{area === 'learning' && <Fragment><path d="M12 6.5C10 5 7 4.5 4 4.5v13c3 0 6 .5 8 2 2-1.5 5-2 8-2v-13c-3 0-6 .5-8 2z" /><path d="M12 6.5v13" /></Fragment>}
	{area === 'creative' && <Fragment><path d="M20 4 11.5 12.5" /><path d="M11.5 12.5c-2.8-.9-5.5 1-5.5 3.7 0 1.3-.7 2.3-1.8 3 3.5 1 7.5 0 8.2-3.2.3-1.4-.2-2.8-.9-3.5z" /></Fragment>}
	{area === 'other' && <Fragment><circle cx="6" cy="6" r="1" fill="currentColor" /><circle cx="12" cy="6" r="1" fill="currentColor" /><circle cx="18" cy="6" r="1" fill="currentColor" /><circle cx="6" cy="12" r="1" fill="currentColor" /><circle cx="12" cy="12" r="1" fill="currentColor" /><circle cx="18" cy="12" r="1" fill="currentColor" /><circle cx="6" cy="18" r="1" fill="currentColor" /><circle cx="12" cy="18" r="1" fill="currentColor" /><circle cx="18" cy="18" r="1" fill="currentColor" /></Fragment>}
</svg>
