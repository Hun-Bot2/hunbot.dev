---
// A single pick, used by the Library hub's "최근 추가" strip, its tier
// groups, and each pick section page (docs/decisions/site-structure.md#3,5,7).
// The title is always an external link — a pick has no detail page of its
// own. The owner's note (the Markdown body) is rendered exactly as written;
// this component never generates, paraphrases, or summarizes it.
import { render, type CollectionEntry } from 'astro:content';
import LibraryIcon from './LibraryIcon.astro';
import ResourceVisual from '../art/ResourceVisual.astro';
import { useTranslations, type UILanguage } from '../../i18n/ui';
import { librarySections } from '../../data/librarySections';
import { pickTiers } from '../../data/libraryPolicy';
import {
	computePickTier,
	formatStarCount,
	getFreshnessBadges,
	getPickFacts,
	getPickSlug,
	type PopularitySnapshot,
} from '../../utils/picks';
import popularity from '../../data/popularity.json';

interface Props {
	pick: CollectionEntry<'picks'>;
	lang: UILanguage;
	/** Passed in, computed once per page render — never read from the clock here. */
	now: Date;
	/** Only the hub shows a pick's section pill; section pages already filter to one. */
	showSection?: boolean;
	/** The tier is already the group heading on the hub's tier groups and on section pages. */
	showTier?: boolean;
}

const { pick, lang, now, showSection = false, showTier = false } = Astro.props;
const t = useTranslations(lang);

const { Content } = await render(pick);
const hasNote = pick.body?.trim().length > 0;

const kindKey = `library.pick.kind.${pick.data.kind}` as Parameters<typeof t>[0];
const kindLabel = t(kindKey);

const sectionMeta = librarySections.find((section) => section.slug === pick.data.section);
const sectionLabel = sectionMeta?.label[lang] ?? pick.data.section;
const labelLine = [kindLabel, showSection ? sectionLabel : null].filter(Boolean).join(' · ');

const tierId = computePickTier(pick.data, popularity as PopularitySnapshot, pickTiers).tier;
const tierLabel = pickTiers.find((tier) => tier.id === tierId)?.label[lang] ?? null;

const facts = getPickFacts(pick.data, popularity as PopularitySnapshot);
const badges = getFreshnessBadges({ checkedAt: pick.data.checkedAt, lastActivityAt: facts.lastActivityAt }, now);

const starLine =
	facts.stars !== null && facts.starsAsOf
		? t('library.pick.stars-as-of')
				.replace('{stars}', formatStarCount(facts.stars))
				.replace('{date}', facts.starsAsOf)
		: null;

const addedLine = t('library.pick.added-on').replace('{date}', pick.data.addedAt);
---

<article class="knowledge-item">
	<ResourceVisual kind={pick.data.kind} seed={getPickSlug(pick.id)} />
	<p class="knowledge-label">{labelLine}</p>
	<h3>
		<a href={pick.data.url} target="_blank" rel="noopener noreferrer">
			{pick.data.title}
			<LibraryIcon name="external" />
		</a>
	</h3>
	{hasNote && (
		<div class="library-pick-note">
			<Content />
		</div>
	)}
	<div class="knowledge-meta">
		{showTier && tierLabel && <span class="chip">{tierLabel}</span>}
		{badges.needsCheck && <span class="chip state-chip--recommended">{t('library.pick.needs-check')}</span>}
		{badges.stale && <span class="chip state-chip--recommended">{t('library.pick.stale')}</span>}
		{starLine && <span>{starLine}</span>}
		<span>{addedLine}</span>
	</div>
</article>
