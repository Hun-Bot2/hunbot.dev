---
// Shared Atelier styles for the Research, Paths and Library pages
// (docs/plans/2026-10-03-atelier-redesign.md §5.5, §5.6). Colours and fonts come
// from tokens.css, so nothing here needs a light/dark variant. The page-frame
// gutters, eyebrow, column-heading, chip and state-chip classes live in global.css.
import '../../styles/lists.css';
---

<style is:global>
	/* ── Sections ───────────────────────────────────────────────── */

	.research-section {
		margin-top: 2.75rem;
	}

	.section-head .column-heading {
		margin-bottom: 0.7rem;
	}

	.section-note {
		margin: 0 0 0.5rem;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--secondary);
	}

	.empty-line {
		margin: 1.25rem 0 0;
		padding: 1rem 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		font-size: 0.875rem;
		color: var(--secondary);
	}

	/* ── Rows: title + actions, a mono meta line, a short note ──── */

	.atelier-rows {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.atelier-row {
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.atelier-row-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.15rem 1.5rem;
	}

	.atelier-row :where(h2, h3) {
		margin: 0;
		font: 400 1.25rem/1.25 var(--font-serif);
		letter-spacing: -0.01em;
		transition: color 160ms ease;
	}

	.atelier-row-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 1rem;
	}

	.atelier-row-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.9rem;
		margin-top: 0.4rem;
	}

	.atelier-row-meta > span {
		font: 400 0.6875rem/1.5 var(--font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.chip-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.atelier-row-note {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin: 0.5rem 0 0;
		max-width: 46rem;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--secondary);
	}

	.atelier-row-chips {
		margin-top: 0.6rem;
	}

	/* A row that is one whole link. */
	.atelier-row-link {
		display: block;
		color: inherit;
	}

	.atelier-row-link:hover :where(h2, h3),
	.atelier-row-link:focus-visible :where(h2, h3) {
		color: var(--accent);
	}

	.atelier-row-link .atelier-row-head > .action-label {
		flex: 0 0 auto;
	}

	/* Mono text link with a thin underline; the 40px touch box is taller than the line. */
	.action-link,
	.action-label {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 2.5rem;
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink);
		transition: color 160ms ease;
	}

	.action-link::after,
	.action-label::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.55rem;
		height: 1px;
		background: var(--rule-strong);
		transition: background-color 160ms ease;
	}

	.action-link:hover,
	.action-link:focus-visible,
	.atelier-row-link:hover .action-label,
	.atelier-row-link:focus-visible .action-label {
		color: var(--accent);
	}

	.action-link:hover::after,
	.action-link:focus-visible::after,
	.atelier-row-link:hover .action-label::after,
	.atelier-row-link:focus-visible .action-label::after {
		background: var(--accent);
	}

	.library-action-icon {
		flex: 0 0 auto;
		width: 0.95em;
		height: 0.95em;
		stroke-width: 1.35;
		transition: transform 160ms ease;
	}

	.action-link:hover .library-action-icon,
	.atelier-row-link:hover .library-action-icon {
		transform: translateX(2px);
	}

	.intro-back:hover .library-action-icon--back {
		transform: translateX(-2px);
	}

	/* ── Library tabs and section filters ───────────────────────── */

	.library-tabs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 1.75rem;
		margin-top: 0.75rem;
	}

	.library-tabs-group {
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0 0.6rem;
	}

	.library-tab,
	.library-chip {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.5rem;
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--secondary);
		transition: color 160ms ease;
	}

	.library-tab::after,
	.library-chip::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.6rem;
		height: 1px;
		background: transparent;
	}

	.library-tab:hover,
	.library-tab:focus-visible,
	.library-chip:hover,
	.library-chip:focus-visible {
		color: var(--ink);
	}

	.library-tab[aria-current='page'],
	.library-chip[aria-current='page'] {
		color: var(--accent);
	}

	.library-tab[aria-current='page']::after,
	.library-chip[aria-current='page']::after {
		background: var(--accent);
	}

	/* The plain-text "research-os" label beside the Useful Feeds tab: never a link
	   (docs/decisions/site-structure.md#3). */
	.library-tab-note {
		padding: 0.05rem 0.5rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		font: 400 0.6875rem/1.5 var(--font-mono);
		letter-spacing: 0.06em;
		color: var(--secondary);
	}

	.library-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5rem;
		margin-top: 1rem;
		padding-bottom: 0.25rem;
		border-bottom: 1px solid var(--rule);
	}

	/* ── Library picks: .knowledge-item cards ───────────────────── */

	.knowledge-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2.25rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 640px) {
		.knowledge-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1100px) {
		.knowledge-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.knowledge-item {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.knowledge-item .resource-art {
		--resource-art-height: 10rem;
		margin-bottom: 1rem;
	}

	.knowledge-label {
		margin: 0 0 0.45rem;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.knowledge-item h3 {
		margin: 0 0 0.5rem;
		font: 400 1.375rem/1.2 var(--font-serif);
		letter-spacing: -0.01em;
		overflow-wrap: anywhere;
	}

	.knowledge-item h3 a {
		transition: color 160ms ease;
	}

	.knowledge-item h3 a:hover,
	.knowledge-item h3 a:focus-visible {
		color: var(--accent);
	}

	.knowledge-item h3 .library-action-icon {
		display: inline-block;
		margin-left: 0.2rem;
		vertical-align: -0.08em;
		color: var(--secondary);
	}

	.library-pick-note {
		margin: 0 0 0.75rem;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--secondary);
	}

	.library-pick-note :where(p, ul, ol) {
		margin: 0 0 0.5em;
	}

	.library-pick-note :where(:last-child) {
		margin-bottom: 0;
	}

	.library-pick-note a {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.knowledge-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.75rem;
		margin-top: auto;
		padding-top: 0.25rem;
	}

	.knowledge-meta > span:not(.chip) {
		font: 400 0.6875rem/1.5 var(--font-mono);
		letter-spacing: 0.04em;
		color: var(--secondary);
	}

	/* ── Useful Feeds rows: the title link covers the whole row ─── */

	.feed-row {
		position: relative;
	}

	.feed-row h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.feed-source {
		font: 400 0.6875rem/1.5 var(--font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.feed-row h3 .library-action-icon {
		display: inline-block;
		margin-left: 0.3rem;
		vertical-align: -0.05em;
		color: var(--secondary);
	}

	.feed-row:hover h3 a,
	.feed-row:focus-within h3 a {
		color: var(--accent);
	}

	/* ── Learning paths ─────────────────────────────────────────── */

	.path-step {
		display: grid;
		grid-template-columns: 2.75rem minmax(0, 1fr);
		gap: 0 0.75rem;
		padding: 1.1rem 0;
	}

	.path-step-number {
		padding-top: 0.35rem;
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		color: var(--accent);
	}

	.path-step-title {
		margin: 0 0 0.35rem;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.support-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 0 2.5rem;
	}

	.support-grid .atelier-row :where(h2, h3) {
		font-size: 1.0625rem;
	}

	/* ── Decks ──────────────────────────────────────────────────── */

	.deck-frame {
		margin-bottom: 1.5rem;
		padding: 1rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper-light);
	}

	.deck-frame-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
		margin-bottom: 0.9rem;
	}

	.deck-frame-head h3 {
		margin: 0.4rem 0 0;
		font: 400 1.375rem/1.2 var(--font-serif);
	}

	.deck-preview {
		aspect-ratio: var(--library-latest-deck-ratio, 16 / 9);
		overflow: hidden;
		border: 1px solid var(--rule);
		background: var(--stage);
	}

	.deck-preview img {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
		object-fit: contain;
	}

	.deck-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.deck-control {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 1px solid var(--rule-strong);
		background: transparent;
		color: var(--ink);
		cursor: pointer;
		transition:
			border-color 160ms ease,
			color 160ms ease;
	}

	.deck-control:hover:not(:disabled),
	.deck-control:focus-visible:not(:disabled) {
		border-color: var(--accent);
		color: var(--accent);
	}

	.deck-control:disabled {
		cursor: not-allowed;
		opacity: 0.4;
	}

	.deck-counter {
		min-width: 4.25rem;
		text-align: center;
		font: 400 0.75rem/1.4 var(--font-mono);
		letter-spacing: 0.06em;
		color: var(--secondary);
	}

	.deck-frame-note {
		margin: 0.9rem 0 0;
		max-width: 46rem;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--secondary);
	}
</style>
