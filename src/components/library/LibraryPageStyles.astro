<style is:global>
	.library-page {
		--library-panel-bg: linear-gradient(180deg, rgba(59, 55, 49, 0.94), rgba(47, 44, 40, 0.92));
		--library-panel-border: rgba(251, 191, 36, 0.14);
		--library-panel-top: rgba(251, 146, 60, 0.38);
		--library-panel-shadow: 0 18px 44px rgba(0, 0, 0, 0.2);
		--library-panel-hover-border: rgba(251, 191, 36, 0.28);
		--library-pill-bg: rgba(255, 255, 255, 0.055);
		--library-pill-border: rgba(255, 237, 213, 0.12);
		--library-pill-text: rgba(255, 237, 213, 0.86);
		--library-muted-text: rgba(226, 232, 240, 0.64);
		--library-action-bg: rgba(249, 115, 22, 0.11);
		--library-action-border: rgba(251, 146, 60, 0.36);
		--library-action-text: #fed7aa;
	}

	.library-page :where(h1, h2, h3, p):not([class*="mb-"]) {
		margin-bottom: 0;
	}

	.library-page :where(h1, h2, h3) {
		margin-top: 0;
	}

	.library-kicker {
		display: inline-flex;
		border-radius: 0.5rem;
		border: 1px solid rgba(251, 146, 60, 0.28);
		background: rgba(249, 115, 22, 0.1);
		padding: 0.25rem 0.75rem;
		color: #ffedd5;
		font-size: 0.875rem;
		font-weight: 700;
	}

	.library-panel {
		position: relative;
		overflow: hidden;
		border-radius: 0.5rem;
		border: 1px solid var(--library-panel-border);
		background: var(--library-panel-bg);
		box-shadow: var(--library-panel-shadow);
		padding: 1.25rem;
		transition:
			border-color 180ms ease,
			background 180ms ease,
			box-shadow 180ms ease,
			transform 180ms ease;
	}

	.library-panel::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--library-panel-top), transparent);
		pointer-events: none;
	}

	.library-panel:hover {
		border-color: var(--library-panel-hover-border);
		box-shadow: 0 22px 52px rgba(0, 0, 0, 0.24);
		transform: translateY(-1px);
	}

	.library-panel-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.library-panel-link:focus-visible {
		outline: 2px solid rgba(251, 146, 60, 0.7);
		outline-offset: 3px;
	}

	.library-latest-deck-card {
		display: grid;
		gap: 1rem;
		padding: 1rem;
	}

	.library-latest-deck-header,
	.library-latest-deck-actions {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.library-deck-preview {
		aspect-ratio: var(--library-latest-deck-ratio, 16 / 9);
		overflow: hidden;
		border: 1px solid rgba(255, 237, 213, 0.1);
		border-radius: 0.5rem;
		background: rgba(15, 23, 42, 0.4);
	}

	.library-deck-preview img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: rgb(15, 23, 42);
	}

	.library-deck-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}

	.library-deck-control {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.375rem;
		height: 2.375rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 237, 213, 0.14);
		background: rgba(255, 255, 255, 0.055);
		color: rgba(255, 237, 213, 0.9);
		padding: 0;
		transition:
			background 160ms ease,
			border-color 160ms ease,
			color 160ms ease,
			opacity 160ms ease;
	}

	.library-deck-control:hover:not(:disabled),
	.library-deck-control:focus-visible:not(:disabled) {
		border-color: rgba(251, 146, 60, 0.42);
		background: rgba(249, 115, 22, 0.12);
		color: #ffedd5;
	}

	.library-deck-control:disabled {
		cursor: not-allowed;
		opacity: 0.42;
	}

	.library-deck-counter {
		min-width: 4.25rem;
		text-align: center;
		color: rgba(226, 232, 240, 0.72);
		font-size: 0.875rem;
		font-weight: 700;
	}

	/* A muted label inside a panel footer (e.g. an item count) that must stay
	   readable in light mode. Plain `text-slate-*` utility classes on a
	   non-heading, non-paragraph element (a <span>) are NOT covered by the
	   global `body.light-theme :where(h1,h2,h3,p,...)` override — that
	   selector's zero-specificity :where() only beats a same-specificity
	   Tailwind color utility when the element is one of the tags it lists.
	   Route through this CSS variable instead of a raw slate utility. */
	.library-muted-label {
		color: var(--library-muted-text);
	}

	.library-panel-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 1.25rem;
		border-top: 1px solid rgba(255, 237, 213, 0.09);
		padding-top: 1rem;
		font-size: 0.875rem;
	}

	.library-section-button {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-height: 2rem;
		border-radius: 999px;
		border: 1px solid rgba(251, 146, 60, 0.3);
		background: rgba(249, 115, 22, 0.11);
		padding: 0.4rem 0.7rem;
		color: #fed7aa;
		font-weight: 700;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
		transition:
			background 160ms ease,
			border-color 160ms ease,
			color 160ms ease,
			transform 160ms ease,
			box-shadow 160ms ease;
	}

	.library-panel-link:hover .library-section-button,
	.library-panel-link:focus-visible .library-section-button {
		border-color: rgba(251, 146, 60, 0.54);
		background: rgba(249, 115, 22, 0.18);
		color: #ffedd5;
		box-shadow: 0 10px 24px rgba(249, 115, 22, 0.12);
		transform: translateX(2px);
	}

	.library-pill,
	.library-badge {
		border-radius: 0.5rem;
		border: 1px solid var(--library-pill-border);
		background: var(--library-pill-bg);
		color: var(--library-pill-text);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1rem;
	}

	.library-pill {
		padding: 0.25rem 0.5rem;
	}

	.library-badge {
		padding: 0.25rem 0.5rem;
	}

	.library-badge--available {
		border-color: rgba(251, 191, 36, 0.26);
		background: rgba(251, 191, 36, 0.1);
		color: #fde68a;
	}

	.library-badge--muted {
		border-color: rgba(226, 232, 240, 0.12);
		background: rgba(255, 255, 255, 0.045);
		color: var(--library-muted-text);
	}

	.library-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 2.5rem;
		border-radius: 999px;
		border: 1px solid var(--library-action-border);
		background: var(--library-action-bg);
		padding: 0.58rem 0.9rem;
		color: var(--library-action-text);
		font-size: 0.875rem;
		font-weight: 800;
		text-decoration: none;
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
		transition:
			background 160ms ease,
			border-color 160ms ease,
			color 160ms ease,
			box-shadow 160ms ease,
			transform 160ms ease;
	}

	.library-action:hover,
	.library-action:focus-visible {
		border-color: rgba(251, 146, 60, 0.58);
		background: rgba(249, 115, 22, 0.2);
		color: #ffedd5;
		box-shadow: 0 14px 30px rgba(249, 115, 22, 0.14);
		text-decoration: none;
		transform: translateY(-1px);
	}

	.library-action-icon {
		width: 1rem;
		height: 1rem;
		flex: 0 0 auto;
		stroke-width: 1.9;
		transition: transform 160ms ease;
	}

	.library-action--back:hover .library-action-icon,
	.library-action--back:focus-visible .library-action-icon {
		transform: translateX(-2px);
	}

	.library-panel-link:hover .library-section-button .library-action-icon,
	.library-panel-link:focus-visible .library-section-button .library-action-icon,
	.library-action--external:hover .library-action-icon,
	.library-action--external:focus-visible .library-action-icon,
	.library-action--deck:hover .library-action-icon,
	.library-action--deck:focus-visible .library-action-icon,
	.library-action--download:hover .library-action-icon,
	.library-action--download:focus-visible .library-action-icon {
		transform: translateX(2px);
	}

	body.light-theme .library-page {
		--library-panel-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(255, 247, 237, 0.86));
		--library-panel-border: rgba(194, 65, 12, 0.16);
		--library-panel-top: rgba(249, 115, 22, 0.36);
		--library-panel-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
		--library-panel-hover-border: rgba(194, 65, 12, 0.28);
		--library-pill-bg: rgba(249, 115, 22, 0.07);
		--library-pill-border: rgba(194, 65, 12, 0.14);
		--library-pill-text: #7c2d12;
		--library-muted-text: #64748b;
		--library-action-bg: rgba(249, 115, 22, 0.1);
		--library-action-border: rgba(194, 65, 12, 0.22);
		--library-action-text: #9a3412;
	}

	body.light-theme .library-kicker {
		border-color: rgba(194, 65, 12, 0.2);
		background: rgba(249, 115, 22, 0.1);
		color: #9a3412;
	}

	body.light-theme .library-panel:hover {
		box-shadow: 0 18px 42px rgba(15, 23, 42, 0.12);
	}

	body.light-theme .library-deck-preview {
		border-color: rgba(194, 65, 12, 0.12);
		background: rgba(255, 247, 237, 0.8);
	}

	body.light-theme .library-deck-control {
		border-color: rgba(194, 65, 12, 0.16);
		background: rgba(249, 115, 22, 0.07);
		color: #9a3412;
	}

	body.light-theme .library-deck-control:hover:not(:disabled),
	body.light-theme .library-deck-control:focus-visible:not(:disabled) {
		border-color: rgba(194, 65, 12, 0.28);
		background: rgba(249, 115, 22, 0.12);
		color: #7c2d12;
	}

	body.light-theme .library-deck-counter {
		color: #64748b;
	}

	body.light-theme .library-badge--available {
		border-color: rgba(217, 119, 6, 0.22);
		background: rgba(245, 158, 11, 0.1);
		color: #92400e;
	}

	body.light-theme .library-badge--muted {
		border-color: rgba(15, 23, 42, 0.1);
		background: rgba(15, 23, 42, 0.035);
		color: #64748b;
	}

	body.light-theme .library-action {
		color: #9a3412 !important;
	}

	body.light-theme .library-action:hover,
	body.light-theme .library-action:focus-visible {
		border-color: rgba(194, 65, 12, 0.34);
		background: rgba(249, 115, 22, 0.16);
		color: #7c2d12 !important;
	}

	body.light-theme .library-section-button {
		border-color: rgba(194, 65, 12, 0.2);
		background: rgba(249, 115, 22, 0.1);
		color: #9a3412;
	}

	body.light-theme .library-panel-link:hover .library-section-button,
	body.light-theme .library-panel-link:focus-visible .library-section-button {
		border-color: rgba(194, 65, 12, 0.34);
		background: rgba(249, 115, 22, 0.16);
		color: #7c2d12;
	}

	/* Library tabs (외부 링크 / Useful Feeds) and section filter chips
	   (docs/decisions/site-structure.md#3,5). Anchors are not covered by the
	   global light-theme `:where(h1..h6, p, ...)` override, so both use
	   `--library-pill-text`/`--library-pill-border`/`--library-pill-bg` for
	   their resting state and an explicit light-theme block below for the
	   active state, matching `.library-badge--available`'s pattern. */
	.library-tabs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.25rem;
	}

	.library-tabs-group {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.library-tab,
	.library-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border-radius: 999px;
		border: 1px solid var(--library-pill-border);
		background: var(--library-pill-bg);
		color: var(--library-pill-text);
		padding: 0.45rem 0.85rem;
		font-size: 0.8125rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			border-color 160ms ease,
			background 160ms ease,
			color 160ms ease;
	}

	.library-tab:hover,
	.library-tab:focus-visible,
	.library-chip:hover,
	.library-chip:focus-visible {
		border-color: var(--library-panel-hover-border);
	}

	.library-tab[aria-current='page'],
	.library-chip[aria-current='page'] {
		border-color: rgba(251, 146, 60, 0.5);
		background: rgba(249, 115, 22, 0.16);
		color: #ffedd5;
	}

	body.light-theme .library-tab[aria-current='page'],
	body.light-theme .library-chip[aria-current='page'] {
		border-color: rgba(194, 65, 12, 0.32);
		background: rgba(249, 115, 22, 0.14);
		color: #7c2d12;
	}

	/* The plain-text "research-os" label beside the Useful Feeds tab — never
	   a link (docs/decisions/site-structure.md#3). Reuses the muted-text
	   variable rather than a bare `text-slate-*` utility, same reasoning as
	   `.library-muted-label` above. */
	.library-tab-note {
		color: var(--library-muted-text);
		font-size: 0.75rem;
		font-weight: 600;
	}

	/* A subtle, non-alarming freshness warning (docs/decisions/site-structure.md#7):
	   "확인 필요" / "업데이트 멈춤" should read as a gentle flag, not an error. */
	.library-badge--warning {
		border-color: rgba(250, 204, 21, 0.32);
		background: rgba(250, 204, 21, 0.12);
		color: #fde68a;
	}

	body.light-theme .library-badge--warning {
		border-color: rgba(161, 98, 7, 0.28);
		background: rgba(250, 204, 21, 0.18);
		color: #854d0e;
	}

	/* A link whose accessible name is provided by a heading/paragraph
	   ancestor already covered by the global light-theme override — inheriting
	   color avoids yet another explicit light/dark pair for the same text. */
	.library-inherit-link {
		color: inherit;
		text-decoration: none;
	}

	.library-inherit-link:hover,
	.library-inherit-link:focus-visible {
		text-decoration: underline;
	}

	/* Tailwind's preflight makes every svg display:block, which pushed the
	   external icon onto its own line under the title. */
	.library-inherit-link .library-action-icon {
		display: inline-block;
		margin-left: 0.25rem;
		vertical-align: -0.125em;
	}

	/* The owner's note (a pick's rendered Markdown body) can contain its own
	   links; give them a visible, theme-aware color instead of leaving them
	   to inherit the muted note text color. */
	.library-pick-note a {
		color: var(--library-action-text);
		text-decoration: underline;
	}

	.library-feed-row {
		display: block;
	}

	@media (max-width: 640px) {
		.library-latest-deck-header,
		.library-latest-deck-actions {
			flex-direction: column;
		}
	}
</style>
