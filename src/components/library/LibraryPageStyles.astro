		color: #7c2d12 !important;
	}

	body.light-theme .library-section-button {
		border-color: rgba(194, 65, 12, 0.2);
		background: rgba(249, 115, 22, 0.1);
		color: #9a3412;
	}

	body.light-theme .library-panel-link:hover .library-section-button,
	body.light-theme .library-panel-link:focus-visible .library-section-button {
