<style is:global>
	.library-page {
		--library-panel-bg: linear-gradient(180deg, rgba(59, 55, 49, 0.94), rgba(47, 44, 40, 0.92));
		--library-panel-border: rgba(251, 191, 36, 0.14);
		--library-panel-top: rgba(251, 146, 60, 0.38);
		--library-panel-shadow: 0 18px 44px rgba(0, 0, 0, 0.2);
		--library-panel-hover-border: rgba(251, 191, 36, 0.28);
		--library-pill-bg: rgba(255, 255, 255, 0.055);
		--library-pill-border: rgba(255, 237, 213, 0.12);
		--library-pill-text: rgba(255, 237, 213, 0.86);
		--library-muted-text: rgba(226, 232, 240, 0.64);
		--library-action-bg: rgba(249, 115, 22, 0.11);
		--library-action-border: rgba(251, 146, 60, 0.36);
		--library-action-text: #fed7aa;
	}

	.library-kicker {
		display: inline-flex;
		border-radius: 0.5rem;
		border: 1px solid rgba(251, 146, 60, 0.28);
		background: rgba(249, 115, 22, 0.1);
		padding: 0.25rem 0.75rem;
		color: #ffedd5;
		font-size: 0.875rem;
		font-weight: 700;
	}

	.library-panel {
		position: relative;
		overflow: hidden;
		border-radius: 0.5rem;
		border: 1px solid var(--library-panel-border);
		background: var(--library-panel-bg);
		box-shadow: var(--library-panel-shadow);
		padding: 1.25rem;
		transition:
			border-color 180ms ease,
			background 180ms ease,
			box-shadow 180ms ease,
			transform 180ms ease;
	}

	.library-panel::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--library-panel-top), transparent);
		pointer-events: none;
	}

	.library-panel:hover {
		border-color: var(--library-panel-hover-border);
		box-shadow: 0 22px 52px rgba(0, 0, 0, 0.24);
		transform: translateY(-1px);
	}

	.library-panel-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.library-panel-link:focus-visible {
		outline: 2px solid rgba(251, 146, 60, 0.7);
		outline-offset: 3px;
	}

	.library-panel-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 1.25rem;
		border-top: 1px solid rgba(255, 237, 213, 0.09);
		padding-top: 1rem;
		font-size: 0.875rem;
	}

	.library-pill,
	.library-badge {
		border-radius: 0.5rem;
		border: 1px solid var(--library-pill-border);
		background: var(--library-pill-bg);
		color: var(--library-pill-text);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1rem;
	}

	.library-pill {
		padding: 0.25rem 0.5rem;
	}

	.library-badge {
		padding: 0.25rem 0.5rem;
	}

	.library-badge--available {
		border-color: rgba(251, 191, 36, 0.26);
		background: rgba(251, 191, 36, 0.1);
		color: #fde68a;
	}

	.library-badge--muted {
		border-color: rgba(226, 232, 240, 0.12);
		background: rgba(255, 255, 255, 0.045);
		color: var(--library-muted-text);
	}

	.library-action {
		display: inline-flex;
		min-height: 2.5rem;
		align-items: center;
		border-radius: 0.5rem;
		border: 1px solid var(--library-action-border);
		background: var(--library-action-bg);
		padding: 0.5rem 0.75rem;
		color: var(--library-action-text);
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			background 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
	}

	.library-action:hover {
		border-color: rgba(251, 146, 60, 0.58);
		background: rgba(249, 115, 22, 0.16);
		color: #ffedd5;
	}

	body.light-theme .library-page {
		--library-panel-bg: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(255, 247, 237, 0.86));
		--library-panel-border: rgba(194, 65, 12, 0.16);
		--library-panel-top: rgba(249, 115, 22, 0.36);
		--library-panel-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
		--library-panel-hover-border: rgba(194, 65, 12, 0.28);
		--library-pill-bg: rgba(249, 115, 22, 0.07);
		--library-pill-border: rgba(194, 65, 12, 0.14);
		--library-pill-text: #7c2d12;
		--library-muted-text: #64748b;
		--library-action-bg: rgba(249, 115, 22, 0.1);
		--library-action-border: rgba(194, 65, 12, 0.22);
		--library-action-text: #9a3412;
	}

	body.light-theme .library-kicker {
		border-color: rgba(194, 65, 12, 0.2);
		background: rgba(249, 115, 22, 0.1);
		color: #9a3412;
	}

	body.light-theme .library-panel:hover {
		box-shadow: 0 18px 42px rgba(15, 23, 42, 0.12);
	}

	body.light-theme .library-badge--available {
		border-color: rgba(217, 119, 6, 0.22);
		background: rgba(245, 158, 11, 0.1);
		color: #92400e;
	}

	body.light-theme .library-badge--muted {
		border-color: rgba(15, 23, 42, 0.1);
		background: rgba(15, 23, 42, 0.035);
		color: #64748b;
	}

	body.light-theme .library-action {
		color: #9a3412 !important;
	}
</style>
