		width: 100%;
		height: 100%;
		object-fit: contain;
		background: rgb(15, 23, 42);
	}

	.library-deck-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}

	.library-deck-control {
