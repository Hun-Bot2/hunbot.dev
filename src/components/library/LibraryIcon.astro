---
type IconName = 'arrow-left' | 'arrow-right' | 'article' | 'book-open' | 'external' | 'download' | 'search';

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className = 'library-action-icon' } = Astro.props;

const iconPaths: Record<IconName, string[]> = {
	'arrow-left': ['M19 12H5', 'M12 19l-7-7 7-7'],
	'arrow-right': ['M5 12h14', 'M12 5l7 7-7 7'],
	article: ['M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z', 'M14 2v6h6', 'M8 13h8', 'M8 17h5'],
	'book-open': ['M12 7v14', 'M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z'],
	external: ['M7 17 17 7', 'M10 7h7v7'],
	download: ['M12 4v11', 'M7 10l5 5 5-5', 'M5 20h14'],
	search: ['M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16z', 'M21 21l-4.35-4.35'],
};
---

<svg
	class={className}
	aria-hidden="true"
	width="1em"
	height="1em"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	{iconPaths[name].map((path) => <path d={path} />)}
</svg>
