---
// The Library's visible filter (docs/decisions/site-structure.md, Revision
// 2026-10-23b): an inline bar directly under the tab bar on 자료 and 신호, in
// place of the floating button the blog keeps. Rows of facet chips with counts;
// a chip with a `parent` (a 주제 under its 분야) is shown grouped under that
// parent and only while the parent facet is 전체 or that value; a `toggle` facet
// (노트 있음) is a single chip. Behaviour is public/scripts/blog-filters.js (the
// same selection logic, URL params and localStorage the blog uses): it reads
// `data-blog-filters`, `data-facets`, `data-storage-key`, `[data-facet]
// [data-value]` chips, `[data-parent-group]` wrappers, `[data-filter-results]`,
// `[data-filter-reset]`, `[data-filter-toggle]` and `[data-filter-count]`.
// Below 640px the bar scrolls with the page and collapses behind "필터 · n".
import { useTranslations, type UILanguage } from '../../i18n/ui';

interface FacetOption {
	value: string;
	label: string;
	count: number;
	/** A topic under its area: shown grouped under that area. */
	parent?: { facet: string; value: string; label: string };
}

interface FacetGroup {
	facet: string;
	label: string;
	options: FacetOption[];
	/** One chip, no 전체 chip: the facet is either on or off. */
	toggle?: boolean;
}

interface Props {
	lang: UILanguage;
	groups: FacetGroup[];
	storageKey: string;
	/** Contains `{count}` and, optionally, `{total}`. */
	resultsTemplate: string;
	label: string;
	totalCount: number;
}

const { lang, groups, storageKey, resultsTemplate, label, totalCount } = Astro.props;
const t = useTranslations(lang);
const visibleGroups = groups.filter((group) => group.options.length > 0);
const facets = visibleGroups.map((group) => group.facet).join(',');
const fill = (template: string) => template.replace('{count}', String(totalCount)).replace('{total}', String(totalCount));

// Options of a grouped facet, bucketed by parent in the order they arrive.
function byParent(options: FacetOption[]) {
	const buckets: { parent: NonNullable<FacetOption['parent']>; options: FacetOption[] }[] = [];
	for (const option of options) {
		const parent = option.parent!;
		const bucket = buckets.find((item) => item.parent.value === parent.value);
		if (bucket) bucket.options.push(option);
		else buckets.push({ parent, options: [option] });
	}
	return buckets;
}
---

<section class="library-filter page-frame" aria-label={label} data-blog-filters data-facets={facets} data-storage-key={storageKey}>
	<div class="lf-head">
		<button type="button" class="lf-toggle" data-filter-toggle aria-expanded="false" aria-controls="library-filter-body">
			{t('library.filter-open')}<span class="lf-toggle-count" data-filter-count hidden>0</span>
		</button>
		<p class="lf-status">
			<span data-filter-results data-results-template={resultsTemplate} aria-live="polite">{fill(resultsTemplate)}</span>
			<button type="button" class="lf-reset" data-filter-reset hidden>{t('library.filter-clear')}</button>
		</p>
	</div>

	<div class="lf-body" id="library-filter-body">
		{
			visibleGroups.map((group) => (
				<div class="lf-row" role="group" aria-label={group.label}>
					<span class="lf-label" aria-hidden="true">{group.label}</span>
					<div class="lf-chips">
						{!group.toggle && (
							<button type="button" class="lf-chip is-active" data-facet={group.facet} data-value="all" aria-pressed="true">
								{t('blog.filter-all')}
							</button>
						)}
						{group.options.some((option) => option.parent) ? (
							<Fragment>
								{byParent(group.options).map(({ parent, options }) => (
									<span class="lf-subgroup" data-parent-group data-parent-facet={parent.facet} data-parent-value={parent.value}>
										<span class="lf-sublabel" data-group-label>{parent.label}</span>
										{options.map((option) => (
											<button
												type="button"
												class="lf-chip"
												data-facet={group.facet}
												data-value={option.value}
												data-parent-facet={parent.facet}
												data-parent-value={parent.value}
												aria-pressed="false"
											>
												{option.label}<span class="lf-count">{option.count}</span>
											</button>
										))}
									</span>
								))}
							</Fragment>
						) : (
							group.options.map((option) => (
								<button type="button" class="lf-chip" data-facet={group.facet} data-value={option.value} aria-pressed="false">
									{option.label}<span class="lf-count">{option.count}</span>
								</button>
							))
						)}
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.library-filter {
		padding: 0.75rem 0 0.25rem;
	}

	.lf-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
	}

	.lf-toggle,
	.lf-reset {
		min-height: 2.5rem;
		padding: 0;
		border: 0;
		background: none;
		font: 400 0.8125rem/1.4 var(--font-mono);
		letter-spacing: 0.04em;
		color: var(--ink);
		cursor: pointer;
	}

	.lf-toggle-count::before {
		content: ' · ';
	}

	.lf-reset {
		margin-left: 0.9rem;
		color: var(--secondary);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.lf-reset:hover,
	.lf-reset:focus-visible {
		color: var(--accent);
	}

	.lf-reset[hidden],
	.lf-toggle-count[hidden] {
		display: none;
	}

	/* Result count sits at the bar's right on desktop; the toggle is for phones only. */
	.lf-status {
		margin: 0 0 0 auto;
		font: 400 0.8125rem/1.4 var(--font-mono);
		letter-spacing: 0.04em;
		font-variant-numeric: tabular-nums;
		color: var(--secondary);
	}

	.lf-body {
		display: none;
	}

	.library-filter.is-open .lf-body {
		display: block;
	}

	.lf-row {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr);
		gap: 0 0.75rem;
		align-items: start;
		padding: 0.35rem 0;
	}

	.lf-label {
		padding-top: 0.45rem;
		font: 400 0.6875rem/1.5 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.lf-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.5rem;
		align-items: center;
	}

	.lf-subgroup {
		display: contents;
	}

	.lf-subgroup[hidden] {
		display: none;
	}

	/* The area's name leads its topics when no area is chosen. */
	.lf-sublabel {
		flex-basis: 100%;
		margin-top: 0.25rem;
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.lf-sublabel[hidden] {
		display: none;
	}

	/* A 32px chip; the ::after widens the touch target to 40px without overlapping its neighbours. */
	.lf-chip {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2rem;
		padding: 0 0.7rem;
		border: 1px solid var(--rule-strong);
		background: none;
		font: 400 0.8125rem/1.3 var(--font-mono);
		letter-spacing: 0.02em;
		white-space: nowrap;
		color: var(--secondary);
		cursor: pointer;
		transition: color var(--dur-1) var(--ease-standard), border-color var(--dur-1) var(--ease-standard);
	}

	.lf-chip::after {
		content: '';
		position: absolute;
		inset: -4px 0;
	}

	.lf-chip:hover {
		color: var(--ink);
	}

	.lf-chip.is-active {
		border-color: var(--ink);
		color: var(--accent);
	}

	.lf-chip:focus-visible,
	.lf-toggle:focus-visible,
	.lf-reset:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	.lf-chip[hidden] {
		display: none;
	}

	.lf-count {
		font-size: 0.6875rem;
		font-variant-numeric: tabular-nums;
		color: var(--faint);
	}

	.lf-chip.is-active .lf-count {
		color: var(--secondary);
	}

	@media (min-width: 640px) {
		.lf-toggle {
			display: none;
		}

		.lf-body {
			display: block;
		}
	}

	@media (max-width: 639px) {
		.lf-row {
			grid-template-columns: minmax(0, 1fr);
		}

		.lf-label {
			padding-top: 0.25rem;
		}
	}
</style>
