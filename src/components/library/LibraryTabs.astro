---
// Shared tab bar for the Library's two URL-addressable tabs
// (docs/decisions/site-structure.md#3): 외부 링크 (default, `/{lang}/library/`
// and every pick section page under it) and Useful Feeds
// (`/{lang}/library/useful-feeds/`). The "research-os" label next to Useful
// Feeds is plain text, never a link — it names where those items came from
// without linking to the private repository.
import { useTranslations, type UILanguage } from '../../i18n/ui';

interface Props {
	lang: UILanguage;
	/** Pick section pages count as the 외부 링크 tab (docs/decisions/site-structure.md#3). */
	active: 'external-links' | 'useful-feeds';
}

const { lang, active } = Astro.props;
const t = useTranslations(lang);

const externalLinksUrl = `/${lang}/library/`;
const usefulFeedsUrl = `/${lang}/library/useful-feeds/`;
---

<nav class="library-tabs" aria-label={t('library.title')}>
	<a
		href={externalLinksUrl}
		class="library-tab"
		aria-current={active === 'external-links' ? 'page' : undefined}
	>
		{t('library.tab.external-links')}
	</a>
	<span class="library-tabs-group">
		<a
			href={usefulFeedsUrl}
			class="library-tab"
			aria-current={active === 'useful-feeds' ? 'page' : undefined}
		>
			{t('library.tab.useful-feeds')}
		</a>
		<span class="library-tab-note">{t('library.tab.research-os-label')}</span>
	</span>
</nav>
