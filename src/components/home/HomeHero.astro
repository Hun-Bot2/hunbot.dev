---
// The home hero: a lit "stage" band at the top of /{lang}/ that auto-advances
// through the newest writing. The one place on the site that moves on its own
// (docs/decisions/creative-direction.md, The Exceptions). It must:
//   - show a visible pause control, and pause on hover, focus and a hidden tab;
//   - render the first slide complete with no JavaScript (the controls and the
//     other slides only appear once hero-client.ts marks the section ready);
//   - not auto-advance, and show headlines at once, under reduced motion;
//   - use only the motion tokens (src/styles/tokens.css).
// Slide selection and word splitting: src/utils/hero.ts. Behaviour:
// ./hero-client.ts. Copy: `home.hero.*` in src/i18n/ui.ts.
import type { CollectionEntry } from 'astro:content';
import { getAcademicReviewUrlFromEntry } from '../../utils/academic-review-routing';
import { getBlogUrlFromId } from '../../utils/blog-routing';
import { formatPostDate } from '../../utils/display';
import { plateWord, splitHeadline, type HeroSlide } from '../../utils/hero';
import { getResponsivePublicImage } from '../../utils/responsive-public-images';
import { useTranslations, type UILanguage } from '../../i18n/ui';

interface Props {
	slides: HeroSlide<CollectionEntry<'blog'>, CollectionEntry<'academicReviews'>>[];
	lang: UILanguage;
	/** Plate corner label per post id (series or category); reviews show their venue. */
	plateLabels?: Record<string, string>;
}

const { slides, lang, plateLabels = {} } = Astro.props;
const t = useTranslations(lang);
const total = slides.length;
const interactive = total > 1;

const items = slides.map((slide, index) => {
	const words = splitHeadline(slide.title, lang);
	const hero = slide.heroImage ? getResponsivePublicImage(slide.heroImage) : null;
	return {
		slide,
		index,
		words,
		hero,
		href: slide.kind === 'post' ? getBlogUrlFromId(slide.entry.id) : getAcademicReviewUrlFromEntry(slide.entry),
		kindLabel: t(slide.kind === 'post' ? 'home.hero.kind.post' : 'home.hero.kind.review'),
		plate: plateWord(slide.title, lang),
		plateLabel:
			slide.kind === 'post'
				? (plateLabels[slide.entry.id] ?? '')
				: ([slide.entry.data.paper.venue, slide.entry.data.paper.year].filter(Boolean).join(' · ') || t('home.hero.kind.review')),
		// Width of the plate word in em (CJK glyphs about twice a Latin one), so it can be sized to fit.
		plateEm: Array.from(plateWord(slide.title, lang)).reduce((sum, ch) => sum + (ch.charCodeAt(0) < 0x250 ? 0.52 : 1.02), 0.1),
		label: t('home.hero.slide').replace('{n}', String(index + 1)).replace('{total}', String(total)),
	};
});
---

{
	total > 0 && (
		<section
			class="hero"
			data-hero
			data-interval="7000"
			aria-roledescription="carousel"
			aria-label={t('home.hero.label')}
			data-labels={JSON.stringify({ pause: t('home.hero.pause'), play: t('home.hero.play') })}
		>
			<div class="hero-stage">
				<div class="hero-slides" data-hero-slides aria-live="off">
					{items.map(({ slide, index, words, hero, href, kindLabel, plate, plateLabel, plateEm, label }) => (
						<div
							class="hero-slide"
							role="group"
							aria-roledescription="slide"
							aria-label={label}
							data-hero-slide
							data-active={index === 0 ? '' : undefined}
							inert={index > 0}
							style={`--n:${words.length}`}
						>
							<span class="hero-glow" aria-hidden="true" />
							<div class="hero-copy">
								<a class="hero-link" href={href}>
									<p class="hero-eyebrow">
										{kindLabel} · <time datetime={slide.date.toISOString()}>{formatPostDate(slide.date)}</time>
									</p>
									<h2 class="hero-title">
										{words.map((word, i) => (
											<Fragment>
												<span class="hero-word" style={`--i:${i}`}>
													{word.text}
												</span>
												{word.spaceAfter && ' '}
											</Fragment>
										))}
									</h2>
									{slide.description && <p class="hero-desc">{slide.description}</p>}
									<span class="btn-pill hero-cta">
										{t('home.hero.read')} <span aria-hidden="true">→</span>
									</span>
								</a>
							</div>
							<div class="hero-media" aria-hidden="true">
								{hero ? (
									<picture>
										{hero.webpSrcSet && (
											<source type="image/webp" srcset={hero.webpSrcSet} sizes="(max-width: 799px) 100vw, 520px" />
										)}
										<img
											src={hero.src}
											alt=""
											width={hero.width}
											height={hero.height}
											sizes="(max-width: 799px) 100vw, 520px"
											loading={index === 0 ? 'eager' : 'lazy'}
											decoding="async"
										/>
									</picture>
								) : (
									<div class="hero-plate" style={`--em:${plateEm.toFixed(2)}`}>
										<span class="hero-plate-kind">{plateLabel}</span>
										<span class="hero-plate-word">{plate}</span>
									</div>
								)}
							</div>
						</div>
					))}
				</div>
			</div>

			{interactive && (
				<div class="hero-controls" data-hero-controls>
					<button type="button" class="hero-toggle" data-hero-toggle aria-label={t('home.hero.pause')}>
						<svg class="hero-icon hero-icon--pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
							<path d="M5 3.5v9M11 3.5v9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
						</svg>
						<svg class="hero-icon hero-icon--play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
							<path d="M5.5 3.4v9.2l7-4.6z" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
						</svg>
					</button>
					<div class="hero-dots" role="group" aria-label={t('home.hero.label')}>
						{items.map(({ index }) => (
							<button
								type="button"
								class="hero-dot"
								data-hero-dot
								aria-label={t('home.hero.go').replace('{n}', String(index + 1))}
								aria-current={index === 0 ? 'true' : undefined}
							>
								<span class="hero-dot-bar">
									<span class="hero-dot-fill" />
								</span>
							</button>
						))}
					</div>
				</div>
			)}
		</section>
	)
}

<script>
	import { initHero } from './hero-client';

	document.querySelectorAll<HTMLElement>('[data-hero]').forEach(initHero);
</script>

<style>
	.hero {
		--hero-interval: 7s;
		margin-bottom: 2.25rem;
	}

	/* ── Stage: a lit band on the paper, dark in both themes ── */
	.hero-stage {
		position: relative;
		overflow: hidden;
		border-radius: 2px;
		background: var(--stage);
		color: var(--stage-ink);
	}

	/* In dark mode the stage is close to the paper: a rule marks its edge. */
	:global(html.dark) .hero-stage {
		border: 1px solid var(--rule-strong);
	}

	.hero-slides {
		display: grid;
	}

	.hero-slide {
		position: relative;
		grid-area: 1 / 1;
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
		gap: 2.5rem;
		align-items: center;
		min-height: 440px;
		padding: 2.5rem;
		touch-action: pan-y;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--dur-4) var(--ease-standard),
			visibility 0s linear var(--dur-4);
	}

	.hero-slide[data-active] {
		opacity: 1;
		visibility: visible;
		transition-delay: 0s;
	}

	/* No JavaScript: the first slide only, the controls never. */
	.hero:not([data-ready]) .hero-slide:not([data-active]) {
		display: none;
	}

	.hero:not([data-ready]) .hero-slide {
		transition: none;
	}

	.hero-glow {
		position: absolute;
		top: 50%;
		right: 4%;
		width: 62%;
		aspect-ratio: 1;
		transform: translateY(-50%);
		background: radial-gradient(closest-side, color-mix(in oklab, var(--accent) 22%, transparent), transparent);
		pointer-events: none;
	}

	/* ── Copy ── */
	.hero-copy {
		position: relative;
		z-index: 1;
		min-width: 0;
	}

	.hero-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	/* The whole slide is the click target; the link itself stays the copy. */
	.hero-link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
	}

	.hero-link:focus-visible {
		outline: none;
	}

	.hero-slide:has(.hero-link:focus-visible) {
		outline: 2px solid var(--stage-ink);
		outline-offset: -6px;
	}

	.hero-eyebrow {
		margin: 0 0 1.1rem;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--stage-accent);
	}

	.hero-title {
		margin: 0 0 1.1rem;
		font: 400 clamp(2rem, 1.2rem + 3.4vw, 3.5rem) / 1.15 var(--font-serif);
		letter-spacing: -0.02em;
		text-wrap: balance;
		overflow-wrap: break-word;
		color: var(--stage-ink);
	}

	:global(html:lang(ko)) .hero-title,
	:global(html:lang(jp)) .hero-title {
		word-break: keep-all;
	}

	.hero-word {
		display: inline-block;
	}

	.hero-desc {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		max-width: 34rem;
		margin: 0 0 1.5rem;
		font: 400 0.9375rem/1.65 var(--font-sans);
		color: var(--stage-muted);
	}

	/* .btn-pill, made for the stage. */
	.hero-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.5rem;
		padding-inline: 1.15rem;
		border-color: color-mix(in oklab, var(--stage-ink) 45%, transparent);
		color: var(--stage-ink);
		transition:
			background-color var(--dur-2) var(--ease-standard),
			border-color var(--dur-2) var(--ease-standard),
			color var(--dur-2) var(--ease-standard);
	}

	.hero-cta > span {
		display: inline-block;
		transition: transform var(--dur-3) var(--ease-spring);
	}

	@media (hover: hover) {
		.hero-slide:hover .hero-cta {
			border-color: var(--stage-ink);
			background: var(--stage-ink);
			color: var(--stage);
		}

		.hero-slide:hover .hero-cta > span {
			transform: translateX(3px);
		}
	}

	/* ── Media ── */
	.hero-media {
		position: relative;
		z-index: 1;
		align-self: stretch;
		min-width: 0;
		overflow: hidden;
		border: 1px solid color-mix(in oklab, var(--stage-muted) 45%, transparent);
	}

	.hero-media picture,
	.hero-media img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-media img {
		object-fit: cover;
	}

	/* No image: a typographic plate, ruled paper in light on the stage. */
	.hero-plate {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		width: 100%;
		height: 100%;
		min-height: 14rem;
		padding: 1rem 1.25rem 0.9rem;
		container-type: inline-size;
		background-image: repeating-linear-gradient(
			0deg,
			transparent 0 27px,
			color-mix(in oklab, var(--stage-muted) 22%, transparent) 27px 28px
		);
	}

	.hero-plate-kind {
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--stage-muted);
	}

	.hero-plate-word {
		overflow: hidden;
		/* As large as fits the plate, never past 7rem; 2.5rem is the floor, then it ellipsizes. */
		font: italic 400 clamp(2.5rem, calc((100cqw - 2.5rem) / var(--em)), 7rem) / 1.05 var(--font-serif);
		letter-spacing: -0.03em;
		white-space: nowrap;
		text-overflow: ellipsis;
		color: var(--stage-ink);
	}

	/* ── Reveal: words, then the rest of the copy, then the media ── */
	@keyframes hero-word {
		from {
			opacity: 0;
			filter: blur(10px);
			transform: translateY(0.35em);
		}
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	@keyframes hero-media {
		from {
			opacity: 0;
			transform: translateY(6%) scale(0.97);
		}
	}

	@keyframes hero-glow {
		from {
			opacity: 0;
		}
	}

	/* Reveal only while the script has confirmed the timeline is running
	   (.hero[data-motion]); without it every element rests visible. */
	.hero[data-motion] .hero-slide[data-active] .hero-word {
		animation: hero-word var(--dur-5) var(--ease-out) both;
		animation-delay: calc(min(var(--i), 14) * 60ms + 120ms);
	}

	.hero[data-motion] .hero-slide[data-active] .hero-eyebrow {
		animation: hero-rise var(--dur-5) var(--ease-out) both;
		animation-delay: 40ms;
	}

	.hero[data-motion] .hero-slide[data-active] .hero-desc {
		animation: hero-rise var(--dur-5) var(--ease-out) both;
		animation-delay: calc(min(var(--n), 14) * 60ms + 260ms);
	}

	.hero[data-motion] .hero-slide[data-active] .hero-cta {
		animation: hero-rise var(--dur-5) var(--ease-out) both;
		animation-delay: calc(min(var(--n), 14) * 60ms + 380ms);
	}

	.hero[data-motion] .hero-slide[data-active] .hero-media {
		animation: hero-media var(--dur-5) var(--ease-out) both;
		animation-delay: 80ms;
	}

	.hero[data-motion] .hero-slide[data-active] .hero-glow {
		animation: hero-glow var(--dur-5) var(--ease-standard) both;
	}

	/* ── Controls ── */
	.hero-controls {
		display: none;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0.9rem;
	}

	.hero[data-ready] .hero-controls {
		display: flex;
	}

	.hero-toggle {
		display: inline-grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
		transition:
			border-color var(--dur-2) var(--ease-standard),
			color var(--dur-2) var(--ease-standard),
			transform var(--dur-1) var(--ease-standard);
	}

	.hero-toggle:hover {
		border-color: var(--ink);
	}

	.hero-toggle:active {
		transform: scale(0.94);
	}

	.hero-icon {
		grid-area: 1 / 1;
	}

	.hero-icon--play,
	.hero:not([data-paused='manual']) .hero-icon--play {
		display: none;
	}

	.hero[data-paused='manual'] .hero-icon--play {
		display: block;
	}

	.hero[data-paused='manual'] .hero-icon--pause {
		display: none;
	}

	/* Reduced motion: nothing autoplays, so there is nothing to pause. */
	.hero[data-reduced] .hero-toggle {
		display: none;
	}

	.hero-dots {
		display: flex;
		align-items: center;
		padding: 0 0.5rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		background: var(--paper-light);
	}

	.hero-dot {
		display: grid;
		place-items: center;
		min-width: 24px;
		height: 38px;
		padding: 0 4px;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.hero-dot-bar {
		position: relative;
		display: block;
		width: 8px;
		height: 8px;
		overflow: hidden;
		border-radius: 999px;
		background: var(--rule-strong);
		transition:
			width var(--dur-3) var(--ease-spring),
			background-color var(--dur-2) var(--ease-standard);
	}

	.hero-dot:hover .hero-dot-bar {
		background: var(--secondary);
	}

	.hero-dot[aria-current='true'] .hero-dot-bar {
		width: 40px;
	}

	.hero-dot-fill {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
	}

	.hero-dot[aria-current='true'] .hero-dot-fill {
		animation: hero-progress var(--hero-interval) linear forwards;
	}

	.hero[data-paused] .hero-dot-fill {
		animation-play-state: paused;
	}

	/* Reduced motion (or nothing left to advance to): the active dot is just filled. */
	.hero[data-reduced] .hero-dot[aria-current='true'] .hero-dot-fill {
		transform: scaleX(1);
	}

	@keyframes hero-progress {
		to {
			transform: scaleX(1);
		}
	}

	/* ── Narrow: media above the copy at 16:9, natural height ── */
	@media (max-width: 799px) {
		.hero-slide {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
			min-height: 0;
			padding: 1.25rem 1.25rem 1.75rem;
		}

		.hero-media {
			order: -1;
			align-self: auto;
			aspect-ratio: 16 / 9;
		}

		.hero-plate {
			min-height: 0;
			padding: 0.75rem 1rem;
		}

		.hero-plate-word {
			font-size: clamp(2.25rem, calc((100cqw - 2rem) / var(--em)), 4.5rem);
		}

		.hero-glow {
			top: 0;
			right: 50%;
			width: 120%;
			transform: translate(50%, -10%);
		}
	}
</style>
