---
import { useTranslations, type UILanguage } from '../i18n/ui';

export interface Props {
  category: string;
}

const { category } = Astro.props;

const lang = (Astro.currentLocale ?? 'ko') as UILanguage;
const t = useTranslations(lang);

const CATEGORY_LABEL_KEYS = {
  ai: 'blog.category-ai',
  devlog: 'blog.category-devlog',
  review: 'blog.category-review',
  misc: 'blog.category-misc',
} as const;

const labelKey = CATEGORY_LABEL_KEYS[category as keyof typeof CATEGORY_LABEL_KEYS];
// Unknown keys fall back to the raw value rather than silently reading as "misc".
const label = labelKey ? t(labelKey) : category;
---

<span class="chip">{label}</span>
