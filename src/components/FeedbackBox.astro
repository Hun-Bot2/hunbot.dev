---
import { useTranslations, type UILanguage } from '../i18n/ui';

interface Props {
	slug: string;
	lang: UILanguage;
}

const { slug, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="feedback-box" data-feedback-box data-feedback-slug={slug} aria-labelledby="feedback-title">
	<h2 id="feedback-title">{t('feedback.title')}</h2>
	<p class="feedback-description">{t('feedback.description')}</p>

	<form class="feedback-form" data-feedback-form>
		<label class="feedback-label" for="feedback-message">{t('feedback.label')}</label>
		<textarea
			id="feedback-message"
			name="message"
			rows="4"
			maxlength="1000"
			required
			placeholder={t('feedback.placeholder')}
			data-feedback-message
		></textarea>
		<div class="feedback-actions">
			<p class="feedback-note">{t('feedback.privacy')}</p>
			<button type="submit" class="feedback-submit" data-feedback-submit>
				{t('feedback.submit')}
			</button>
		</div>
	</form>

	<p class="feedback-status" data-feedback-status role="status" aria-live="polite" hidden></p>

	<template
		data-feedback-messages
		data-success={t('feedback.success')}
		data-error={t('feedback.error')}
		data-rate-limited={t('feedback.rate-limited')}
		data-unavailable={t('feedback.unavailable')}
	></template>
</section>

<style>
	.feedback-box {
		margin-top: 4rem;
		border-top: 1px solid var(--rule-strong);
		padding-top: 2rem;
	}

	.feedback-box h2 {
		margin: 0;
		font: 400 1.5rem / 1.3 var(--font-serif);
	}

	.feedback-description {
		margin: 0.5rem 0 1.25rem;
		color: var(--secondary);
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.feedback-label {
		display: block;
		margin-bottom: 0.4rem;
		font: 400 0.6875rem / 1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.feedback-form textarea {
		width: 100%;
		box-sizing: border-box;
		border: 1px solid var(--rule-strong);
		border-radius: 0;
		background: var(--paper-light);
		padding: 0.7rem 0.8rem;
		color: var(--ink);
		font: inherit;
		font-size: 1rem;
		line-height: 1.6;
		resize: vertical;
	}

	.feedback-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.feedback-note {
		margin: 0;
		color: var(--secondary);
		font-size: 0.8125rem;
	}

	.feedback-submit {
		min-height: 2.5rem;
		padding: 0.4rem 1.1rem;
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		background: transparent;
		font: 400 0.6875rem / 1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink);
		cursor: pointer;
	}

	.feedback-submit:hover:not(:disabled) {
		border-color: var(--ink);
		color: var(--accent);
	}

	.feedback-submit:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.feedback-status {
		margin: 0.75rem 0 0;
		font-size: 0.875rem;
	}

	.feedback-status[data-state='error'] {
		color: var(--state-error);
	}

	.feedback-status[data-state='success'] {
		color: var(--state-success);
	}
</style>
