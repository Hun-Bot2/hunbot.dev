---
import { useTranslations, type UILanguage } from '../i18n/ui';

interface Props {
	slug: string;
	lang: UILanguage;
}

const { slug, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="feedback-box" data-feedback-box data-feedback-slug={slug} aria-labelledby="feedback-title">
	<h2 id="feedback-title">{t('feedback.title')}</h2>
	<p class="feedback-description">{t('feedback.description')}</p>

	<form class="feedback-form" data-feedback-form>
		<label class="feedback-label" for="feedback-message">{t('feedback.label')}</label>
		<textarea
			id="feedback-message"
			name="message"
			rows="4"
			maxlength="1000"
			required
			placeholder={t('feedback.placeholder')}
			data-feedback-message
		></textarea>
		<div class="feedback-actions">
			<p class="feedback-note">{t('feedback.privacy')}</p>
			<button type="submit" class="feedback-submit" data-feedback-submit>
				{t('feedback.submit')}
			</button>
		</div>
	</form>

	<p class="feedback-status" data-feedback-status role="status" aria-live="polite" hidden></p>

	<template
		data-feedback-messages
		data-success={t('feedback.success')}
		data-error={t('feedback.error')}
		data-rate-limited={t('feedback.rate-limited')}
		data-unavailable={t('feedback.unavailable')}
	></template>
</section>

<style>
	.feedback-box {
		margin-top: 2.5rem;
		border: 1px solid var(--surface-border);
		border-radius: 0.85rem;
		background: var(--surface-panel);
		padding: 1.25rem;
	}

	.feedback-box h2 {
		margin: 0;
		color: var(--text-primary);
		font-family: var(--font-heading);
		font-size: 1.05rem;
		font-weight: 800;
	}

	.feedback-description {
		margin: 0.35rem 0 0.9rem;
		color: var(--text-muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.feedback-label {
		display: block;
		margin-bottom: 0.35rem;
		color: var(--text-subtle);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.feedback-form textarea {
		width: 100%;
		box-sizing: border-box;
		border: 1px solid var(--field-border);
		border-radius: 0.6rem;
		background: var(--field-surface);
		padding: 0.65rem 0.75rem;
		color: var(--field-text);
		font: inherit;
		font-size: 0.92rem;
		line-height: 1.55;
		resize: vertical;
	}

	.feedback-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.7rem;
	}

	.feedback-note {
		margin: 0;
		color: var(--text-faint);
		font-size: 0.78rem;
	}

	.feedback-submit {
		min-height: 2.25rem;
		border: 1px solid var(--accent-border);
		border-radius: 999px;
		background: var(--accent-surface);
		padding: 0.4rem 1rem;
		color: var(--accent-text);
		font: inherit;
		font-size: 0.86rem;
		font-weight: 800;
		cursor: pointer;
	}

	.feedback-submit:hover:not(:disabled) {
		/* TODO: needs a hover-state token */
		background: rgba(249, 115, 22, 0.24);
	}

	.feedback-submit:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.feedback-status {
		margin: 0.75rem 0 0;
		font-size: 0.86rem;
		font-weight: 700;
	}

	.feedback-status[data-state='error'] {
		color: var(--state-error);
	}

	.feedback-status[data-state='success'] {
		color: var(--state-success);
	}
</style>
