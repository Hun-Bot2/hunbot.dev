---
import deckViewerUrl from './deck-viewer.js?url';
import {
	getAspectRatioValue,
	isPptxDownloadEnabled,
	type DeckMeta,
} from '../../lib/decks/validateDeckMeta.ts';

export interface Props {
	deck: DeckMeta;
}

const { deck } = Astro.props;
const canDownloadSource = isPptxDownloadEnabled(deck);
const aspectRatio = getAspectRatioValue(deck.aspectRatio);
const slideCount = deck.slides.length;

if (slideCount === 0) {
	throw new Error(`SlideImageDeck requires at least one slide for deck "${deck.id}".`);
}
---

<section class="not-prose presentation-embed" aria-labelledby={`presentation-${deck.id}-title`}>
	<div class="presentation-header">
		<div>
			<p class="presentation-kicker">Presentation</p>
			<h2 id={`presentation-${deck.id}-title`}>{deck.title}</h2>
			<p>{deck.description}</p>
		</div>
		<div class="presentation-actions" aria-label="Presentation file actions">
			{deck.pdfUrl && (
				<a class="presentation-action presentation-action-primary" href={deck.pdfUrl} target="_blank" rel="noopener noreferrer">
					Open PDF
				</a>
			)}
			{canDownloadSource && (
				<a class="presentation-action presentation-action-source" href={deck.pptxUrl} download>
					Download PPTX source
				</a>
			)}
		</div>
	</div>

	<div class="presentation-rotate-hint" role="note">
		This presentation is best viewed in landscape mode.
		{deck.pdfUrl && (
			<a href={deck.pdfUrl} target="_blank" rel="noopener noreferrer">Open PDF</a>
		)}
	</div>

	<div
		class="presentation-slide-deck"
		data-deck-id={deck.id}
		data-title={deck.title}
		data-slides={JSON.stringify(deck.slides)}
		tabindex="0"
		aria-label={`${deck.title} slide viewer`}
		style={`--deck-aspect-ratio: ${aspectRatio};`}
	>
		<div class="presentation-slide-viewport" data-deck-viewport>
			<img
				src={deck.slides[0]}
				alt={`${deck.title} slide 1 of ${slideCount}`}
				loading="eager"
				decoding="async"
				data-deck-image
			/>
		</div>
		<div class="presentation-controls" aria-label="Slide controls">
			<button type="button" class="presentation-control" data-deck-prev aria-label="Show previous slide">
				<span aria-hidden="true">Prev</span>
			</button>
			<span class="presentation-counter" data-deck-counter aria-live="polite">1 / {slideCount}</span>
			<button type="button" class="presentation-control" data-deck-next aria-label="Show next slide">
				<span aria-hidden="true">Next</span>
			</button>
			<button type="button" class="presentation-control presentation-fullscreen" data-deck-fullscreen aria-label="Show presentation fullscreen">
				<span aria-hidden="true">Fullscreen</span>
			</button>
		</div>
	</div>
</section>

<script type="module" src={deckViewerUrl}></script>

<style>
	.presentation-embed {
		margin: 2rem auto;
		width: min(100%, 1120px);
		color: var(--ink);
	}

	.presentation-header {
		display: flex;
		gap: 1rem;
		justify-content: space-between;
		margin-bottom: 0.9rem;
	}

	.presentation-header > div:first-child {
		max-width: 46rem;
	}

	.presentation-kicker {
		margin: 0 0 0.35rem;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.presentation-header h2 {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.25;
	}

	.presentation-header p {
		margin: 0.45rem 0 0;
		color: var(--secondary);
		line-height: 1.55;
	}

	.presentation-actions {
		align-items: flex-start;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		justify-content: flex-end;
	}

	.presentation-action,
	.presentation-control {
		align-items: center;
		border-radius: 0;
		display: inline-flex;
		font-size: 0.85rem;
		font-weight: 700;
		justify-content: center;
		line-height: 1;
		min-height: 2.35rem;
		padding: 0.65rem 0.85rem;
		text-decoration: none;
		transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
		white-space: nowrap;
	}

	.presentation-action-primary {
		background: var(--accent);
		color: var(--paper);
	}

	.presentation-action-primary:hover {
		background: color-mix(in srgb, var(--accent) 80%, var(--ink));
	}

	.presentation-action-source,
	.presentation-control {
		background: transparent;
		border: 1px solid var(--rule-strong);
		color: var(--ink);
		cursor: pointer;
	}

	.presentation-action-source {
		font-weight: 600;
	}

	.presentation-action-source:hover,
	.presentation-control:hover {
		border-color: var(--ink);
		color: var(--ink);
	}

	.presentation-control:disabled {
		cursor: not-allowed;
		opacity: 0.45;
	}

	.presentation-rotate-hint {
		display: none;
		border: 1px solid var(--rule-strong);
		background: var(--paper-deep);
		color: var(--ink);
		font-size: 0.92rem;
		line-height: 1.5;
		margin-bottom: 0.9rem;
		padding: 0.85rem;
	}

	.presentation-rotate-hint a {
		color: var(--accent);
		display: inline-block;
		font-weight: 700;
		margin-left: 0.5rem;
	}

	.presentation-slide-deck {
		outline: none;
	}

	.presentation-slide-deck:focus-visible {
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 45%, transparent);
	}

	.presentation-slide-viewport {
		align-items: center;
		aspect-ratio: var(--deck-aspect-ratio);
		background: var(--stage);
		border: 1px solid var(--rule-strong);
		display: flex;
		justify-content: center;
		overflow: hidden;
		touch-action: pan-y;
		width: 100%;
	}

	.presentation-slide-viewport img {
		display: block;
		height: 100%;
		object-fit: contain;
		width: 100%;
	}

	.presentation-controls {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		justify-content: center;
		margin-top: 0.75rem;
	}

	.presentation-counter {
		color: var(--secondary);
		font-size: 0.9rem;
		font-weight: 700;
		min-width: 4.5rem;
		text-align: center;
	}

	@media (max-width: 720px) {
		.presentation-header {
			display: grid;
		}

		.presentation-actions {
			justify-content: flex-start;
		}
	}

	@media (max-width: 640px) and (orientation: portrait) {
		.presentation-slide-deck {
			display: none;
		}

		.presentation-rotate-hint {
			display: block;
		}

		.presentation-action-source {
			font-size: 0.8rem;
			opacity: 0.75;
		}
	}

	@media (max-height: 520px) and (orientation: landscape) {
		.presentation-embed {
			margin-left: calc(50% - 50vw + 1rem);
			width: calc(100vw - 2rem);
		}

		.presentation-controls {
			margin-top: 0.45rem;
		}
	}
</style>
