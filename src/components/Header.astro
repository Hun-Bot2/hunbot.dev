---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
	/** Languages the current page exists in; omit when every language has the page. */
	availableLangs?: string[];
}

const { availableLangs } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeUrl = `/${lang}/`;
const blogUrl = lang === 'ko' ? '/ko/blog' : `/${lang}/blog`;
const researchUrl = lang === 'ko' ? '/ko/research' : `/${lang}/research`;
const libraryUrl = lang === 'ko' ? '/ko/library' : `/${lang}/library`;
const searchUrl = lang === 'ko' ? '/ko/search' : `/${lang}/search`;
const brandName = SITE_TITLE.replace('-', '\u2014');

// Active section from the first path segment after the language prefix.
// Reviews and learning paths belong to the Research surface.
const section = Astro.url.pathname.split('/').filter(Boolean)[1] ?? '';
const activeSection = section === 'blog'
	? 'blog'
	: ['research', 'reviews', 'paths'].includes(section)
		? 'research'
		: section === 'library'
			? 'library'
			: null;
---

<header class="site-header" data-pagefind-ignore>
	<a class="skip-link" href="#main-content">{t('nav.skip')}</a>
	<div class="header-bar page-frame">
		<a href={homeUrl} class="brand" aria-label={SITE_TITLE}>
			<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
				<path d="M5 25V7M11 25V11M17 25V4M23 25V14M5 20h18" />
				<circle cx="27" cy="7" r="2" />
			</svg>
			<span>{brandName}</span>
		</a>

		<nav class="primary-nav" aria-label="Primary">
			<a href={blogUrl} class:list={{ active: activeSection === 'blog' }} aria-current={activeSection === 'blog' ? 'page' : undefined}>{t('nav.blog')}</a>
			<a href={researchUrl} class:list={{ active: activeSection === 'research' }} aria-current={activeSection === 'research' ? 'page' : undefined}>{t('nav.research')}</a>
			<a href={libraryUrl} class:list={{ active: activeSection === 'library' }} aria-current={activeSection === 'library' ? 'page' : undefined}>{t('nav.library')}</a>
		</nav>

		<div class="header-actions">
			<a href={searchUrl} class="header-action" aria-label={t('nav.search')}>
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<circle cx="10.5" cy="10.5" r="6.5" />
					<path d="m15.5 15.5 5 5" />
				</svg>
				<span class="action-label">{t('nav.search')}</span>
			</a>
			<button
				type="button"
				id="themeToggleBtn"
				class="header-action header-action--text"
				title={t('theme.toggle')}
				aria-label={t('theme.toggle')}
				aria-pressed="false"
			>
				<span class="theme-to-dark">{t('theme.to-dark')}</span>
				<span class="theme-to-light">{t('theme.to-light')}</span>
			</button>
			<LanguagePicker availableLangs={availableLangs} class="header-lang" />
			<button
				type="button"
				class="header-action menu-toggle"
				id="menuToggle"
				aria-controls="mobileMenu"
				aria-label={t('nav.menu')}
				title={t('nav.menu')}
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<line x1="3" y1="7" x2="21" y2="7" />
					<line x1="3" y1="12" x2="21" y2="12" />
					<line x1="3" y1="17" x2="21" y2="17" />
				</svg>
			</button>
		</div>
	</div>

	<div id="mobileMenu" class="mobile-menu hidden">
		<nav class="mobile-nav page-frame" aria-label="Menu">
			<a href={blogUrl} class:list={['mobile-nav-item', { active: activeSection === 'blog' }]} aria-current={activeSection === 'blog' ? 'page' : undefined}>{t('nav.blog')}</a>
			<a href={researchUrl} class:list={['mobile-nav-item', { active: activeSection === 'research' }]} aria-current={activeSection === 'research' ? 'page' : undefined}>{t('nav.research')}</a>
			<a href={libraryUrl} class:list={['mobile-nav-item', { active: activeSection === 'library' }]} aria-current={activeSection === 'library' ? 'page' : undefined}>{t('nav.library')}</a>
			<a href={searchUrl} class="mobile-nav-item">{t('nav.search')}</a>
			<div class="mobile-nav-meta">
				<LanguagePicker availableLangs={availableLangs} class="mobile-lang" />
				<span class="mobile-links">
					<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">&#8599;</span></a>
					<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">&#8599;</span></a>
					<a href="/rss.xml">RSS</a>
				</span>
			</div>
		</nav>
	</div>
</header>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const skipLink = document.querySelector<HTMLAnchorElement>('.skip-link');
		const mainContent = document.getElementById('main-content');

		if (!skipLink || !mainContent) return;

		const focusMainContent = () => {
			if (!mainContent.hasAttribute('tabindex')) {
				mainContent.setAttribute('tabindex', '-1');
			}

			mainContent.scrollIntoView({ block: 'start' });
			skipLink.blur();

			requestAnimationFrame(() => {
				mainContent.focus({ preventScroll: true });
			});
		};

		skipLink.addEventListener('click', (event) => {
			event.preventDefault();
			focusMainContent();
			window.history.replaceState(null, '', '#main-content');
		});

		window.addEventListener('pointerdown', () => {
			if (document.activeElement === skipLink) {
				skipLink.blur();
			}
		});

		window.addEventListener('scroll', () => {
			if (document.activeElement === skipLink) {
				skipLink.blur();
			}
		});
	});
</script>
<script type="module" src="/scripts/header-menu.js"></script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--paper) 95%, transparent);
		border-bottom: 1px solid var(--rule);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.header-bar {
		height: var(--header-height);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		width: max-content;
		min-height: 40px;
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.brand-mark {
		width: 26px;
		height: 26px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.35;
	}

	.brand-mark circle {
		fill: var(--accent);
		stroke: none;
	}

	.primary-nav {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		font-size: 0.875rem;
	}

	.primary-nav a {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		color: var(--ink);
	}

	.primary-nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 100%;
		bottom: 6px;
		height: 1px;
		background: var(--accent);
		transition: right 160ms ease;
	}

	.primary-nav a:hover::after,
	.primary-nav a.active::after {
		right: 0;
	}

	.primary-nav a.active {
		color: var(--accent);
	}

	.header-actions {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 1.1rem;
		font: 400 0.6875rem/1 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.header-action {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		min-height: 40px;
		min-width: 40px;
		justify-content: center;
		padding: 0;
		border: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		cursor: pointer;
	}

	.header-action:hover {
		color: var(--accent);
	}

	.header-action--text span {
		padding: 4px 0;
		border-bottom: 1px solid var(--rule-strong);
	}

	/* The label names the theme a click switches to; html.dark is set before paint. */
	.theme-to-light {
		display: none;
	}

	:global(html.dark) .theme-to-dark {
		display: none;
	}

	:global(html.dark) .theme-to-light {
		display: inline;
	}

	.menu-toggle {
		display: none;
	}

	.mobile-menu {
		display: none;
	}

	.mobile-menu.hidden {
		display: none;
	}

	@media (max-width: 1099px) {
		.header-bar {
			grid-template-columns: 1fr auto;
		}

		.primary-nav {
			display: none;
		}

		.menu-toggle {
			display: inline-flex;
		}

		.mobile-menu {
			display: block;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--paper);
			border-bottom: 1px solid var(--rule);
		}

		.mobile-menu.hidden {
			display: none;
		}
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
		padding: 0.5rem 0 1.25rem;
	}

	.mobile-nav-item {
		display: flex;
		align-items: center;
		min-height: 48px;
		border-bottom: 1px solid var(--rule);
		font-size: 1rem;
		color: var(--ink);
	}

	.mobile-nav-item.active {
		color: var(--accent);
	}

	.mobile-nav-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-top: 0.75rem;
		font: 400 0.6875rem/1 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.mobile-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
	}

	.mobile-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		min-height: 40px;
		color: var(--secondary);
	}

	.mobile-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 539px) {
		.header-bar {
			height: 62px;
			gap: 0.5rem;
		}

		.header-actions {
			gap: 0.35rem;
		}

		.action-label,
		.header-actions :global(.header-lang) {
			display: none;
		}
	}

	.mobile-nav-meta :global(.mobile-lang) {
		margin-left: -0.4rem;
	}

	/* The header already shows the language links from 540px up. */
	@media (min-width: 540px) {
		.mobile-nav-meta :global(.mobile-lang) {
			display: none;
		}
	}

	.hidden {
		display: none;
	}
</style>
