---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeUrl = `/${lang}/`;
const blogUrl = lang === 'ko' ? '/ko/blog' : `/${lang}/blog`;
const researchUrl = lang === 'ko' ? '/ko/research' : `/${lang}/research`;
const libraryUrl = lang === 'ko' ? '/ko/library' : `/${lang}/library`;
const exploreUrl = `/${lang}/explore/`;
const searchUrl = lang === 'ko' ? '/ko/search' : `/${lang}/search`;
const brandName = SITE_TITLE.replace('-', '\u2014');

// Active section from the first path segment after the language prefix.
// Reviews and learning paths belong to the Research surface.
const section = Astro.url.pathname.split('/').filter(Boolean)[1] ?? '';
const activeSection = section === 'blog'
	? 'blog'
	: ['research', 'reviews', 'paths'].includes(section)
		? 'research'
		: section === 'library'
			? 'library'
			: section === 'explore'
				? 'explore'
				: null;
---

<header class="site-header" data-pagefind-ignore>
	<a class="skip-link" href="#main-content">{t('nav.skip')}</a>
	<div class="header-bar page-frame">
		<a href={homeUrl} class="brand" aria-label={SITE_TITLE}>
			<span>{brandName}</span>
		</a>

		<nav class="primary-nav" aria-label="Primary">
			<a href={blogUrl} class:list={{ active: activeSection === 'blog' }} aria-current={activeSection === 'blog' ? 'page' : undefined}>{t('nav.blog')}</a>
			<a href={researchUrl} class:list={{ active: activeSection === 'research' }} aria-current={activeSection === 'research' ? 'page' : undefined}>{t('nav.research')}</a>
			<a href={libraryUrl} class:list={{ active: activeSection === 'library' }} aria-current={activeSection === 'library' ? 'page' : undefined}>{t('nav.library')}</a>
			<a href={exploreUrl} class:list={{ active: activeSection === 'explore' }} aria-current={activeSection === 'explore' ? 'page' : undefined}>{t('nav.explore')}</a>
		</nav>

		<div class="header-actions">
			<a href={searchUrl} class="header-action" aria-label={t('nav.search')}>
				<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<circle cx="10.5" cy="10.5" r="6.5" />
					<path d="m15.5 15.5 5 5" />
				</svg>
				<span class="action-label">{t('nav.search')}</span>
			</a>
			<button
				type="button"
				id="themeToggleBtn"
				class="header-action header-action--text"
				title={t('theme.toggle')}
				aria-label={t('theme.toggle')}
				aria-pressed="false"
			>
				<span class="theme-to-dark">{t('theme.to-dark')}</span>
				<span class="theme-to-light">{t('theme.to-light')}</span>
			</button>
			<a href={SOCIAL_LINKS.github} class="header-action header-icon" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
				<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
				</svg>
			</a>
			<a href={SOCIAL_LINKS.linkedin} class="header-action header-icon" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z" />
				</svg>
			</a>
			<button
				type="button"
				class="header-action menu-toggle"
				id="menuToggle"
				aria-controls="mobileMenu"
				aria-label={t('nav.menu')}
				title={t('nav.menu')}
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<line x1="3" y1="7" x2="21" y2="7" />
					<line x1="3" y1="12" x2="21" y2="12" />
					<line x1="3" y1="17" x2="21" y2="17" />
				</svg>
			</button>
		</div>
	</div>

	<div id="mobileMenu" class="mobile-menu hidden">
		<nav class="mobile-nav page-frame" aria-label="Menu">
			<a href={blogUrl} class:list={['mobile-nav-item', { active: activeSection === 'blog' }]} aria-current={activeSection === 'blog' ? 'page' : undefined}>{t('nav.blog')}</a>
			<a href={researchUrl} class:list={['mobile-nav-item', { active: activeSection === 'research' }]} aria-current={activeSection === 'research' ? 'page' : undefined}>{t('nav.research')}</a>
			<a href={libraryUrl} class:list={['mobile-nav-item', { active: activeSection === 'library' }]} aria-current={activeSection === 'library' ? 'page' : undefined}>{t('nav.library')}</a>
			<a href={exploreUrl} class:list={['mobile-nav-item', { active: activeSection === 'explore' }]} aria-current={activeSection === 'explore' ? 'page' : undefined}>{t('nav.explore')}</a>
			<a href={searchUrl} class="mobile-nav-item">{t('nav.search')}</a>
			<div class="mobile-nav-meta">
				<span class="mobile-links">
					<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
					<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<a href="/rss.xml">RSS</a>
				</span>
			</div>
		</nav>
	</div>
</header>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const skipLink = document.querySelector<HTMLAnchorElement>('.skip-link');
		const mainContent = document.getElementById('main-content');

		if (!skipLink || !mainContent) return;

		const focusMainContent = () => {
			if (!mainContent.hasAttribute('tabindex')) {
				mainContent.setAttribute('tabindex', '-1');
			}

			mainContent.scrollIntoView({ block: 'start' });
			skipLink.blur();

			requestAnimationFrame(() => {
				mainContent.focus({ preventScroll: true });
			});
		};

		skipLink.addEventListener('click', (event) => {
			event.preventDefault();
			focusMainContent();
			window.history.replaceState(null, '', '#main-content');
		});

		window.addEventListener('pointerdown', () => {
			if (document.activeElement === skipLink) {
				skipLink.blur();
			}
		});

		window.addEventListener('scroll', () => {
			if (document.activeElement === skipLink) {
				skipLink.blur();
			}
		});
	});
</script>
<script type="module" src="/scripts/header-menu.js"></script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--paper) 95%, transparent);
		border-bottom: 1px solid var(--rule);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.header-bar {
		height: var(--header-height);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
	}

	.brand {
		display: flex;
		align-items: center;
		width: max-content;
		min-height: 40px;
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.primary-nav {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		font-size: 0.875rem;
	}

	.primary-nav a {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		color: var(--ink);
	}

	.primary-nav a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 100%;
		bottom: 6px;
		height: 1px;
		background: var(--accent);
		transition: right 160ms ease;
	}

	.primary-nav a:hover::after,
	.primary-nav a.active::after {
		right: 0;
	}

	.primary-nav a.active {
		color: var(--accent);
	}

	.header-actions {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 0.5rem;
		font: 400 0.6875rem/1 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.header-action {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		min-height: 40px;
		min-width: 40px;
		justify-content: center;
		padding: 0 0.35rem;
		line-height: 1;
		border: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		cursor: pointer;
	}

	.header-action:hover {
		color: var(--accent);
	}

	/* Text actions (search, theme) share one line box with the icons so every
	   item centres on the same axis; no per-item underline or padding. */
	.header-action--text span {
		line-height: 1;
	}

	/* The label names the theme a click switches to; html.dark is set before paint. */
	.theme-to-light {
		display: none;
	}

	:global(html.dark) .theme-to-dark {
		display: none;
	}

	:global(html.dark) .theme-to-light {
		display: inline;
	}

	.menu-toggle {
		display: none;
	}

	.mobile-menu {
		display: none;
	}

	.mobile-menu.hidden {
		display: none;
	}

	@media (max-width: 1099px) {
		.header-bar {
			grid-template-columns: 1fr auto;
		}

		.primary-nav {
			display: none;
		}

		.menu-toggle {
			display: inline-flex;
		}

		.mobile-menu {
			display: block;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--paper);
			border-bottom: 1px solid var(--rule);
		}

		.mobile-menu.hidden {
			display: none;
		}
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
		padding: 0.5rem 0 1.25rem;
	}

	.mobile-nav-item {
		display: flex;
		align-items: center;
		min-height: 48px;
		border-bottom: 1px solid var(--rule);
		font-size: 1rem;
		color: var(--ink);
	}

	.mobile-nav-item.active {
		color: var(--accent);
	}

	.mobile-nav-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		padding-top: 0.75rem;
		font: 400 0.6875rem/1 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.mobile-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
	}

	.mobile-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		min-height: 40px;
		color: var(--secondary);
	}

	.mobile-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 539px) {
		.header-bar {
			height: 62px;
			gap: 0.5rem;
		}

		.header-actions {
			gap: 0.35rem;
		}

		.action-label,
		.header-icon {
			display: none;
		}
	}

	.hidden {
		display: none;
	}
</style>
