---
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  href: string;
  class?: string;
}
const { href, class: className } = Astro.props as Props;

const currentLocale = Astro.currentLocale || 'ko';
const isExternal = /^(https?:)?\/\//.test(href) || href.startsWith('mailto:') || href.startsWith('tel:');
const legacyRouteAliases: Array<[RegExp, string]> = [
  [/^blog\/tech\/chat\//, 'blog/technical_note/chat/'],
];

let localizedHref = href;

if (!isExternal) {
  // Normalize internal paths so old hardcoded locale links also work.
  // Keep `#section` / `?query` out of the route: getRelativeLocaleUrl would append its trailing slash after them.
  const suffixAt = href.search(/[?#]/);
  const suffix = suffixAt === -1 ? '' : href.slice(suffixAt);
  const path = suffixAt === -1 ? href : href.slice(0, suffixAt);
  const withoutLocalePrefix = path.replace(/^\/(ko|jp|en)(?=\/|$)/, '');
  let route = withoutLocalePrefix.replace(/^\/+/, '');
  for (const [pattern, replacement] of legacyRouteAliases) {
    route = route.replace(pattern, replacement);
  }
  
  localizedHref = getRelativeLocaleUrl(currentLocale, route) + suffix;
}
if (currentLocale === 'ko' && localizedHref.startsWith('/blog/') && !localizedHref.startsWith('/ko/')) {
  localizedHref = `/ko${localizedHref}`;
}
---

<a href={localizedHref} class={className}>
  <u>*<slot />*</u>
</a>

<style>
  a {
    text-decoration: none;
    color: inherit;
  }
</style>
