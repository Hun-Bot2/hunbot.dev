---
import type { CollectionEntry } from 'astro:content';
import CategoryBadge from '../CategoryBadge.astro';
import TagList from '../TagList.astro';
import PostThumb from './PostThumb.astro';
import { getBlogUrlFromId } from '../../utils/blog-routing';
import { normalizeCategory } from '../../utils/blog';
import { formatPostDate } from '../../utils/display';
import '../../styles/lists.css';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const postUrl = getBlogUrlFromId(post.id);
const category = normalizeCategory(post.data.category);
const tags = post.data.tags ?? [];
---

<a href={postUrl} class="writing-entry">
	<time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
	<PostThumb post={post} />
	<div class="writing-entry-copy">
		<h2>{post.data.title}</h2>
		{post.data.description && <p>{post.data.description}</p>}
		<div class="writing-entry-meta">
			<CategoryBadge category={category} />
			{tags.length > 0 && <TagList tags={tags} maxTags={2} />}
		</div>
	</div>
</a>
