---
import { useTranslations, type UILanguage } from '../../i18n/ui';

interface FacetOption {
	value: string;
	label: string;
	count: number;
}

interface Props {
	lang: UILanguage;
	categories: FacetOption[];
	years: FacetOption[];
	series: FacetOption[];
	totalCount: number;
}

const { lang, categories, years, series, totalCount } = Astro.props;
const t = useTranslations(lang);

const groups = [
	{ facet: 'category', label: t('blog.filter-category'), options: categories },
	{ facet: 'year', label: t('blog.filter-year'), options: years },
	{ facet: 'series', label: t('blog.filter-series'), options: series },
].filter((group) => group.options.length > 0);

const resultsTemplate = t('blog.filter-results');
const initialResults = resultsTemplate.replace('{count}', String(totalCount));
---

<section class="blog-filter-bar" aria-label={t('blog.filter-label')} data-blog-filters>
	{groups.map((group) => (
		<div class="blog-filter-group" role="group" aria-label={group.label}>
			<h2 class="blog-filter-group-label">{group.label}</h2>
			<div class="blog-filter-chips">
				<button
					type="button"
					class="blog-filter-chip is-active"
					data-facet={group.facet}
					data-value="all"
					aria-pressed="true"
				>
					{t('blog.filter-all')}
				</button>
				{group.options.map((option) => (
					<button
						type="button"
						class="blog-filter-chip"
						data-facet={group.facet}
						data-value={option.value}
						aria-pressed="false"
					>
						<span class="blog-filter-chip-label">{option.label}</span>
						<span class="blog-filter-chip-count">{option.count}</span>
					</button>
				))}
			</div>
		</div>
	))}

	<div class="blog-filter-status">
		<p data-filter-results data-results-template={resultsTemplate} aria-live="polite">{initialResults}</p>
		<button type="button" class="blog-filter-reset" data-filter-reset hidden>
			{t('blog.filter-reset')}
		</button>
	</div>
</section>

<style>
	.blog-filter-bar {
		display: grid;
		gap: 0.9rem;
		margin-bottom: 1.75rem;
		border: 1px solid rgba(248, 249, 250, 0.12);
		border-radius: 0.85rem;
		background: rgba(255, 255, 255, 0.045);
		padding: 1rem;
	}

	.blog-filter-group {
		display: grid;
		gap: 0.45rem;
	}

	.blog-filter-group-label {
		margin: 0;
		color: rgba(203, 213, 225, 0.72);
		font-family: var(--font-heading);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.blog-filter-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	/* Matches the established chip pattern in [lang]/search.astro. */
	.blog-filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.25rem;
		border: 1px solid rgba(148, 163, 184, 0.35);
		border-radius: 999px;
		background: rgba(15, 23, 42, 0.55);
		padding: 0.4rem 0.85rem;
		color: rgb(203, 213, 225);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 700;
		cursor: pointer;
		transition:
			background 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
	}

	.blog-filter-chip:hover,
	.blog-filter-chip.is-active {
		border-color: rgba(249, 115, 22, 0.58);
		background: rgba(249, 115, 22, 0.14);
		color: rgb(255, 237, 213);
	}

	.blog-filter-chip-count {
		border-radius: 999px;
		background: rgba(148, 163, 184, 0.18);
		padding: 0.05rem 0.4rem;
		font-size: 0.75rem;
		font-weight: 800;
	}

	.blog-filter-chip.is-active .blog-filter-chip-count {
		background: rgba(249, 115, 22, 0.24);
	}

	.blog-filter-status {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		border-top: 1px solid rgba(248, 249, 250, 0.1);
		padding-top: 0.75rem;
	}

	.blog-filter-status p {
		margin: 0;
		color: rgba(203, 213, 225, 0.82);
		font-size: 0.86rem;
		font-weight: 700;
	}

	.blog-filter-reset {
		min-height: 2.25rem;
		border: 1px solid rgba(148, 163, 184, 0.35);
		border-radius: 999px;
		background: transparent;
		padding: 0.35rem 0.8rem;
		color: rgba(203, 213, 225, 0.9);
		font: inherit;
		font-size: 0.82rem;
		font-weight: 700;
		cursor: pointer;
	}

	.blog-filter-reset:hover {
		border-color: rgba(249, 115, 22, 0.58);
		color: rgb(255, 237, 213);
	}

	:global(body.light-theme) .blog-filter-bar {
		border-color: rgba(15, 23, 42, 0.12);
		background: rgba(255, 255, 255, 0.78);
	}

	:global(body.light-theme) .blog-filter-group-label,
	:global(body.light-theme) .blog-filter-status p {
		color: rgba(51, 65, 85, 0.86);
	}

	:global(body.light-theme) .blog-filter-chip,
	:global(body.light-theme) .blog-filter-reset {
		border-color: rgb(203, 213, 225);
		background: rgb(255, 255, 255);
		color: rgb(51, 65, 85);
	}

	:global(body.light-theme) .blog-filter-chip:hover,
	:global(body.light-theme) .blog-filter-chip.is-active,
	:global(body.light-theme) .blog-filter-reset:hover {
		border-color: rgba(194, 65, 12, 0.28);
		background: rgba(249, 115, 22, 0.1);
		color: rgb(154, 52, 18);
	}
</style>
