---
import { useTranslations, type UILanguage } from '../../i18n/ui';

interface FacetOption {
	value: string;
	label: string;
	count: number;
}

interface Props {
	lang: UILanguage;
	categories: FacetOption[];
	years: FacetOption[];
	series: FacetOption[];
	totalCount: number;
}

const { lang, categories, years, series, totalCount } = Astro.props;
const t = useTranslations(lang);

const groups = [
	{ facet: 'category', label: t('blog.filter-category'), options: categories },
	{ facet: 'year',     label: t('blog.filter-year'),     options: years      },
	{ facet: 'series',   label: t('blog.filter-series'),   options: series     },
].filter((group) => group.options.length > 0);

const resultsTemplate = t('blog.filter-results');
const initialResults = resultsTemplate.replace('{count}', String(totalCount));
---

<section class="blog-filter-bar page-frame" aria-label={t('blog.filter-label')} data-blog-filters>
	{groups.map((group) => (
		<div class="filter-group">
			<span class="filter-group-label">{group.label}</span>
			<div class="filter-options" role="group" aria-label={group.label}>
				<button
					type="button"
					class="filter-option is-active"
					data-facet={group.facet}
					data-value="all"
					aria-pressed="true"
				>
					{t('blog.filter-all')}
				</button>
				{group.options.map((option) => (
					<button
						type="button"
						class="filter-option"
						data-facet={group.facet}
						data-value={option.value}
						aria-pressed="false"
					>
						{option.label}
						<span class="filter-option-count">{option.count}</span>
					</button>
				))}
			</div>
		</div>
	))}

	<div class="filter-status">
		<p data-filter-results data-results-template={resultsTemplate} aria-live="polite">{initialResults}</p>
		<button type="button" class="filter-reset btn-text" data-filter-reset hidden>
			{t('blog.filter-reset')}
		</button>
	</div>
</section>

<style>
	.blog-filter-bar {
		padding: 0.75rem 0 0.25rem;
	}

	.filter-group {
		display: grid;
		grid-template-columns: 6rem minmax(0, 1fr);
		align-items: center;
		gap: 0.25rem 1rem;
	}

	.filter-group-label,
	.filter-status p {
		margin: 0;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.filter-options {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.35rem;
	}

	/* Underlined mono tabs; the active one reads in accent. */
	.filter-option {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.5rem;
		position: relative;
		padding: 0;
		border: 0;
		background: none;
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--secondary);
		cursor: pointer;
		transition: color 160ms ease;
	}

	.filter-option:hover {
		color: var(--ink);
	}

	/* The underline sits under the text, not at the foot of the 40px touch target. */
	.filter-option::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.6rem;
		height: 1px;
		background: transparent;
	}

	.filter-option.is-active {
		color: var(--accent);
	}

	.filter-option.is-active::after {
		background: var(--accent);
	}

	.filter-option-count {
		opacity: 0.8;
	}

	.filter-status {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 2.5rem;
	}

	.filter-reset {
		min-height: 2.5rem;
		color: var(--accent);
		border-bottom-color: transparent;
		cursor: pointer;
	}

	@media (max-width: 639px) {
		.filter-group {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}

		.filter-group + .filter-group {
			margin-top: 0.5rem;
		}

		/* One scrollable line per facet instead of a tall wrapped block. */
		.filter-options {
			flex-wrap: nowrap;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.filter-options::-webkit-scrollbar {
			display: none;
		}
	}
</style>
