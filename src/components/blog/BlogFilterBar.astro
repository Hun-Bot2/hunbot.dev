---
import { useTranslations, type UILanguage } from '../../i18n/ui';

interface FacetOption {
	value: string;
	label: string;
	count: number;
	/** Only shown while this other facet is 'all' or set to this value (e.g. a topic under an area). */
	parent?: { facet: string; value: string };
}

interface FacetGroup {
	facet: string;
	label: string;
	options: FacetOption[];
}

// The blog passes categories/years/series; another list (the Library) passes
// its own `groups`, a `storageKey` so its choice is remembered separately, and
// its own result-count copy. public/scripts/blog-filters.js reads the facet
// names from `data-facets`, so items carry `data-post-<facet>` either way.
interface Props {
	lang: UILanguage;
	categories?: FacetOption[];
	years?: FacetOption[];
	series?: FacetOption[];
	groups?: FacetGroup[];
	storageKey?: string;
	resultsTemplate?: string;
	label?: string;
	totalCount: number;
}

const { lang, categories = [], years = [], series = [], totalCount } = Astro.props;
const t = useTranslations(lang);

const groups = (
	Astro.props.groups ?? [
		{ facet: 'category', label: t('blog.filter-category'), options: categories },
		{ facet: 'year',     label: t('blog.filter-year'),     options: years      },
		{ facet: 'series',   label: t('blog.filter-series'),   options: series     },
	]
).filter((group) => group.options.length > 0);

const facets = (Astro.props.groups ?? [{ facet: 'category' }, { facet: 'year' }, { facet: 'series' }]).map((group) => group.facet).join(',');
const storageKey = Astro.props.storageKey ?? 'neural-blog-filters';
const resultsTemplate = Astro.props.resultsTemplate ?? t('blog.filter-results');
const label = Astro.props.label ?? t('blog.filter-label');
const initialResults = resultsTemplate.replace('{count}', String(totalCount));
---

<div class="blog-filter-float" id="blog-filter-float" data-filter-float>
<button
	type="button"
	id="blog-filter-trigger"
	class="btn-pill blog-filter-trigger"
	aria-expanded="false"
	aria-controls="blog-filter-panel"
	aria-label={label}
>
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
		<path d="M4 6h16M7 12h10M10 18h4" />
	</svg>
	<span>{t('blog.filter-toggle')}</span>
	<span class="blog-filter-badge" data-filter-count hidden>0</span>
</button>

<section
	id="blog-filter-panel"
	class="blog-filter-bar"
	aria-label={label}
	data-blog-filters
	data-facets={facets}
	data-storage-key={storageKey}
>
	{groups.map((group) => (
		<div class="filter-group">
			<span class="filter-group-label">{group.label}</span>
			<div class="filter-options" role="group" aria-label={group.label}>
				<button
					type="button"
					class="filter-option is-active"
					data-facet={group.facet}
					data-value="all"
					aria-pressed="true"
				>
					{t('blog.filter-all')}
				</button>
				{group.options.map((option) => (
					<button
						type="button"
						class="filter-option"
						data-facet={group.facet}
						data-value={option.value}
						data-parent-facet={option.parent?.facet}
						data-parent-value={option.parent?.value}
						aria-pressed="false"
					>
						{option.label}
						<span class="filter-option-count">{option.count}</span>
					</button>
				))}
			</div>
		</div>
	))}

	<div class="filter-status">
		<p data-filter-results data-results-template={resultsTemplate} aria-live="polite">{initialResults}</p>
		<button type="button" class="filter-reset btn-text" data-filter-reset hidden>
			{t('blog.filter-reset')}
		</button>
	</div>
</section>
</div>

<style>
	/* Floating, draggable control on the left edge (src/utils/floating.ts); the
	   page column no longer reserves any space for it. */
	.blog-filter-float {
		position: fixed;
		top: calc(var(--header-height) + 12px);
		left: 1rem;
		z-index: 90;
	}

	.blog-filter-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 36px;
		background: var(--paper);
		cursor: grab;
		user-select: none;
		-webkit-user-select: none;
	}

	.blog-filter-float.is-dragging .blog-filter-trigger {
		cursor: grabbing;
	}

	.blog-filter-trigger[aria-expanded='true'] {
		border-color: var(--ink);
	}

	.blog-filter-badge {
		min-width: 1.15rem;
		padding: 0.1rem 0.3rem;
		background: var(--accent);
		color: var(--paper);
		font: 400 0.625rem/1.2 var(--font-mono);
		text-align: center;
	}

	.blog-filter-badge[hidden] {
		display: none;
	}

	/* Placed beside the trigger by placePopover(); scrolls inside itself. */
	.blog-filter-bar {
		display: none;
		position: fixed;
		z-index: 95;
		width: min(22rem, calc(100vw - 1.5rem));
		max-height: min(70vh, 32rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.5rem 1rem 0.25rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper);
	}

	.blog-filter-bar.is-open {
		display: block;
	}

	.filter-group {
		padding: 0.5rem 0;
	}

	.filter-group + .filter-group {
		border-top: 1px solid var(--rule);
	}

	.filter-group-label,
	.filter-status p {
		margin: 0;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.filter-options {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.1rem;
	}

	/* Underlined mono tabs; the active one reads in accent. */
	.filter-option {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.25rem;
		position: relative;
		padding: 0;
		border: 0;
		background: none;
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--secondary);
		cursor: pointer;
		transition: color 160ms ease;
	}

	.filter-option:hover {
		color: var(--ink);
	}

	/* The underline sits under the text, not at the foot of the touch target. */
	.filter-option::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.5rem;
		height: 1px;
		background: transparent;
	}

	.filter-option[hidden] {
		display: none;
	}

	.filter-option.is-active {
		color: var(--accent);
	}

	.filter-option.is-active::after {
		background: var(--accent);
	}

	.filter-option-count {
		opacity: 0.8;
	}

	.filter-status {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 2.5rem;
		border-top: 1px solid var(--rule);
	}

	.filter-reset {
		min-height: 2.5rem;
		color: var(--accent);
		border-bottom-color: transparent;
		cursor: pointer;
	}

	/* Phones: a small button at the bottom-left; the panel becomes a bottom sheet. */
	@media (max-width: 639px) {
		.blog-filter-float {
			top: auto;
			bottom: 0.75rem;
			left: 0.75rem;
		}

		.blog-filter-bar {
			left: 0;
			right: 0;
			bottom: 0;
			top: auto;
			width: auto;
			max-height: 70vh;
			border-width: 1px 0 0;
			padding-bottom: env(safe-area-inset-bottom, 0);
		}
	}
</style>

<script>
	import { clearPopoverPlacement, makeDraggable, placePopover } from '../../utils/floating';

	const float = document.getElementById('blog-filter-float');
	const trigger = document.getElementById('blog-filter-trigger');
	const panel = document.getElementById('blog-filter-panel');

	if (float && trigger && panel) {
		const isSheet = () => window.matchMedia('(max-width: 639px)').matches;
		const isOpen = () => panel.classList.contains('is-open');

		const place = () => {
			if (!isOpen()) return;
			if (isSheet()) clearPopoverPlacement(panel);
			else placePopover(trigger, panel);
		};

		const drag = makeDraggable(float, { storageKey: 'hunbot-float-filter', onMove: place });

		const setOpen = (open: boolean) => {
			panel.classList.toggle('is-open', open);
			trigger.setAttribute('aria-expanded', String(open));
			if (open) place();
			else clearPopoverPlacement(panel);
		};

		trigger.addEventListener('click', (event) => {
			event.stopPropagation();
			if (drag.wasDragged()) return;
			setOpen(!isOpen());
		});

		document.addEventListener('click', (event) => {
			const target = event.target as Node;
			if (isOpen() && !panel.contains(target) && !trigger.contains(target)) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) {
				setOpen(false);
				trigger.focus();
			}
		});

		window.addEventListener('resize', place);
	}
</script>
