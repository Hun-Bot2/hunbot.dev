---
import { useTranslations, type UILanguage } from '../../i18n/ui';

interface FacetOption {
	value: string;
	label: string;
	count: number;
	/** Only shown while this other facet is 'all' or set to this value (e.g. a topic under an area). */
	parent?: { facet: string; value: string };
}

interface FacetGroup {
	facet: string;
	label: string;
	options: FacetOption[];
}

// The blog passes categories/years/series; another list (the Library) passes
// its own `groups`, a `storageKey` so its choice is remembered separately, and
// its own result-count copy. public/scripts/blog-filters.js reads the facet
// names from `data-facets`, so items carry `data-post-<facet>` either way.
interface Props {
	lang: UILanguage;
	categories?: FacetOption[];
	years?: FacetOption[];
	series?: FacetOption[];
	groups?: FacetGroup[];
	storageKey?: string;
	resultsTemplate?: string;
	label?: string;
	/** Facets that still filter but are shown elsewhere (the tab rows), not in this panel. */
	hiddenFacets?: string[];
	totalCount: number;
}

const { lang, categories = [], years = [], series = [], hiddenFacets = [], totalCount } = Astro.props;
const t = useTranslations(lang);

const groups = (
	Astro.props.groups ?? [
		{ facet: 'category', label: t('blog.filter-category'), options: categories },
		{ facet: 'year',     label: t('blog.filter-year'),     options: years      },
		{ facet: 'series',   label: t('blog.filter-series'),   options: series     },
	]
).filter((group) => group.options.length > 0 && !hiddenFacets.includes(group.facet));

const facets = (Astro.props.groups ?? [{ facet: 'category' }, { facet: 'year' }, { facet: 'series' }]).map((group) => group.facet).join(',');
const storageKey = Astro.props.storageKey ?? 'neural-blog-filters';
const resultsTemplate = Astro.props.resultsTemplate ?? t('blog.filter-results');
const label = Astro.props.label ?? t('blog.filter-label');
const initialResults = resultsTemplate.replace('{count}', String(totalCount));
---

<div class="blog-filter-float" id="blog-filter-float" data-filter-float>
<button
	type="button"
	id="blog-filter-trigger"
	class="btn-pill blog-filter-trigger"
	aria-expanded="false"
	aria-controls="blog-filter-panel"
	aria-label={label}
>
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
		<path d="M4 6h16M7 12h10M10 18h4" />
	</svg>
	<span>{t('blog.filter-toggle')}</span>
	<span class="blog-filter-badge" data-filter-count hidden>0</span>
</button>
<button type="button" class="blog-filter-clear" data-filter-clear hidden aria-label={t('blog.filter-reset')} title={t('blog.filter-reset')}>
	<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
</button>

<section
	id="blog-filter-panel"
	class="blog-filter-bar"
	aria-label={label}
	data-blog-filters
	data-facets={facets}
	data-storage-key={storageKey}
>
	{groups.map((group) => {
		const maxCount = Math.max(1, ...group.options.map((option) => option.count));
		return (
		<div class="filter-group">
			<span class="filter-group-label">{group.label}</span>
			<div class="filter-options" role="group" aria-label={group.label}>
				<button
					type="button"
					class="filter-option is-active"
					data-facet={group.facet}
					data-value="all"
					aria-pressed="true"
				>
					{t('blog.filter-all')}
				</button>
				{group.options.map((option) => (
					<button
						type="button"
						class="filter-option"
						data-facet={group.facet}
						data-value={option.value}
						data-parent-facet={option.parent?.facet}
						data-parent-value={option.parent?.value}
						style={`--share: ${(option.count / maxCount).toFixed(3)}`}
						aria-pressed="false"
					>
						{option.label}
						<span class="filter-option-count">{option.count}</span>
					</button>
				))}
			</div>
		</div>
		);
	})}

	<div class="filter-status">
		<p data-filter-results data-results-template={resultsTemplate} aria-live="polite">{initialResults}</p>
		<button type="button" class="filter-reset btn-text" data-filter-reset hidden>
			{t('blog.filter-reset')}
		</button>
	</div>
</section>
</div>

<style>
	/* Floating, draggable control on the left edge (src/utils/floating.ts); the
	   page column no longer reserves any space for it. */
	.blog-filter-float {
		position: fixed;
		top: calc(var(--header-height) + 12px);
		left: var(--float-inset);
		z-index: 90;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.blog-filter-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 36px;
		/* Accent outline + label so it stands out from the paper background. */
		background: var(--paper);
		border-color: var(--accent);
		color: var(--accent);
		box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
		cursor: pointer;
		user-select: none;
		-webkit-user-select: none;
		transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
	}

	.blog-filter-float.is-dragging .blog-filter-trigger {
		cursor: grabbing;
	}

	/* A filter is active while the panel is closed: a quiet accent tint. */
	.blog-filter-trigger.is-filtered {
		background: color-mix(in srgb, var(--accent) 12%, var(--paper));
	}

	.blog-filter-trigger:hover,
	.blog-filter-trigger[aria-expanded='true'] {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--paper);
		box-shadow: 0 3px 12px rgb(0 0 0 / 0.18);
	}

	.blog-filter-trigger:focus-visible,
	.blog-filter-clear:focus-visible,
	.filter-option:focus-visible,
	.filter-reset:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	.blog-filter-trigger:hover .blog-filter-badge,
	.blog-filter-trigger[aria-expanded='true'] .blog-filter-badge {
		background: var(--paper);
		color: var(--accent);
	}

	/* Clears every filter in one click, without opening the panel. */
	.blog-filter-clear {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		background: var(--paper);
		color: var(--secondary);
		box-shadow: 0 2px 10px rgb(0 0 0 / 0.12);
		cursor: pointer;
		transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
	}

	.blog-filter-clear[hidden] {
		display: none;
	}

	.blog-filter-clear:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--paper);
	}

	.blog-filter-badge {
		min-width: 1.15rem;
		padding: 0.1rem 0.3rem;
		background: var(--accent);
		color: var(--paper);
		font: 400 0.625rem/1.2 var(--font-mono);
		text-align: center;
	}

	.blog-filter-badge[hidden] {
		display: none;
	}

	/* Placed beside the trigger by placePopover(); scrolls inside itself. */
	.blog-filter-bar {
		display: block;
		position: fixed;
		z-index: 95;
		width: min(18rem, calc(100vw - 1.5rem));
		max-height: min(80vh, 40rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.5rem 1rem 0.25rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper);
		/* Closed: out of sight and out of the tab order; open: 200ms fade + slide. */
		visibility: hidden;
		opacity: 0;
		transform: translateY(-6px);
		pointer-events: none;
		transition: opacity 200ms ease, transform 200ms ease, visibility 0s linear 200ms;
	}

	.blog-filter-bar.is-open {
		visibility: visible;
		opacity: 1;
		transform: none;
		pointer-events: auto;
		transition-delay: 0s;
	}

	.filter-group {
		padding: 0.5rem 0;
	}

	.filter-group + .filter-group {
		border-top: 1px solid var(--rule);
	}

	.filter-group-label,
	.filter-status p {
		margin: 0;
		font: 500 0.75rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.filter-options {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.1rem;
	}

	/* Underlined mono tabs; the active one reads in accent. */
	.filter-option {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.25rem;
		position: relative;
		padding: 0;
		border: 0;
		background: none;
		font: 500 0.75rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--ink);
		cursor: pointer;
		transition: color 120ms ease, background-color 120ms ease;
	}

	.filter-option:hover {
		color: var(--accent);
	}

	/* The underline sits under the text, not at the foot of the touch target. */
	.filter-option::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.5rem;
		height: 1px;
		background: transparent;
	}

	.filter-option[hidden] {
		display: none;
	}

	.filter-option.is-active {
		color: var(--accent);
	}

	.filter-option.is-active::after {
		background: var(--accent);
	}

	.filter-option-count {
		opacity: 1;
	}

	.filter-status {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 2.5rem;
		border-top: 1px solid var(--rule);
	}

	/* The reset is a real button: bordered, accent, fills on hover. */
	.filter-reset {
		min-height: 2rem;
		padding: 0.25rem 0.75rem;
		border: 1px solid var(--accent);
		border-radius: 999px;
		background: transparent;
		color: var(--accent);
		cursor: pointer;
		transition: background-color 160ms ease, color 160ms ease;
	}

	.filter-reset:hover {
		background: var(--accent);
		color: var(--paper);
	}

	/* Desktop: a tall panel, one option per line. Labels are sentence-case sans
	   (uppercase mono is ~25% wider) and wrap instead of clipping; counts sit in
	   a right-aligned, tabular column; a thin bar under each row shows its share
	   of the group's largest count; group labels stay pinned while scrolling;
	   the active option is marked by a bar in the left margin. */
	@media (min-width: 640px) {
		.filter-group-label {
			position: sticky;
			top: 0;
			z-index: 1;
			display: block;
			padding: 0.4rem 0 0.25rem;
			background: var(--paper);
		}

		.filter-options {
			flex-direction: column;
			flex-wrap: nowrap;
			gap: 0;
		}

		.filter-option {
			justify-content: space-between;
			align-items: flex-start;
			gap: 0.75rem;
			width: calc(100% + 1rem);
			margin-inline: -0.5rem;
			padding-inline: 0.5rem;
			min-height: 2rem;
			padding-block: 0.4rem 0.5rem;
			font: 500 0.8125rem/1.35 var(--font-sans);
			letter-spacing: 0;
			text-transform: none;
			text-align: left;
			white-space: normal;
			overflow-wrap: anywhere;
			background: linear-gradient(to right, var(--rule-strong) calc(var(--share, 0) * 100%), transparent 0) no-repeat 0 100% / 100% 2px;
		}

		.filter-option-count {
			flex: none;
			font-family: var(--font-mono);
			font-variant-numeric: tabular-nums;
			color: var(--secondary);
		}

		.filter-option:hover {
			background-color: var(--paper-deep);
		}

		.filter-option::after {
			left: 0;
			right: auto;
			top: 0.4rem;
			bottom: 0.5rem;
			width: 2px;
			height: auto;
		}
	}

	/* Phones: a small button at the bottom-left; the panel becomes a bottom sheet. */
	@media (max-width: 639px) {
		.blog-filter-float {
			top: auto;
			bottom: 0.75rem;
			left: 0.75rem;
		}

		.blog-filter-bar {
			left: 0;
			right: 0;
			bottom: 0;
			top: auto;
			width: auto;
			max-height: 70vh;
			border-width: 1px 0 0;
			padding-bottom: env(safe-area-inset-bottom, 0);
			transform: translateY(1.5rem);
		}

		.blog-filter-bar.is-open {
			transform: none;
		}
	}

	/* Reduced motion: state changes apply at once. */
	@media (prefers-reduced-motion: reduce) {
		.blog-filter-bar,
		.blog-filter-trigger,
		.blog-filter-clear,
		.filter-option,
		.filter-reset {
			transition: none;
		}
	}
</style>

<script>
	import { clearPopoverPlacement, makeDraggable, placePopover } from '../../utils/floating';

	const float = document.getElementById('blog-filter-float');
	const trigger = document.getElementById('blog-filter-trigger');
	const panel = document.getElementById('blog-filter-panel');

	if (float && trigger && panel) {
		const isSheet = () => window.matchMedia('(max-width: 639px)').matches;
		const isOpen = () => panel.classList.contains('is-open');

		const place = () => {
			if (!isOpen()) return;
			if (isSheet()) clearPopoverPlacement(panel);
			else placePopover(trigger, panel);
		};

		const drag = makeDraggable(float, { storageKey: 'hunbot-float-filter', onMove: place });

		const setOpen = (open: boolean) => {
			panel.classList.toggle('is-open', open);
			trigger.setAttribute('aria-expanded', String(open));
			if (open) {
				place();
			} else {
				// Keep it where it is while it fades out, then release the placement.
				window.setTimeout(() => {
					if (!isOpen()) clearPopoverPlacement(panel);
				}, 220);
			}
		};

		trigger.addEventListener('click', (event) => {
			event.stopPropagation();
			if (drag.wasDragged()) return;
			setOpen(!isOpen());
		});

		document.addEventListener('click', (event) => {
			const target = event.target as Node;
			if (isOpen() && !panel.contains(target) && !trigger.contains(target)) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) {
				setOpen(false);
				trigger.focus();
			}
		});

		window.addEventListener('resize', place);
	}
</script>
