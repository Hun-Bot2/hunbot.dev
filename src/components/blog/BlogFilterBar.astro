---
import { useTranslations, type UILanguage } from '../../i18n/ui';

interface FacetOption {
	value: string;
	label: string;
	count: number;
}

interface Props {
	lang: UILanguage;
	categories: FacetOption[];
	years: FacetOption[];
	series: FacetOption[];
	totalCount: number;
}

const { lang, categories, years, series, totalCount } = Astro.props;
const t = useTranslations(lang);

const groups = [
	{ facet: 'category', label: t('blog.filter-category'), options: categories },
	{ facet: 'year',     label: t('blog.filter-year'),     options: years      },
	{ facet: 'series',   label: t('blog.filter-series'),   options: series     },
].filter((group) => group.options.length > 0);

const resultsTemplate = t('blog.filter-results');
const initialResults = resultsTemplate.replace('{count}', String(totalCount));
---

<section class="blog-filter-bar" aria-label={t('blog.filter-label')} data-blog-filters>
	{groups.map((group, i) => (
		<details class:list={['filter-group', i > 0 && 'has-divider']} open>
			<summary class="filter-group-summary" role="button">
				<span class="filter-group-label">{group.label}</span>
				<svg class="filter-group-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<polyline points="6 9 12 15 18 9"/>
				</svg>
			</summary>
			<div class="filter-options" role="group" aria-label={group.label}>
				<button
					type="button"
					class="filter-option is-active"
					data-facet={group.facet}
					data-value="all"
					aria-pressed="true"
				>
					<span class="filter-option-dot" aria-hidden="true"></span>
					<span class="filter-option-label">{t('blog.filter-all')}</span>
				</button>
				{group.options.map((option) => (
					<button
						type="button"
						class="filter-option"
						data-facet={group.facet}
						data-value={option.value}
						aria-pressed="false"
					>
						<span class="filter-option-dot" aria-hidden="true"></span>
						<span class="filter-option-label">{option.label}</span>
						<span class="filter-option-count">{option.count}</span>
					</button>
				))}
			</div>
		</details>
	))}

	<div class="filter-status has-divider">
		<p data-filter-results data-results-template={resultsTemplate} aria-live="polite">{initialResults}</p>
		<button type="button" class="filter-reset" data-filter-reset hidden>
			{t('blog.filter-reset')}
		</button>
	</div>
</section>

<style>
	.blog-filter-bar {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	/* ── collapsible group ── */
	.filter-group {
		padding: 0.6rem 0;
	}

	.filter-group.has-divider {
		border-top: 1px solid rgba(148, 163, 184, 0.12);
	}

	/* Remove default <details> marker */
	.filter-group summary {
		list-style: none;
	}
	.filter-group summary::-webkit-details-marker {
		display: none;
	}

	.filter-group-summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.4rem;
		padding: 0.2rem 0;
		cursor: pointer;
		user-select: none;
	}

	.filter-group-label {
		color: rgba(148, 163, 184, 0.65);
		font-family: var(--font-heading);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.filter-group-chevron {
		flex-shrink: 0;
		color: rgba(148, 163, 184, 0.45);
		transition: transform 200ms ease;
	}

	/* Rotate chevron when closed */
	.filter-group:not([open]) .filter-group-chevron {
		transform: rotate(-90deg);
	}

	/* ── options list ── */
	.filter-options {
		display: flex;
		flex-direction: column;
		gap: 0;
		margin-top: 0.35rem;
	}

	.filter-option {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		width: 100%;
		padding: 0.3rem 0.25rem;
		border: none;
		background: transparent;
		color: rgba(203, 213, 225, 0.72);
		font: inherit;
		font-size: 0.83rem;
		font-weight: 500;
		text-align: left;
		cursor: pointer;
		transition: color 130ms ease;
	}

	.filter-option:hover {
		color: rgba(255, 237, 213, 0.9);
	}

	.filter-option.is-active {
		color: rgb(253, 186, 116);
		font-weight: 700;
	}

	/* Indicator dot — visible only when active */
	.filter-option-dot {
		flex-shrink: 0;
		display: inline-block;
		width: 5px;
		height: 5px;
		border-radius: 999px;
		background: transparent;
		margin-top: 0.15em;
		transition: background 130ms ease;
	}

	.filter-option.is-active .filter-option-dot {
		background: rgb(249, 115, 22);
	}

	.filter-option-label {
		flex: 1;
		min-width: 0;
		word-break: break-word;
		line-height: 1.4;
	}

	.filter-option-count {
		flex-shrink: 0;
		color: rgba(148, 163, 184, 0.5);
		font-size: 0.72rem;
		font-weight: 700;
	}

	.filter-option.is-active .filter-option-count {
		color: rgba(253, 186, 116, 0.7);
	}

	/* ── status bar ── */
	.filter-status {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.4rem;
		padding-top: 0.6rem;
		margin-top: 0.1rem;
	}

	.filter-status.has-divider {
		border-top: 1px solid rgba(148, 163, 184, 0.12);
	}

	.filter-status p {
		margin: 0;
		color: rgba(203, 213, 225, 0.55);
		font-size: 0.76rem;
		font-weight: 600;
	}

	.filter-reset {
		border: none;
		background: transparent;
		padding: 0;
		color: rgba(249, 115, 22, 0.75);
		font: inherit;
		font-size: 0.75rem;
		font-weight: 700;
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 2px;
		transition: color 130ms ease;
	}

	.filter-reset:hover {
		color: rgb(249, 115, 22);
	}

	/* light-theme overrides live in global.css */
</style>
