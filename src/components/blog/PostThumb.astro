---
import GeometricCover from '../editorial/GeometricCover.astro';
import type { CollectionEntry } from 'astro:content';
import { getResponsivePublicImage } from '../../utils/responsive-public-images';

interface Props {
	post: CollectionEntry<'blog'>;
	/** `sizes` hint for responsive heroes; the default suits the 126px list thumbnail. */
	sizes?: string;
	class?: string;
}

const { post, sizes = '126px', class: className } = Astro.props;
const motif = post.data.editorial?.motif;
const hero = post.data.heroImage || !motif
	? getResponsivePublicImage(post.data.heroImage || '/images/blank.png')
	: null;
---

<div class={className ?? 'post-thumb'} aria-hidden="true">
	{hero ? <picture>
		{hero.webpSrcSet && <source type="image/webp" srcset={hero.webpSrcSet} sizes={sizes} />}
		<img
			src={hero.src}
			alt=""
			loading="lazy"
			decoding="async"
			width={hero.width}
			height={hero.height}
			sizes={sizes}
		/>
	</picture> : <GeometricCover motif={motif} variant={post.data.seriesOrder} compact />}
</div>

<style>
	:global(.post-thumb > .geometric-cover),
	:global(.entry-thumb > .geometric-cover),
	:global(.post-thumb > .geometric-cover > svg),
	:global(.entry-thumb > .geometric-cover > svg) {
		width: 100%;
		height: 100%;
	}
</style>
