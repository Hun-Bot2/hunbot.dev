---
import type { UILanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/ui';
import { getBlogPageUrl } from '../../utils/blog';

interface Props {
	lang: UILanguage;
	currentPage: number;
	totalPages: number;
}

const { lang, currentPage, totalPages } = Astro.props;
const t = useTranslations(lang);
const previousPage = currentPage - 1;
const nextPage = currentPage + 1;
const previousHref = previousPage >= 1 ? getBlogPageUrl(lang, previousPage) : null;
const nextHref = nextPage <= totalPages ? getBlogPageUrl(lang, nextPage) : null;
const pageStatus = t('blog.pagination-status')
	.replace('{current}', String(currentPage))
	.replace('{total}', String(totalPages));
const linkClass =
	'inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-700 px-4 py-2 text-sm font-semibold text-slate-200 transition-colors hover:border-orange-500/80 hover:text-orange-300';
const disabledClass =
	'inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-800 px-4 py-2 text-sm font-semibold text-slate-600';
---

{totalPages > 1 && (
	<nav class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-800 pt-6 sm:flex-row" aria-label={t('blog.pagination-label')}>
		{previousHref ? (
			<a href={previousHref} class={linkClass} rel={currentPage === 2 ? undefined : 'prev'}>
				{t('blog.pagination-previous')}
			</a>
		) : (
			<span class={disabledClass} aria-disabled="true">
				{t('blog.pagination-previous')}
			</span>
		)}

		<p class="text-sm font-medium text-slate-400" aria-live="polite">{pageStatus}</p>

		{nextHref ? (
			<a href={nextHref} class={linkClass} rel="next">
				{t('blog.pagination-next')}
			</a>
		) : (
			<span class={disabledClass} aria-disabled="true">
				{t('blog.pagination-next')}
			</span>
		)}
	</nav>
)}
