---
import GeometricCover from './GeometricCover.astro';
import { randomUUID } from 'node:crypto';
import type { ReadingLink } from './RelatedReading.astro';
interface Props { links: ReadingLink[]; heading: string; kind: 'internal' | 'reference'; }
const { links, heading, kind } = Astro.props;
const id = `reading-${randomUUID()}`;
const points = links.map((_,i) => ({ x:24+i*56, y:kind === 'internal' ? 30+(i%2)*7 : 26 }));
---
{links.length > 0 && <section data-reading-graph class:list={['reading-graph', kind === 'reference' ? 'reference-links' : 'related-reading']} aria-label={heading}>
 <h2>{heading}<span>{kind === 'internal' ? 'BLOG' : 'SOURCES'}</span></h2>
 <div class="reading-map" data-reading-controls role="group" aria-label={heading} hidden>
  <svg class="graph-edges" viewBox="0 0 208 58" aria-hidden="true">
   {points.slice(1).map((point,i) => <path d={kind === 'internal' ? `M ${points[i].x} ${points[i].y} Q ${(points[i].x+point.x)/2} -3 ${point.x} ${point.y}` : `M ${points[i].x+12} 26 H ${point.x-12}`} />)}
  </svg>
  {links.map((link,i) => <button type="button" class="graph-node" data-reading-index={i} style={`left:${points[i].x}px;top:${points[i].y}px`} aria-label={link.title} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`${id}-${i}`}>
   <span class="node-art" aria-hidden="true">
    {link.image ? <img src={link.image} alt="" loading="lazy" /> : link.motif ? <GeometricCover motif={link.motif} variant={link.variant} compact /> : <span class="node-fallback">{kind === 'reference' ? String(i+1).padStart(2,'0') : link.title.slice(0,1)}</span>}
   </span>
  </button>)}
 </div>
 <ul class="reading-panels" aria-live="polite">{links.map((link,i) => <li id={`${id}-${i}`} data-reading-panel={i}>
  <a class="reading-card" href={link.url}>
   <span class="reading-relation">{link.relation}{kind === 'reference' && ' ↗'}</span>
   <span class="reading-title">{link.title}</span>
   <span class="reading-description">{link.description}</span>
  </a>
 </li>)}</ul>
</section>}
<script>
import { initializeReadingGraphs } from '../../utils/reading-graph';
initializeReadingGraphs();
document.addEventListener('astro:page-load', initializeReadingGraphs);
</script>
<style>
h2 { display:flex; align-items:center; justify-content:space-between; margin:0; font:500 .85rem/1.5 var(--font-sans); }
h2>span { font:400 .6rem/1 var(--font-mono); color:var(--secondary); letter-spacing:.06em; }
.reading-map { position:relative; width:208px; max-width:100%; height:58px; margin:.3rem 0; }
.graph-edges { position:absolute; inset:0; width:208px; max-width:100%; height:58px; fill:none; stroke:var(--rule-strong); stroke-width:1; }
.reference-links .graph-edges { stroke-dasharray:2 3; }
.graph-node { position:absolute; display:grid; place-items:center; width:44px; height:44px; transform:translate(-50%,-50%); border:0; padding:0; background:transparent; cursor:pointer; color:var(--ink); }
.node-art { display:block; width:22px; height:22px; overflow:hidden; border-radius:50%; border:2px solid var(--paper); outline:1px solid var(--rule-strong); background:var(--paper-deep); }
.reference-links .node-art { width:18px; height:22px; border-radius:2px; background:var(--paper-light); }
.node-art img { display:block; width:100%; height:100%; object-fit:cover; }
.node-art :global(.geometric-cover),.node-art :global(svg) { width:100%; height:100%; }
.node-fallback { display:grid; place-items:center; width:100%; height:100%; color:var(--accent); font:500 .55rem/1 var(--font-mono); }
.graph-node[aria-pressed="true"] .node-art { outline:2px solid var(--accent); }
.reading-panels { list-style:none; margin:0; padding:0; }
.reading-panels>li+li { margin-top:.75rem; }
.reading-panels>li.is-active { margin-top:0; animation:reading-reveal var(--dur-2) var(--ease-standard); }
.reading-card { display:block; padding:.9rem; border:1px solid var(--rule); border-radius:12px; background:var(--paper-light); text-decoration:none; color:var(--ink); }
.reference-links { padding-top:1rem; border-top:1px solid var(--rule); }
.reference-links .reading-card { padding:.2rem 0 .2rem .8rem; border:0; border-left:2px solid var(--accent); border-radius:0; background:none; }
.reading-relation { display:block; margin-bottom:.5rem; color:var(--secondary); font:400 .65rem/1.6 var(--font-sans); }
.reading-title { display:block; font:400 .85rem/1.7 var(--font-sans); }
.reference-links .reading-title { color:var(--link); text-decoration:underline; text-underline-offset:.2em; }
.reading-description { display:block; margin-top:.5rem; color:var(--secondary); font:400 .75rem/1.7 var(--font-sans); }
a:focus-visible,button:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
[hidden] { display:none !important; }
@keyframes reading-reveal { from { opacity:.35; transform:translateY(3px); } to { opacity:1; transform:none; } }
@media(prefers-reduced-motion:reduce) { .reading-panels>li.is-active { animation:none; } }
</style>
