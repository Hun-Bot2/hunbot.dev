---
import ReadingGraph from './ReadingGraph.astro';
import type { ReadingLink } from './RelatedReading.astro';
interface Props { links: ReadingLink[]; lang?: string; }
const { links, lang = 'ko' } = Astro.props;
const heading = lang === 'en' ? 'References' : lang === 'jp' ? '参考リンク' : '참고 링크';
---
<ReadingGraph links={links} heading={heading} kind="reference" />
