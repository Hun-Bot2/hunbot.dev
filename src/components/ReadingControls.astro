---
import { useTranslations } from '../i18n/ui';
import type { UILanguage } from '../i18n/ui';

type Props = {
	lang?: UILanguage;
};

const { lang = 'ko' } = Astro.props as Props;
const t = useTranslations(lang);
---

<!--
	Long-article navigation: a 2px reading-progress line at the top of the viewport
	and a small "back to top" button at the bottom-right. Both appear only after the
	reader has scrolled ~400px. No sidebar; the TOC dropdown covers "jump anywhere".
-->
<div id="reading-progress" class="reading-progress" role="progressbar" aria-label={t('post.reading-progress')} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden>
	<span class="reading-progress-bar"></span>
</div>

<button type="button" id="back-to-top" class="back-to-top" aria-label={t('post.back-to-top')} title={t('post.back-to-top')} hidden>
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
		<path d="M12 19V5M5 12l7-7 7 7" />
	</svg>
	<span class="back-to-top-percent" aria-hidden="true">0%</span>
</button>

<style is:global>
	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 101;
		height: 2px;
		pointer-events: none;
	}

	.reading-progress[hidden],
	.back-to-top[hidden] {
		display: none;
	}

	.reading-progress-bar {
		display: block;
		height: 100%;
		width: 100%;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left center;
	}

	.back-to-top {
		position: fixed;
		right: var(--float-inset);
		bottom: 1rem;
		z-index: 90;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 36px;
		padding: 0 0.7rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper);
		color: var(--ink);
		font: 400 0.6875rem/1 var(--font-mono);
		letter-spacing: 0.06em;
		cursor: pointer;
	}

	.back-to-top:hover {
		border-color: var(--ink);
		color: var(--accent);
	}

	@media (max-width: 639px) {
		.back-to-top {
			right: 0.75rem;
			bottom: 0.75rem;
		}
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const progress = document.getElementById('reading-progress');
		const bar = progress?.querySelector<HTMLElement>('.reading-progress-bar');
		const button = document.getElementById('back-to-top');
		const percentEl = button?.querySelector<HTMLElement>('.back-to-top-percent');
		if (!progress || !bar || !button || !percentEl) return;

		const SHOW_AFTER = 400;
		let ticking = false;

		const update = () => {
			ticking = false;
			const scrollable = document.documentElement.scrollHeight - window.innerHeight;
			const y = window.scrollY;
			const visible = scrollable > SHOW_AFTER && y > SHOW_AFTER;
			const ratio = scrollable > 0 ? Math.min(1, Math.max(0, y / scrollable)) : 0;
			const percent = Math.round(ratio * 100);

			progress.hidden = !visible;
			button.hidden = !visible;
			bar.style.transform = `scaleX(${ratio})`;
			progress.setAttribute('aria-valuenow', String(percent));
			percentEl.textContent = `${percent}%`;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(update);
			},
			{ passive: true },
		);
		window.addEventListener('resize', update);

		button.addEventListener('click', () => {
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
		});

		update();
	});
</script>
