---
import { getLangFromUrl, languages } from '../i18n/ui';

interface Props {
	/** Languages this page exists in. Omit when every language has the page. */
	availableLangs?: string[];
	class?: string;
}

const { availableLangs, class: className } = Astro.props as Props;
const currentLang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

// Remove the language prefix to get the base path.
function getBasePath(path: string, lang: string) {
	if (path.startsWith(`/${lang}/`)) {
		return path.slice(lang.length + 1);
	}
	if (path === `/${lang}`) {
		return '/';
	}
	return path;
}

const basePath = getBasePath(currentPath, currentLang);

// Every language is prefixed, Korean included. Korean pages are only generated at
// /ko/..., and vercel.json redirects a handful of bare paths, so an unprefixed
// deep link such as /blog/devlog/x/ has no page and no redirect behind it.
// Languages without a translation of this page are left out rather than linked
// to a 404.
const visibleLangs = Object.keys(languages).filter(
	(lang) => lang === currentLang || !availableLangs || availableLangs.length === 0 || availableLangs.includes(lang),
);
const languageUrls = Object.fromEntries(
	visibleLangs.map((lang) => [lang, basePath === '/' ? `/${lang}/` : `/${lang}${basePath}`]),
) as Record<string, string>;
---

<nav class:list={['language-picker', className]} aria-label="Language">
	{visibleLangs.map((lang) => (
		<a
			href={languageUrls[lang]}
			lang={lang}
			hreflang={lang}
			title={languages[lang as keyof typeof languages]}
			aria-current={lang === currentLang ? 'true' : undefined}
			class:list={['lang-link', { active: lang === currentLang }]}
		>
			{lang.toUpperCase()}
		</a>
	))}
</nav>

<style>
	.language-picker {
		display: inline-flex;
		align-items: center;
		font: 400 0.6875rem/1 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.lang-link {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0 0.4rem;
		color: var(--secondary);
	}

	.lang-link:hover {
		color: var(--accent);
	}

	.lang-link.active {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 5px;
	}
</style>
