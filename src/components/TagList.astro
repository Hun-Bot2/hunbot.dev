---
export interface Props {
  tags: string[];
  maxTags?: number;
}

const { tags, maxTags = 2 } = Astro.props;

const displayTags = tags.slice(0, maxTags);
---

{displayTags.length > 0 && (
  <ul class="tag-list">
    {displayTags.map((tag) => <li>#{tag}</li>)}
  </ul>
)}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 0.6875rem/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--secondary);
  }
</style>
