---
interface Props {
  items: Array<{
    name: string;
    href?: string;
  }>;
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {items.map((item) => (
      <li>
        {item.href ? (
          <a href={item.href}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb {
    margin-bottom: 1.75rem;
  }

  .breadcrumb ol {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 0.6875rem / 1.45 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin: 0 0.7em;
    color: var(--faint);
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .breadcrumb li:last-child {
    flex-shrink: 1;
    min-width: 0;
  }

  .breadcrumb a {
    padding-block: 0.5rem;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .breadcrumb [aria-current='page'] {
    display: block;
    max-width: 40ch;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--ink);
  }
</style>
