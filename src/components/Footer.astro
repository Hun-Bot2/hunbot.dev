---
import { AUTHOR_EMAIL, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const langBase = `/${lang}`;
const year = new Date().getFullYear();
const brandName = SITE_TITLE.replace('-', '—');
const siteLinks = [
	{ href: `${langBase}/`, label: t('nav.home') },
	{ href: `${langBase}/blog/`, label: t('nav.blog') },
	{ href: `${langBase}/research/`, label: t('nav.research') },
	{ href: `${langBase}/library/`, label: t('nav.library') },
	{ href: `${langBase}/search/`, label: t('nav.search') },
];
---
<footer class="site-footer" data-pagefind-ignore>
	<div class="footer-grid page-frame">
		<div class="footer-about">
			<p class="footer-heading">{brandName}</p>
			<p>{t('footer.about')}</p>
		</div>

		<nav class="footer-nav" aria-label="Footer">
			<p class="footer-heading">{t('footer.navigation')}</p>
			{siteLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			<a href="/rss.xml">RSS</a>
		</nav>

		<div class="footer-connect">
			<p class="footer-heading">{t('footer.connect')}</p>
			<div class="footer-icons">
				<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
					<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
						<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
					</svg>
				</a>
				<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z" />
					</svg>
				</a>
				<a href={`mailto:${AUTHOR_EMAIL}`} aria-label="Email" title="Email">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
						<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
						<polyline points="22,6 12,13 2,6" />
					</svg>
				</a>
			</div>
			<a class="footer-mail" href={`mailto:${AUTHOR_EMAIL}`}>{AUTHOR_EMAIL}</a>
		</div>

		<div class="footer-legal">
			<small>&copy; {year} {brandName}</small>
			<small>{t('footer.built-with')} Astro &amp; Tailwind CSS</small>
		</div>
	</div>
</footer>

<style>
	/* Same paper as the page; the only chrome is the one rule above. */
	.site-footer {
		margin-top: 4rem;
		padding: 2.25rem 0 1.25rem;
		border-top: 1px solid var(--rule);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 0.8fr 1fr;
		column-gap: 4vw;
		row-gap: 1.75rem;
	}

	.footer-heading {
		margin: 0 0 0.75rem;
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.footer-about p:not(.footer-heading) {
		max-width: 30rem;
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--secondary);
	}

	.footer-nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		font-size: 0.875rem;
	}

	.footer-nav a {
		display: inline-flex;
		align-items: center;
		min-height: 32px;
		color: var(--ink);
	}

	.footer-nav a:hover,
	.footer-mail:hover,
	.footer-icons a:hover {
		color: var(--accent);
	}

	.footer-icons {
		display: flex;
		gap: 0.25rem;
		margin-left: -0.5rem;
	}

	.footer-icons a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		color: var(--ink);
	}

	.footer-mail {
		font-size: 0.875rem;
		color: var(--secondary);
	}

	.footer-legal {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	@media (max-width: 800px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
