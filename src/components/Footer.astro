---
import { AUTHOR_EMAIL, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const langBase = `/${lang}`;
const brandName = SITE_TITLE.replace('-', '—');
const siteLinks = [
	{ href: `${langBase}/blog/`, label: t('nav.blog') },
	{ href: `${langBase}/research/`, label: t('nav.research') },
	{ href: `${langBase}/library/`, label: t('nav.library') },
	{ href: `${langBase}/search/`, label: t('nav.search') },
];
const externalLinks = [
	{ href: SOCIAL_LINKS.github, label: 'GitHub' },
	{ href: SOCIAL_LINKS.linkedin, label: 'LinkedIn' },
];
---

<footer class="site-footer" data-pagefind-ignore>
	<div class="footer-grid page-frame">
		<div class="footer-intro">
			<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
				<path d="M5 25V7M11 25V11M17 25V4M23 25V14M5 20h18" />
				<circle cx="27" cy="7" r="2" />
			</svg>
			<p class="footer-tagline">{t('footer.tagline')}</p>
		</div>

		<div class="footer-about">
			<p>{t('footer.about')}</p>
			<a href={`mailto:${AUTHOR_EMAIL}`}>{AUTHOR_EMAIL}</a>
		</div>

		<nav class="footer-nav" aria-label="Footer">
			{siteLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			<a href="/rss.xml">RSS</a>
			{externalLinks.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">&#8599;</span></a>
			))}
			<a href="#top" class="footer-top">{t('footer.top')} <span aria-hidden="true">&#8593;</span></a>
		</nav>

		<small class="footer-legal">&copy; {new Date().getFullYear()} {brandName}</small>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		padding: 2.5rem 0 1rem;
		background: color-mix(in srgb, var(--paper) 92%, var(--ink));
		border-top: 1px solid var(--rule);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.2fr 1fr 0.5fr;
		column-gap: 6vw;
		row-gap: 1.75rem;
	}

	.brand-mark {
		width: 26px;
		height: 26px;
		fill: none;
		stroke: var(--ink);
		stroke-width: 1.35;
	}

	.brand-mark circle {
		fill: var(--accent);
		stroke: none;
	}

	.footer-tagline {
		margin: 1.5rem 0 0;
		font: 400 2.25rem/1.1 var(--font-serif);
		letter-spacing: -0.02em;
		color: var(--ink);
		text-wrap: balance;
	}

	.footer-about {
		font-size: 0.875rem;
		line-height: 1.7;
		color: var(--secondary);
	}

	.footer-about p {
		margin: 0;
	}

	.footer-about a {
		display: inline-block;
		margin-top: 1.1rem;
		border-bottom: 1px solid currentColor;
		color: var(--ink);
	}

	.footer-about a:hover {
		color: var(--accent);
	}

	.footer-nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
		font-size: 0.8125rem;
	}

	.footer-nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		min-height: 36px;
		color: var(--ink);
	}

	.footer-nav a:hover {
		color: var(--accent);
	}

	.footer-top {
		margin-top: 0.5rem;
		color: var(--secondary);
	}

	.footer-legal {
		grid-column: 1 / -1;
		padding-top: 1.25rem;
		margin-top: 1.25rem;
		border-top: 1px solid var(--rule);
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	@media (max-width: 800px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}

		.footer-tagline {
			font-size: 1.875rem;
		}
	}
</style>
