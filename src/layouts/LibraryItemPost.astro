---
// An item's page: the owner's own note about one 자료 item (docs/content/
// item-notes.md; created by a note, so an item without one has no page).
// A reading page: it reuses the article shell (`.article-page`, `.prose`, the
// explainer title scale) and adds nothing to the type scale.
//
// Order: breadcrumb, eyebrow (kind · topic · area), title, the item's own
// one-line description (shown as delivered, marked as the item's), dates and
// reading time, the note, the original box (the page's only external link),
// backlinks, tags.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import FloatingLanguagePicker from '../components/FloatingLanguagePicker.astro';
import ReadingControls from '../components/ReadingControls.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Backlinks from '../components/Backlinks.astro';
import LinkPreview from '../components/LinkPreview.astro';
import { getLibraryArea } from '../data/libraryAreas';
import { useTranslations, type UILanguage } from '../i18n/ui';
import { formatPostDate } from '../utils/display';
import { getItemUrl } from '../utils/item-notes';
import { getLibraryKindLabel, getLibraryTopicLabel } from '../utils/library-labels';
import type { Backlink } from '../utils/backlinks';
import '../styles/prose.css';

type Props = {
	lang: UILanguage;
	pageId: string;
	title: string;
	url: string;
	kind: string;
	area: string;
	topic: string;
	/** The item's delivered one-line summary, '' when it has none. */
	description: string;
	writtenAt: string;
	updatedAt: string | null;
	readMinutes: number;
	tags: string[];
	/** Set only when the resource's license allows republishing assets. */
	image?: { src: string; width: number; height: number } | null;
	backlinks: Backlink[];
};

const { lang, pageId, title, url, kind, area, topic, description, writtenAt, updatedAt, readMinutes, tags, image = null, backlinks } = Astro.props as Props;
const t = useTranslations(lang);
const host = new URL(url).host.replace(/^www\./, '');
// The note is Korean on every language's page; the other pages are the same text under that language's chrome.
const isCanonical = lang === 'ko';
const contentLangAttr = isCanonical ? undefined : 'ko';
const canonicalURL = new URL(getItemUrl('ko', pageId), Astro.site);
const libraryUrl = `/${lang}/library/`;
const eyebrow = [getLibraryKindLabel(kind, lang), getLibraryTopicLabel(topic, lang), getLibraryArea(area).label[lang]];
const metaDescription = description || title;
---

<html lang={lang}>
	<head>
		<BaseHead title={`${title} - Hun-Bot Blog`} description={metaDescription} canonicalURL={canonicalURL.href} lang={lang} availableLangs={['ko']} />
		{!isCanonical && <meta name="robots" content="noindex, follow" />}
		<meta property="og:type" content="article" />
		<meta property="article:published_time" content={new Date(writtenAt).toISOString()} />
		<meta data-pagefind-meta="title[content]" content={title} />
		<meta data-pagefind-meta="description[content]" content={metaDescription} />
		<meta data-pagefind-filter="language[content]" content="ko" />
		<meta data-pagefind-filter="section[content]" content="library" />
		{tags.map((tag) => <meta data-pagefind-filter="tag[content]" content={tag} />)}
	</head>

	<body>
		<Header />
		<FloatingLanguagePicker />
		<ReadingControls lang={lang} />
		<main id="main-content" class="article-page item-page" data-post-lang={lang}>
			<article aria-labelledby="item-title" data-pagefind-body={isCanonical ? true : undefined}>
				<header class="article-header item-header page-frame">
					<Breadcrumb
						items={[
							{ name: t('library.title'), href: libraryUrl },
							{ name: t('item.breadcrumb'), href: libraryUrl },
						]}
					/>
					<p class="item-eyebrow">{eyebrow.join(' · ')}</p>
					<h1 id="item-title" class="article-title item-title">{title}</h1>
					{
						description && (
							<p class="item-summary">
								<span class="item-summary-label">{t('item.description-label')}</span>
								{description}
							</p>
						)
					}
					<p class="item-dates article-meta">
						<span>{t('blog.published')} <time datetime={writtenAt}>{formatPostDate(new Date(writtenAt))}</time></span>
						{updatedAt && <span>{t('blog.updated')} <time datetime={updatedAt}>{formatPostDate(new Date(updatedAt))}</time></span>}
						<span>{t('post.read-time').replace('{minutes}', String(readMinutes))}</span>
					</p>
					{!isCanonical && <p class="item-ko-only">{t('item.ko-only')}</p>}
				</header>

				<div class="article-canvas page-frame">
					<TableOfContents lang={lang} />
					<div class="article-main">
						<div class="prose" lang={contentLangAttr}>
							<slot />
						</div>

						<aside class="item-original" aria-labelledby="item-original-label">
							<p id="item-original-label" class="item-original-label">{t('item.original.label')}</p>
							<div class="item-original-body">
								{image && <img class="item-original-thumb" src={image.src} width={image.width} height={image.height} alt="" loading="lazy" decoding="async" />}
								<p class="item-original-host">{host}<span class="item-original-kind"> · {getLibraryKindLabel(kind, lang)}</span></p>
								<a class="btn-pill item-original-link" href={url} target="_blank" rel="noopener noreferrer" aria-label={`${t('item.original.open')}: ${title}`}>
									{t('item.original.open')} <span aria-hidden="true">↗</span>
								</a>
							</div>
						</aside>

						<Backlinks links={backlinks} lang={lang} />

						{
							tags.length > 0 && (
								<ul class="article-tags item-tags" aria-label={t('item.tags')}>
									{tags.map((tag) => <li class="chip">{tag.replaceAll('-', ' ')}</li>)}
								</ul>
							)
						}
					</div>
				</div>
			</article>
		</main>
		<LinkPreview />
	</body>
</html>

<style is:global>
	.item-header {
		padding-bottom: 1.25rem;
	}

	.item-eyebrow {
		margin: 0 0 0.9rem;
		font: 400 0.6875rem/1.5 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	/* The explainer's title scale: larger than any prose heading. */
	.article-header .item-title {
		margin: 0;
		font: 400 clamp(2rem, 1.4rem + 2.6vw, 3rem) / 1.2 var(--font-serif);
		letter-spacing: -0.01em;
	}

	.item-title:lang(ko) {
		word-break: keep-all;
	}

	.item-summary {
		max-width: 40rem;
		margin: 0.9rem 0 0;
		font: 400 0.9375rem/1.65 var(--font-sans);
		color: var(--secondary);
		text-wrap: pretty;
	}

	.item-summary-label {
		display: block;
		margin-bottom: 0.15rem;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.item-dates {
		margin: 1rem 0 0;
	}

	.item-ko-only {
		margin: 0.9rem 0 0;
		font: 400 0.75rem/1.6 var(--font-mono);
		letter-spacing: 0.06em;
		color: var(--secondary);
	}

	/* Original box: where the item itself lives. The only link out of the page. */
	.item-original {
		margin-top: 3rem;
		padding: 1.1rem 1.4rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper-deep);
	}

	.item-original-label {
		margin: 0 0 0.6rem;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.item-original-body {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1.5rem;
	}

	.item-original-thumb {
		width: 5.25rem;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	.item-original-host {
		flex: 1 1 12rem;
		margin: 0;
		font: 400 0.875rem/1.5 var(--font-mono);
		overflow-wrap: anywhere;
	}

	.item-original-kind {
		font-size: 0.6875rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.item-original-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.5rem;
		white-space: nowrap;
		text-decoration: none;
	}

	.item-original-link:hover,
	.item-original-link:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}

	.item-tags {
		margin-top: 1.75rem;
	}
</style>
