---
// An item's page: every published 자료 item has one (docs/decisions/site-structure.md,
// Revision 2026-10-23c); the owner's own note (docs/content/item-notes.md) fills
// it when it exists. A reading page: it reuses the article shell (`.article-page`,
// `.prose`, the explainer title scale) and adds nothing to the type scale.
//
// Order: breadcrumb, the item's own preview image in a 2:1 frame (else the
// monogram tile), eyebrow (kind · area · topic), title, the item's own one-line
// description (shown as delivered, marked as the item's), dates and reading time
// (note only), the note or one quiet "no note yet" line, the original box (the
// page's only external link), backlinks, tags. With no note the page is noindex
// (a thin page) and is left out of the sitemap.
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import FloatingLanguagePicker from '../components/FloatingLanguagePicker.astro';
import ReadingControls from '../components/ReadingControls.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Backlinks from '../components/Backlinks.astro';
import LinkPreview from '../components/LinkPreview.astro';
import ProvenanceBadge from '../components/library/ProvenanceBadge.astro';
import { getLibraryArea } from '../data/libraryAreas';
import { getMonogram } from '../utils/library-area-tabs';
import { getResponsivePublicImage } from '../utils/responsive-public-images';
import { useTranslations, type UILanguage } from '../i18n/ui';
import { formatPostDate } from '../utils/display';
import { getItemUrl } from '../utils/item-notes';
import { getLibraryKindLabel, getLibraryTopicLabel } from '../utils/library-labels';
import type { Backlink } from '../utils/backlinks';
import '../styles/prose.css';

type Props = {
	lang: UILanguage;
	pageId: string;
	title: string;
	url: string;
	kind: string;
	area: string;
	topic: string;
	/** The item's delivered one-line summary, '' when it has none. */
	description: string;
	/** The owner wrote a note: the page is indexable and shows dates and the note. */
	hasNote: boolean;
	writtenAt: string | null;
	updatedAt: string | null;
	readMinutes: number;
	tags: string[];
	/** 'bot': a draft written from public sources, shown only once the owner reviewed it. */
	authorship?: 'owner' | 'bot';
	sources?: string[];
	reviewedAt?: string | null;
	/** The item's own preview image, as shown in the list (owner decision 2026-10-25). */
	image?: { src: string; width: number; height: number } | null;
	backlinks: Backlink[];
};

const { lang, pageId, title, url, kind, area, topic, description, hasNote, writtenAt, updatedAt, readMinutes, tags, authorship = 'owner', sources = [], reviewedAt = null, image = null, backlinks } = Astro.props as Props;
const t = useTranslations(lang);
const host = new URL(url).host.replace(/^www\./, '');
// The note is Korean on every language's page; the other pages are the same text under that language's chrome.
const isCanonical = lang === 'ko';
const contentLangAttr = isCanonical ? undefined : 'ko';
const canonicalURL = new URL(getItemUrl('ko', pageId), Astro.site);
const libraryUrl = `/${lang}/library/`;
const eyebrow = [getLibraryKindLabel(kind, lang), getLibraryArea(area).label[lang], getLibraryTopicLabel(topic, lang)];
const responsive = image ? getResponsivePublicImage(image.src) : null;
const tint = getLibraryArea(area).tint;
// A page without a note is thin: noindex until the owner writes one.
const indexable = isCanonical && hasNote;
const metaDescription = description || title;
const isBot = authorship === 'bot';
// Shown as plain text: host + path, no query or fragment.
const sourceLabel = (source: string) => {
	const parsed = new URL(source);
	return `${parsed.host.replace(/^www\./, '')}${parsed.pathname === '/' ? '' : parsed.pathname.replace(/\/$/, '')}`;
};
---

<html lang={lang}>
	<head>
		<BaseHead title={`${title} - Hun-Bot Blog`} description={metaDescription} canonicalURL={canonicalURL.href} lang={lang} availableLangs={['ko']} />
		{!indexable && <meta name="robots" content="noindex, follow" />}
		<meta property="og:type" content="article" />
		{writtenAt && <meta property="article:published_time" content={new Date(writtenAt).toISOString()} />}
		<meta data-pagefind-meta="title[content]" content={title} />
		<meta data-pagefind-meta="description[content]" content={metaDescription} />
		<meta data-pagefind-filter="language[content]" content="ko" />
		<meta data-pagefind-filter="section[content]" content="library" />
		{tags.map((tag) => <meta data-pagefind-filter="tag[content]" content={tag} />)}
	</head>

	<body>
		<Header />
		<FloatingLanguagePicker />
		<ReadingControls lang={lang} />
		<main id="main-content" class="article-page item-page" data-post-lang={lang}>
			<article aria-labelledby="item-title" data-pagefind-body={indexable ? true : undefined}>
				<header class="article-header item-header page-frame">
					<Breadcrumb
						items={[
							{ name: t('library.title'), href: libraryUrl },
							{ name: t('item.breadcrumb'), href: libraryUrl },
						]}
					/>
					{
						image ? (
							<span class="item-image" aria-hidden="true">
								<img src={image.src} srcset={responsive?.webpSrcSet} sizes={responsive?.webpSrcSet ? '(min-width: 1020px) 980px, 100vw' : undefined} width={image.width} height={image.height} alt="" loading="lazy" decoding="async" />
							</span>
						) : (
							<span class="item-mark" aria-hidden="true" style={`--tint: var(--area-${tint})`}>{getMonogram(title)}</span>
						)
					}
					<p class="item-eyebrow">{eyebrow.join(' · ')}</p>
					<h1 id="item-title" class="article-title item-title">{title}</h1>
					{
						description && (
							<p class="item-summary">
								<span class="item-summary-label">{t('item.description-label')}</span>
								{description}
							</p>
						)
					}
					{
						hasNote && writtenAt && (
							<p class="item-dates article-meta">
								<span>{t('blog.published')} <time datetime={writtenAt}>{formatPostDate(new Date(writtenAt))}</time></span>
								{updatedAt && <span>{t('blog.updated')} <time datetime={updatedAt}>{formatPostDate(new Date(updatedAt))}</time></span>}
								<span>{t('post.read-time').replace('{minutes}', String(readMinutes))}</span>
								{isBot && (
									<span class="item-prov">
										<ProvenanceBadge authorship="bot" humanReviewed={true} lang={lang} variant="compact" />
										{reviewedAt && <> <time datetime={reviewedAt}>{formatPostDate(new Date(reviewedAt))}</time></>}
									</span>
								)}
							</p>
						)
					}
					{hasNote && !isCanonical && <p class="item-ko-only">{t('item.ko-only')}</p>}
				</header>

				<div class="article-canvas page-frame">
					<TableOfContents lang={lang} />
					<div class="article-main">
						{
							hasNote ? (
								<div class="prose" lang={contentLangAttr}>
									<slot />
								</div>
							) : (
								<p class="item-no-note">{t('item.no-note')}</p>
							)
						}

						{
							hasNote && isBot && sources.length > 0 && (
								<aside class="item-sources" aria-labelledby="item-sources-label">
									<p id="item-sources-label" class="item-sources-label">{t('item.sources.label')}</p>
									<ul>
										{sources.map((source) => (
											<li><a href={source} target="_blank" rel="noopener noreferrer">{sourceLabel(source)}</a></li>
										))}
									</ul>
								</aside>
							)
						}

						<aside class="item-original" aria-labelledby="item-original-label">
							<p id="item-original-label" class="item-original-label">{t('item.original.label')}</p>
							<div class="item-original-body">
								<p class="item-original-host">{host}<span class="item-original-kind"> · {getLibraryKindLabel(kind, lang)}</span></p>
								<a class="btn-pill item-original-link" href={url} target="_blank" rel="noopener noreferrer" aria-label={`${t('item.original.open')}: ${title}`}>
									{t('item.original.open')} <span aria-hidden="true">↗</span>
								</a>
							</div>
						</aside>

						<Backlinks links={backlinks} lang={lang} />

						{
							tags.length > 0 && (
								<ul class="article-tags item-tags" aria-label={t('item.tags')}>
									{tags.map((tag) => <li class="chip">{tag.replaceAll('-', ' ')}</li>)}
								</ul>
							)
						}
					</div>
				</div>
			</article>
		</main>
		<LinkPreview />
	</body>
</html>

<style is:global>
	.item-header {
		padding-bottom: 1.25rem;
	}

	/* The item's own preview image: a 2:1 frame at column width, no CLS (explicit
	   width/height on the img, fixed aspect ratio on the frame). */
	.item-image {
		display: block;
		overflow: hidden;
		aspect-ratio: 2 / 1;
		margin: 0 0 1.5rem;
		border: 1px solid var(--rule);
		border-radius: 6px;
		background: var(--paper-deep);
	}

	.item-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Without an image: the monogram tile of the item's area, as on its card. */
	.item-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		margin: 0 0 1.25rem;
		border: 1px solid var(--tint);
		border-radius: 10px;
		background: color-mix(in srgb, var(--tint) 20%, var(--paper-light));
		color: var(--ink);
		font: 500 1.75rem/1 var(--font-serif);
		letter-spacing: -0.01em;
	}

	.item-no-note {
		margin: 0;
		font: 400 0.9375rem/1.65 var(--font-sans);
		color: var(--secondary);
	}

	.item-eyebrow {
		margin: 0 0 0.9rem;
		font: 400 0.6875rem/1.5 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	/* The explainer's title scale: larger than any prose heading. */
	.article-header .item-title {
		margin: 0;
		font: 400 clamp(2rem, 1.4rem + 2.6vw, 3rem) / 1.2 var(--font-serif);
		letter-spacing: -0.01em;
	}

	.item-title:lang(ko) {
		word-break: keep-all;
	}

	.item-summary {
		max-width: 40rem;
		margin: 0.9rem 0 0;
		font: 400 0.9375rem/1.65 var(--font-sans);
		color: var(--secondary);
		text-wrap: pretty;
	}

	.item-summary-label {
		display: block;
		margin-bottom: 0.15rem;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.item-dates {
		margin: 1rem 0 0;
	}

	/* Bot-note sections (## 무엇인가 …) stay clearly below the page title. */
	.item-page .prose h2 {
		margin-top: 48px;
		font-size: clamp(1.375rem, 2.4vw, 1.625rem);
	}

	.item-sources {
		margin-top: 2.5rem;
	}

	.item-sources-label {
		margin: 0 0 0.5rem;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.item-sources ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.item-sources li {
		margin: 0.2rem 0;
		font: 400 0.75rem/1.6 var(--font-mono);
		overflow-wrap: anywhere;
	}

	.item-sources a {
		color: var(--secondary);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.item-sources a:hover,
	.item-sources a:focus-visible {
		color: var(--accent);
	}

	.item-ko-only {
		margin: 0.9rem 0 0;
		font: 400 0.75rem/1.6 var(--font-mono);
		letter-spacing: 0.06em;
		color: var(--secondary);
	}

	/* Original box: where the item itself lives. The only link out of the page. */
	.item-original {
		margin-top: 3rem;
		padding: 1.1rem 1.4rem;
		border: 1px solid var(--rule-strong);
		background: var(--paper-deep);
	}

	.item-original-label {
		margin: 0 0 0.6rem;
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.item-original-body {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1.5rem;
	}

	.item-original-host {
		flex: 1 1 12rem;
		margin: 0;
		font: 400 0.875rem/1.5 var(--font-mono);
		overflow-wrap: anywhere;
	}

	.item-original-kind {
		font-size: 0.6875rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.item-original-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.5rem;
		white-space: nowrap;
		text-decoration: none;
	}

	.item-original-link:hover,
	.item-original-link:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}

	.item-tags {
		margin-top: 1.75rem;
	}
</style>
