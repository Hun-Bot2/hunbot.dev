---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import FloatingLanguagePicker from '../components/FloatingLanguagePicker.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ReadingControls from '../components/ReadingControls.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import GiscusComments from '../components/GiscusComments.astro';
import FeedbackBox from '../components/FeedbackBox.astro';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';
import ViewCounter from '../components/ViewCounter.astro';
import { SITE_TITLE, AUTHOR, AUTHOR_EMAIL, SOCIAL_LINKS } from '../consts';
import { useTranslations, type UILanguage } from '../i18n/ui';
import { normalizeCategory } from '../utils/blog';
import { getBlogSlugFromId, getBlogUrlFromId } from '../utils/blog-routing';
import { blogHeroImageSizes, getResponsivePublicImage } from '../utils/responsive-public-images';
import '../styles/prose.css';

type Props = CollectionEntry<'blog'>['data'] & {
	lang?: UILanguage;
	availableLangs?: UILanguage[];
	postId?: string;
	readMinutes?: number;
	seriesName?: string;
	seriesIndex?: number;
	seriesTotal?: number;
	seriesPrev?: { title: string; url: string };
	seriesNext?: { title: string; url: string };
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	category,
	lang = 'ko',
	availableLangs,
	postId,
	readMinutes,
	seriesName,
	seriesIndex,
	seriesTotal,
	seriesPrev,
	seriesNext,
} = Astro.props as Props;

const slug = postId ?? Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const headingId = 'post-title';
const t = useTranslations(lang);
const categoryLabel = category ? t(`blog.category-${normalizeCategory(category)}` as Parameters<typeof t>[0]) : null;
const eyebrow = [
	categoryLabel,
	seriesName,
	readMinutes ? t('post.read-time').replace('{minutes}', String(readMinutes)) : null,
].filter(Boolean).join(' · ');
// Other-language versions of this post (availableLangs is keyed by slug, so the slug is shared).
const translations = postId
	? (availableLangs ?? []).filter((code) => code !== lang).map((code) => ({
			code,
			url: getBlogUrlFromId(`${code}/${getBlogSlugFromId(postId)}`),
		}))
	: [];
const responsiveHeroImage = heroImage ? getResponsivePublicImage(heroImage) : null;

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.href
  },
  "headline": title,
  "description": description,
	"image": heroImage ? new URL(heroImage, Astro.site).href : new URL('/placeholder-social.jpg', Astro.site).href,
  "datePublished": pubDate.toISOString(),
  "dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": AUTHOR,
    "url": new URL(Astro.url.origin).href,
    "email": AUTHOR_EMAIL,
    "sameAs": [
      SOCIAL_LINKS.github,
      SOCIAL_LINKS.linkedin
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_TITLE,
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/favicon.svg', Astro.site).href
    }
  }
};
---

<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			canonicalURL={canonicalURL.href}
			image={heroImage}
			lang={lang}
			availableLangs={availableLangs}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<!-- Essential SEO meta tags -->
		<meta property="og:type" content="article" />
		<meta property="article:author" content="Hun-Bot" />
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		{tags.map(tag => <meta property="article:tag" content={tag} />)}
		<meta data-pagefind-meta="title[content]" content={title} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="blog" />
		{category && <meta data-pagefind-filter="category[content]" content={category} />}
		{tags.map((tag) => <meta data-pagefind-filter="tag[content]" content={tag} />)}
	</head>

	<body>
		<Header />
		<FloatingLanguagePicker availableLangs={availableLangs} />
		<ReadingControls lang={lang} />
		<main
			id="main-content"
			class="article-page"
			data-post-lang={lang}
			data-available-langs={(availableLangs ?? [lang]).join(",")}
		>
			<div class="page-frame">
				<LanguageSuggestion />
			</div>
			<article aria-labelledby={headingId}>
				<header class="article-header page-frame">
					<Breadcrumb items={[
						{ name: t('nav.home'), href: `/${lang}/` },
						{ name: t('nav.blog'), href: `/${lang}/blog/` },
						{ name: title }
					]} />
					{eyebrow && <p class="eyebrow">{eyebrow}</p>}
					<h1 id={headingId} class="article-title" data-pagefind-body data-pagefind-meta="title">
						{title}
					</h1>
					{description && <p class="article-lead">{description}</p>}
					<div class="article-meta">
						<span>{t('blog.published')} <FormattedDate date={pubDate} /></span>
						{updatedDate && <span>{t('blog.updated')} <FormattedDate date={updatedDate} /></span>}
						<ViewCounter slug={slug} />
						{translations.length > 0 && (
							<span>
								{t('post.translations')}
								{translations.map((translation) => (
									<>
										{' '}
										<a href={translation.url} hreflang={translation.code === 'jp' ? 'ja' : translation.code}>{translation.code.toUpperCase()}</a>
									</>
								))}
							</span>
						)}
					</div>
					{tags.length > 0 && (
						<ul class="article-tags" aria-label="Tags">
							{tags.map((tag: string) => <li class="chip">{tag}</li>)}
						</ul>
					)}
				</header>

				{heroImage && responsiveHeroImage && (
					<figure class="article-hero page-frame">
						<picture>
							{responsiveHeroImage.webpSrcSet && (
								<source type="image/webp" srcset={responsiveHeroImage.webpSrcSet} sizes={blogHeroImageSizes} />
							)}
							<img
								src={responsiveHeroImage.src}
								alt={title}
								loading="eager"
								fetchpriority="high"
								decoding="async"
								width={responsiveHeroImage.width}
								height={responsiveHeroImage.height}
								sizes={blogHeroImageSizes}
							/>
						</picture>
						{(description || title) && <figcaption class="sr-only">{description || title}</figcaption>}
					</figure>
				)}

				<div class="article-canvas page-frame">
					<TableOfContents lang={lang} />
					<div class="article-main">
						<div class="prose" data-pagefind-body>
							<slot />
						</div>

						{seriesName && seriesIndex && seriesTotal && (
							<nav class="series-nav" aria-label={`${seriesName} ${seriesIndex} / ${seriesTotal}`}>
								<p class="eyebrow">{seriesName} · {seriesIndex} / {seriesTotal}</p>
								<div class="series-nav-links">
									{seriesPrev && (
										<a href={seriesPrev.url} class="series-nav-link">
											<span class="eyebrow"><span aria-hidden="true">← </span>{t('post.series-prev')}</span>
											<strong>{seriesPrev.title}</strong>
										</a>
									)}
									{seriesNext && (
										<a href={seriesNext.url} class="series-nav-link series-nav-link--next">
											<span class="eyebrow">{t('post.series-next')}<span aria-hidden="true"> →</span></span>
											<strong>{seriesNext.title}</strong>
										</a>
									)}
								</div>
							</nav>
						)}

						<GiscusComments lang={lang} />
						<FeedbackBox slug={slug} lang={lang} />
					</div>
				</div>
			</article>
		</main>
		<script type="module" src="/scripts/feedback-box.js"></script>
		<script type="module" src="/scripts/language-suggest.js"></script>
	</body>
</html>
