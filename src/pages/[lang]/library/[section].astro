---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FloatingLanguagePicker from '../../../components/FloatingLanguagePicker.astro';
import LibraryIcon from '../../../components/library/LibraryIcon.astro';
import LibraryPageStyles from '../../../components/library/LibraryPageStyles.astro';
import LibraryTabs from '../../../components/library/LibraryTabs.astro';
import PickCard from '../../../components/library/PickCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../../i18n/ui';
import { decks } from '../../../data/decks';
import { getAspectRatioValue } from '../../../lib/decks/validateDeckMeta';
import { librarySections as pickLibrarySections, isLibrarySectionSlug } from '../../../data/librarySections';
import { pickTiers } from '../../../data/libraryPolicy';
import { computePickTier, getPickSectionCounts, type PopularitySnapshot } from '../../../utils/picks';
import { sortStable } from '../../../utils/ordering';
import popularity from '../../../data/popularity.json';

export function getStaticPaths() {
	const languages: UILanguage[] = ['ko', 'jp', 'en'];
	// 'decks' is not one of the seven pick sections in src/data/librarySections.ts.
	// It is the temporary carry-over from the old resources-backed Library
	// (docs/decisions/site-structure.md#2) — kept here, rendering exactly as
	// before, until the decks commit moves it to /{lang}/research/decks/.
	const sectionSlugs = [...pickLibrarySections.map((section) => section.slug), 'decks'];
	return languages.flatMap((lang) => sectionSlugs.map((section) => ({ params: { lang, section } })));
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const sectionParam = Astro.params.section;
const t = useTranslations(lang);

// Moves to /{lang}/research/decks/ in the decks commit.
const isDecksSection = sectionParam === 'decks';

if (!isDecksSection && !isLibrarySectionSlug(sectionParam)) {
	throw new Error(`Unknown Library section: ${sectionParam}`);
}

const libraryUrl = `/${lang}/library/`;

const panelClass = 'library-panel';
const panelDividerClass = 'library-panel-footer';
const subtlePillClass = 'library-pill';
const actionLinkClass = 'library-action';
const backActionClass = `${actionLinkClass} library-action--back`;
const externalActionClass = `${actionLinkClass} library-action--external`;
const deckActionClass = `${actionLinkClass} library-action--deck`;
const downloadActionClass = `${actionLinkClass} library-action--download`;
const formatCount = (count: number) => t('library.item-count').replace('{count}', String(count));

// ---------------------------------------------------------------------------
// Decks branch — unchanged from before this restructure. Decks were always a
// resources-free section (sectionMeta.kind === 'decks' never had a resources
// list), so dropping the old resources-section logic changes nothing here.
// ---------------------------------------------------------------------------
const sectionDecks = isDecksSection ? decks : [];
const highlightedDeck = sectionDecks.find((deck) => deck.id === 'akiya-ai-paperwork-local-jobs-ko');
const highlightedDeckUrl = highlightedDeck?.htmlUrl ?? highlightedDeck?.pdfUrl ?? null;
const highlightedDeckSlides = highlightedDeck?.slides ?? [];
const highlightedDeckPreviewUrl = highlightedDeckSlides[0] ?? highlightedDeck?.htmlUrl ?? highlightedDeck?.pdfUrl ?? null;
const highlightedDeckSlidesJson = JSON.stringify(highlightedDeckSlides);
const highlightedDeckAspectRatio = highlightedDeck ? getAspectRatioValue(highlightedDeck.aspectRatio) : '16 / 9';
const highlightedDeckSlideCount = highlightedDeckSlides.length;
const showHighlightedDeckControls = highlightedDeckSlideCount > 1;
const highlightedDeckActionLabel = highlightedDeck?.htmlUrl ? t('library.view-deck') : t('library.open-pdf');
const highlightedDeckLanguageLabel = highlightedDeck
	? t(`library.deck.language.${highlightedDeck.language}` as Parameters<typeof t>[0])
	: null;
const itemCount = sectionDecks.length;
const formatSlideCount = (count: number) => t('library.deck.slides-count').replace('{count}', String(count));

// ---------------------------------------------------------------------------
// Pick section branch — the new 외부 링크 tab content, filtered to this
// section (docs/decisions/site-structure.md#3,5).
// ---------------------------------------------------------------------------
const pickSection = isDecksSection ? null : pickLibrarySections.find((section) => section.slug === sectionParam)!;

let visibleSections: { slug: string; label: Record<UILanguage, string>; count: number }[] = [];
let totalPickCount = 0;
let tierGroups: { tier: (typeof pickTiers)[number]; picks: Awaited<ReturnType<typeof getCollection<'picks'>>> }[] = [];

if (!isDecksSection) {
	const allPicks = await getCollection('picks');
	const publishedPicks = allPicks.filter((pick) => pick.data.draft !== true);
	totalPickCount = publishedPicks.length;

	const sectionCounts = getPickSectionCounts(publishedPicks);
	visibleSections = pickLibrarySections
		.map((section) => ({ slug: section.slug, label: section.label, count: sectionCounts.get(section.slug) ?? 0 }))
		.filter((section) => section.count > 0);

	const picksInSection = publishedPicks.filter((pick) => pick.data.section === sectionParam);
	tierGroups = pickTiers
		.map((tier) => ({
			tier,
			picks: sortStable(
				picksInSection.filter(
					(pick) => computePickTier(pick.data, popularity as PopularitySnapshot, pickTiers).tier === tier.id,
				),
				(a, b) => a.data.title.localeCompare(b.data.title),
			),
		}))
		.filter((group) => group.picks.length > 0);
}

const sectionTitle = isDecksSection ? t('library.section.decks.title') : (pickSection?.label[lang] ?? '');
const sectionDescription = isDecksSection ? t('library.section.decks.description') : (pickSection?.description[lang] ?? '');
const title = `${sectionTitle} - ${t('library.title')} - Hun-Bot Blog`;
const description = sectionDescription;
const now = new Date();
const chipAllLabel = t('library.chip.all').replace('{count}', String(totalPickCount));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<LibraryPageStyles />
		<meta data-pagefind-meta="title[content]" content={`${t('library.title')} - ${sectionTitle}`} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="library" />
		<meta data-pagefind-filter="library-section[content]" content={sectionParam} />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="library-page mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8" data-pagefind-body>
			<section class="mb-8 max-w-5xl space-y-3">
				<a href={libraryUrl} class={backActionClass}>
					<LibraryIcon name="arrow-left" />
					{t('library.back-to-library')}
				</a>
				<div class="space-y-2">
					<h1 class="text-4xl font-bold tracking-normal text-slate-100 sm:text-5xl">{sectionTitle}</h1>
					<p class="text-xl leading-relaxed text-slate-300">{sectionDescription}</p>
					{isDecksSection && <p class="leading-relaxed text-slate-400">{formatCount(itemCount)}</p>}
				</div>
				{!isDecksSection && <LibraryTabs lang={lang} active="external-links" />}
			</section>

			{!isDecksSection && (
				<section class="mb-8 space-y-3" aria-label={chipAllLabel}>
					<div class="flex flex-wrap gap-2">
						<a href={libraryUrl} class="library-chip">
							{chipAllLabel}
						</a>
						{visibleSections.map((section) => (
							<a
								href={`/${lang}/library/${section.slug}/`}
								class="library-chip"
								aria-current={section.slug === sectionParam ? 'page' : undefined}
							>
								{section.label[lang]} {section.count}
							</a>
						))}
					</div>
				</section>
			)}

			{isDecksSection && sectionDecks.length > 0 && (
				<section class="mb-10 space-y-4" aria-labelledby="section-decks-heading">
					<h2 id="section-decks-heading" class="text-2xl font-bold text-slate-100">
						{t('library.section.deck-heading')}
					</h2>
					{highlightedDeck && (
						<article
							class={`${panelClass} library-latest-deck-card`}
							style={`--library-latest-deck-ratio: ${highlightedDeckAspectRatio};`}
							data-slide-deck-root
						>
							<div class="library-latest-deck-header">
								<div>
									<div class="mb-3 flex flex-wrap gap-2">
										<span class={subtlePillClass}>{t('library.latest-deck')}</span>
										<span class={subtlePillClass}>{highlightedDeck.type.toUpperCase()}</span>
										{highlightedDeckLanguageLabel && (
											<span class={subtlePillClass}>{highlightedDeckLanguageLabel}</span>
										)}
									</div>
									<h3 class="text-xl font-semibold text-slate-100">{t('library.latest-deck.item.title')}</h3>
								</div>
								{highlightedDeckUrl && (
									<a
										href={highlightedDeckUrl}
										target="_blank"
										rel="noopener noreferrer"
										class={externalActionClass}
									>
										{highlightedDeckActionLabel}
										<LibraryIcon name={highlightedDeck.htmlUrl ? 'arrow-right' : 'external'} />
									</a>
								)}
							</div>
							{highlightedDeckPreviewUrl && (
								<div
									class="library-deck-preview"
									data-slide-deck-viewer
									data-slide-list={highlightedDeckSlidesJson}
								>
									<img
										src={highlightedDeckPreviewUrl}
										alt={t('library.latest-deck.preview-title')}
										loading="lazy"
										decoding="async"
										data-slide-deck-image
									/>
								</div>
							)}
							{showHighlightedDeckControls && (
								<div class="library-deck-controls" aria-label={t('library.deck.controls-label')}>
									<button
										type="button"
										class="library-deck-control"
										aria-label={t('library.deck.previous-slide')}
										data-slide-deck-prev
										disabled
									>
										<LibraryIcon name="arrow-left" />
									</button>
									<span class="library-deck-counter" data-slide-deck-counter aria-live="polite">
										1 / {highlightedDeckSlideCount}
									</span>
									<button
										type="button"
										class="library-deck-control"
										aria-label={t('library.deck.next-slide')}
										data-slide-deck-next
									>
										<LibraryIcon name="arrow-right" />
									</button>
								</div>
							)}
							<div class="library-latest-deck-actions">
								<p class="max-w-3xl text-sm leading-relaxed text-slate-400">
									{t('library.latest-deck.item.description')}
								</p>
							</div>
						</article>
					)}
					<div class="grid gap-4 lg:grid-cols-3">
						{sectionDecks.map((deck) => {
							const primaryDeckUrl = deck.htmlUrl ?? deck.pdfUrl;
							const showSource = deck.pptxUrl && deck.sourceAvailable && deck.sourceReviewed;
							const availability = [
								deck.htmlUrl ? t('library.deck.html-available') : null,
								deck.pdfUrl ? t('library.deck.pdf-available') : null,
								deck.slides.length > 0 ? formatSlideCount(deck.slides.length) : null,
								showSource ? t('library.deck.source-reviewed') : null,
							].filter((item): item is string => Boolean(item));

							return (
								<article class={panelClass}>
									<div class="mb-3 flex flex-wrap gap-2">
										<span class={subtlePillClass}>
											{t('library.deck-type')}: {deck.type}
										</span>
										<span class={subtlePillClass}>{deck.aspectRatio}</span>
									</div>
									<h3 class="mb-3 text-lg font-semibold text-slate-100">{deck.title}</h3>
									<p class="mb-5 text-sm leading-relaxed text-slate-400">{deck.description}</p>
									{availability.length > 0 && (
										<div class="mb-5 flex flex-wrap gap-2">
											{availability.map((item) => <span class={subtlePillClass}>{item}</span>)}
										</div>
									)}
									<div class="flex flex-wrap gap-2">
										{primaryDeckUrl && (
											<a
												href={primaryDeckUrl}
												target="_blank"
												rel="noopener noreferrer"
												class={deck.htmlUrl ? deckActionClass : externalActionClass}
											>
												{deck.htmlUrl ? t('library.view-deck') : t('library.open-pdf')}
												<LibraryIcon name={deck.htmlUrl ? 'arrow-right' : 'external'} />
											</a>
										)}
										{showSource && (
											<a
												href={deck.pptxUrl}
												target="_blank"
												rel="noopener noreferrer"
												class={downloadActionClass}
											>
												{t('library.download-source')}
												<LibraryIcon name="download" />
											</a>
										)}
									</div>
								</article>
							);
						})}
					</div>
				</section>
			)}

			{isDecksSection && itemCount === 0 && (
				<section class={`${panelClass} mb-10`}>
					<h2 class="text-xl font-bold text-slate-100">{t('library.section.empty.title')}</h2>
					<p class="mt-2 leading-relaxed text-slate-400">{t('library.section.empty.body')}</p>
				</section>
			)}

			{!isDecksSection && (
				tierGroups.length === 0 ? (
					<section class={`${panelClass} mb-10`}>
						<p class="text-slate-400">{t('library.section.pick-empty')}</p>
					</section>
				) : (
					tierGroups.map((group) => (
						<section class="mb-10 space-y-4" aria-labelledby={`library-tier-${group.tier.id}-heading`}>
							<div>
								<h2 id={`library-tier-${group.tier.id}-heading`} class="text-2xl font-bold text-slate-100">
									{group.tier.label[lang]}
								</h2>
								<p class="mt-1 text-slate-400">{group.tier.description[lang]}</p>
							</div>
							<div class="grid gap-4 lg:grid-cols-3">
								{group.picks.map((pick) => <PickCard pick={pick} lang={lang} now={now} showSection={false} />)}
							</div>
						</section>
					))
				)
			)}
		</main>
		{isDecksSection && (
			<script is:inline>
				for (const viewer of document.querySelectorAll('[data-slide-deck-viewer]')) {
					let slides = [];

					try {
						slides = JSON.parse(viewer.getAttribute('data-slide-list') || '[]');
					} catch {
						slides = [];
					}

					const image = viewer.querySelector('[data-slide-deck-image]');
					const root = viewer.closest('[data-slide-deck-root]');
					const prev = root?.querySelector('[data-slide-deck-prev]');
					const next = root?.querySelector('[data-slide-deck-next]');
					const counter = root?.querySelector('[data-slide-deck-counter]');

					if (!image || !Array.isArray(slides) || slides.length < 2) {
						continue;
					}

					let index = 0;

					function preloadSlide(nextIndex) {
						if (!slides[nextIndex]) return;
						const preload = new Image();
						preload.src = slides[nextIndex];
					}

					function updateDeckSlide(nextIndex) {
						index = Math.min(Math.max(nextIndex, 0), slides.length - 1);
						image.src = slides[index];

						if (counter) {
							counter.textContent = `${index + 1} / ${slides.length}`;
						}

						if (prev) {
							prev.disabled = index === 0;
						}

						if (next) {
							next.disabled = index === slides.length - 1;
						}

						preloadSlide(index - 1);
						preloadSlide(index + 1);
					}

					prev?.addEventListener('click', () => updateDeckSlide(index - 1));
					next?.addEventListener('click', () => updateDeckSlide(index + 1));
					updateDeckSlide(0);
				}
			</script>
		)}
		<Footer />
	</body>
</html>
