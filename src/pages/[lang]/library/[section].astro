---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FloatingLanguagePicker from '../../../components/FloatingLanguagePicker.astro';
import LibraryIcon from '../../../components/library/LibraryIcon.astro';
import LibraryPageStyles from '../../../components/library/LibraryPageStyles.astro';
import LibraryTabs from '../../../components/library/LibraryTabs.astro';
import PickCard from '../../../components/library/PickCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../../i18n/ui';
import { librarySections as pickLibrarySections, isLibrarySectionSlug } from '../../../data/librarySections';
import { pickTiers } from '../../../data/libraryPolicy';
import { computePickTier, getPickSectionCounts, type PopularitySnapshot } from '../../../utils/picks';
import { sortStable } from '../../../utils/ordering';
import popularity from '../../../data/popularity.json';

export function getStaticPaths() {
	const languages: UILanguage[] = ['ko', 'jp', 'en'];
	return languages.flatMap((lang) => pickLibrarySections.map((section) => ({ params: { lang, section: section.slug } })));
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const sectionParam = Astro.params.section;
const t = useTranslations(lang);

if (!isLibrarySectionSlug(sectionParam)) {
	throw new Error(`Unknown Library section: ${sectionParam}`);
}

const libraryUrl = `/${lang}/library/`;

const actionLinkClass = 'library-action';
const backActionClass = `${actionLinkClass} library-action--back`;

// ---------------------------------------------------------------------------
// Pick section branch — the 외부 링크 tab content, filtered to this
// section (docs/decisions/site-structure.md#3,5).
// ---------------------------------------------------------------------------
const pickSection = pickLibrarySections.find((section) => section.slug === sectionParam)!;

const allPicks = await getCollection('picks');
const publishedPicks = allPicks.filter((pick) => pick.data.draft !== true);
const totalPickCount = publishedPicks.length;

const sectionCounts = getPickSectionCounts(publishedPicks);
const visibleSections = pickLibrarySections
	.map((section) => ({ slug: section.slug, label: section.label, count: sectionCounts.get(section.slug) ?? 0 }))
	.filter((section) => section.count > 0);

const picksInSection = publishedPicks.filter((pick) => pick.data.section === sectionParam);
const tierGroups = pickTiers
	.map((tier) => ({
		tier,
		picks: sortStable(
			picksInSection.filter(
				(pick) => computePickTier(pick.data, popularity as PopularitySnapshot, pickTiers).tier === tier.id,
			),
			(a, b) => a.data.title.localeCompare(b.data.title),
		),
	}))
	.filter((group) => group.picks.length > 0);

const sectionTitle = pickSection.label[lang] ?? '';
const sectionDescription = pickSection.description[lang] ?? '';
const title = `${sectionTitle} - ${t('library.title')} - Hun-Bot Blog`;
const description = sectionDescription;
const now = new Date();
const chipAllLabel = t('library.chip.all').replace('{count}', String(totalPickCount));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<LibraryPageStyles />
		<meta data-pagefind-meta="title[content]" content={`${t('library.title')} - ${sectionTitle}`} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="library" />
		<meta data-pagefind-filter="library-section[content]" content={sectionParam} />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="library-page mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8" data-pagefind-body>
			<section class="mb-8 max-w-5xl space-y-3">
				<a href={libraryUrl} class={backActionClass}>
					<LibraryIcon name="arrow-left" />
					{t('library.back-to-library')}
				</a>
				<div class="space-y-2">
					<h1 class="text-4xl font-bold tracking-normal text-slate-100 sm:text-5xl">{sectionTitle}</h1>
					<p class="text-xl leading-relaxed text-slate-300">{sectionDescription}</p>
				</div>
				<LibraryTabs lang={lang} active="external-links" />
			</section>

			<section class="mb-8 space-y-3" aria-label={chipAllLabel}>
				<div class="flex flex-wrap gap-2">
					<a href={libraryUrl} class="library-chip">
						{chipAllLabel}
					</a>
					{visibleSections.map((section) => (
						<a
							href={`/${lang}/library/${section.slug}/`}
							class="library-chip"
							aria-current={section.slug === sectionParam ? 'page' : undefined}
						>
							{section.label[lang]} {section.count}
						</a>
					))}
				</div>
			</section>

			{tierGroups.length === 0 ? (
				<section class="library-panel mb-10">
					<p class="text-slate-400">{t('library.section.pick-empty')}</p>
				</section>
			) : (
				tierGroups.map((group) => (
					<section class="mb-10 space-y-4" aria-labelledby={`library-tier-${group.tier.id}-heading`}>
						<div>
							<h2 id={`library-tier-${group.tier.id}-heading`} class="text-2xl font-bold text-slate-100">
								{group.tier.label[lang]}
							</h2>
							<p class="mt-1 text-slate-400">{group.tier.description[lang]}</p>
						</div>
						<div class="grid gap-4 lg:grid-cols-3">
							{group.picks.map((pick) => <PickCard pick={pick} lang={lang} now={now} showSection={false} />)}
						</div>
					</section>
				))
			)}
		</main>
		<Footer />
	</body>
</html>
