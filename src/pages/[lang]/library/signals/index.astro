---
// /{lang}/library/signals/ — the 신호 view (docs/decisions/site-structure.md,
// Revision 2026-10-23; docs/features/signals-and-weekly.md): a dated ledger of
// what passed the owner's filter, newest first, grouped by the day it was kept
// with the date in the left margin like a notebook note. Each row shows the
// owner's verdict as a stamp, the reason it was kept, and where it led.
// Generated only while at least one signal is published; with none, the tab is
// not shown either. The text is Korean on every language's page: jp/en are the
// same list under that language's chrome, noindex, canonical to the ko page.
// No autonomous motion on this view.
import BaseHead from '../../../../components/BaseHead.astro';
import Header from '../../../../components/Header.astro';
import FloatingLanguagePicker from '../../../../components/FloatingLanguagePicker.astro';
import BlogFilterBar from '../../../../components/blog/BlogFilterBar.astro';
import LibraryMasthead from '../../../../components/library/LibraryMasthead.astro';
import LibraryTabs from '../../../../components/library/LibraryTabs.astro';
import SignalRow from '../../../../components/library/SignalRow.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../../../i18n/ui';
import { getLibraryViewData } from '../../../../utils/library-views';
import { getPublishedSignals, getSignalLineage, getSignalSlug, getSignalsUrl, groupSignalsByDay, signalVerdicts } from '../../../../utils/signals';
import '../../../../styles/lists.css';

export async function getStaticPaths() {
	const langs: UILanguage[] = ['ko', 'jp', 'en'];
	const published = getPublishedSignals(await getCollection('signals'));
	return published.length > 0 ? langs.map((lang) => ({ params: { lang } })) : [];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
// A dynamic UI key; kept out of the template, where `as` casts do not parse.
const tk = (key: string) => t(key as Parameters<typeof t>[0]);
const view = await getLibraryViewData(lang);
const isCanonical = lang === 'ko';
const canonicalURL = new URL(getSignalsUrl('ko'), Astro.site);
const title = `${t('signals.title')} - ${t('library.title')} - Hun-Bot Blog`;
const description = t('signals.description');

const days = groupSignalsByDay(view.signals);
const verdictOptions = signalVerdicts
	.map((verdict) => ({
		value: verdict,
		label: tk(`signal.verdict.${verdict}`),
		count: view.signals.filter((signal) => signal.data.verdict === verdict).length,
	}))
	.filter((option) => option.count > 0);
const filterGroups = [{ facet: 'verdict', label: t('signal.filter-verdict'), options: verdictOptions }];
const dayLabel = (day: string) => day.replaceAll('-', '.');
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} canonicalURL={canonicalURL.href} lang={lang} availableLangs={['ko']} />
		{!isCanonical && <meta name="robots" content="noindex, follow" />}
		<meta data-pagefind-meta="title[content]" content={t('signals.title')} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content="ko" />
		<meta data-pagefind-filter="section[content]" content="library" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker belowTabs />
		<main id="main-content" class="atelier-page" data-pagefind-body={isCanonical ? true : undefined}>
			<LibraryMasthead lang={lang} description={description} />
			<LibraryTabs lang={lang} tabs={view.tabs} current="signals" reserveFilter />

			<BlogFilterBar
				lang={lang}
				groups={filterGroups}
				storageKey="hunbot-signal-filters"
				resultsTemplate={t('signal.filter-results')}
				label={t('library.filter-label')}
				totalCount={view.signals.length}
				anchor="tabs"
			/>

			<div class="page-frame signal-ledger" data-blog-posts>
				{
					days.map(({ day, signals }) => (
						<section class="signal-day" aria-labelledby={`signal-day-${day}`} data-filter-section>
							<h2 class="signal-day-date" id={`signal-day-${day}`}>
								<time datetime={day}>{dayLabel(day)}</time>
							</h2>
							<ul class="signal-list">
								{signals.map((signal) => (
									<SignalRow
										signal={signal}
										lineage={getSignalLineage(getSignalSlug(signal), view.explainers, view.posts)}
										lang={lang}
									/>
								))}
							</ul>
						</section>
					))
				}
			</div>

			<div class="page-frame" data-blog-empty hidden><p class="signal-empty">{t('signal.filter-no-results')}</p></div>
		</main>
		<script type="module" src="/scripts/blog-filters.js"></script>
	</body>
</html>

<style>


	.signal-empty {
		margin: 1rem 0 3rem;
		font: 400 0.875rem/1.6 var(--font-sans);
		color: var(--secondary);
	}

	.signal-ledger {
		padding: 0.5rem 0 1rem;
	}

	/* One day = a margin note (the date) beside that day's rows. The hairline
	   between them is the notebook's margin rule. */
	.signal-day {
		display: grid;
		grid-template-columns: 7rem minmax(0, 1fr);
		border-top: 1px solid var(--rule-strong);
	}

	.signal-day[hidden] {
		display: none;
	}

	.signal-day-date {
		margin: 0;
		padding: 1rem 1rem 0 0;
		border-right: 1px solid var(--rule);
		font: 400 0.75rem/1.5 var(--font-mono);
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
		color: var(--secondary);
	}

	.signal-day-date time {
		position: sticky;
		top: calc(var(--header-height) + 1rem);
		display: block;
	}

	.signal-list {
		margin: 0;
		padding: 0 0 0.5rem 1.25rem;
		list-style: none;
	}

	.signal-list > :global(.signal:first-child) {
		padding-top: 0.9rem;
	}

	@media (max-width: 639px) {
		.signal-day {
			grid-template-columns: minmax(0, 1fr);
		}

		.signal-day-date {
			padding: 0.8rem 0 0;
			border-right: 0;
		}

		.signal-day-date time {
			position: static;
		}

		.signal-list {
			padding-left: 0;
		}
	}
</style>
