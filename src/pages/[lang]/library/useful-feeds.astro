---
// Useful Feeds tab (docs/decisions/site-structure.md#3): the existing
// `resources` collection, now holding only items the owner hand-selected in
// the private research-os. Items render exactly as delivered — title,
// source, date, link, and a summary only if the item already carries
// one — this page must never enrich, summarize, or translate them. This URL
// used to be the empty "useful-feeds" Library section page; it is now this
// standalone tab, so no redirect is needed.
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FloatingLanguagePicker from '../../../components/FloatingLanguagePicker.astro';
import LibraryIcon from '../../../components/library/LibraryIcon.astro';
import LibraryPageStyles from '../../../components/library/LibraryPageStyles.astro';
import LibraryTabs from '../../../components/library/LibraryTabs.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../../i18n/ui';
import { getUsefulFeedItems } from '../../../utils/library';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = `${t('library.tab.useful-feeds')} - ${t('library.title')} - Hun-Bot Blog`;
const description = t('library.useful-feeds.intro');

const allResources = await getCollection('resources');
const items = getUsefulFeedItems(allResources, lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<LibraryPageStyles />
		<meta data-pagefind-meta="title[content]" content={`${t('library.title')} - ${t('library.tab.useful-feeds')}`} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="library" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="atelier-page" data-pagefind-body>
			<section class="subpage-intro">
				<h1 class="eyebrow">{t('library.useful-feeds.title')}</h1>
				<p class="intro-copy">{t('library.useful-feeds.intro')}</p>
				<LibraryTabs lang={lang} active="useful-feeds" />
			</section>

			<div class="page-frame">
				{items.length === 0 ? (
					<p class="empty-line">{t('library.useful-feeds.empty')}</p>
				) : (
					<section class="research-section" aria-label={t('library.tab.useful-feeds')}>
						<ul class="atelier-rows">
							{items.map((item) => (
								<li class="atelier-row feed-row">
									<div class="atelier-row-head">
										<h3>
											<a href={item.url} target="_blank" rel="noopener noreferrer">
												{item.title}
												<LibraryIcon name="external" />
											</a>
										</h3>
										<span class="feed-source">{item.source} · {item.date}</span>
									</div>
									{item.summary && <p class="atelier-row-note">{item.summary}</p>}
								</li>
							))}
						</ul>
					</section>
				)}
			</div>
		</main>
		<Footer />
	</body>
</html>
