---
// /{lang}/library/explainers/ — the 해설 view (docs/decisions/site-structure.md,
// Revision 2026-10-23; docs/features/explainers.md): published explainers,
// newest first, each an ExplainerRow. Generated only while at least one
// explainer is published. The text is Korean on every language's page: jp/en
// are the same list under that language's chrome, noindex, canonical to ko.
import BaseHead from '../../../../components/BaseHead.astro';
import Header from '../../../../components/Header.astro';
import FloatingLanguagePicker from '../../../../components/FloatingLanguagePicker.astro';
import LibraryMasthead from '../../../../components/library/LibraryMasthead.astro';
import LibraryTabs from '../../../../components/library/LibraryTabs.astro';
import ExplainerRow from '../../../../components/library/ExplainerRow.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../../../i18n/ui';
import { getExplainersIndexUrl, getPublishedExplainers } from '../../../../utils/explainers';
import { getLibraryItems } from '../../../../utils/library';
import { getLibraryViewData } from '../../../../utils/library-views';
import '../../../../styles/lists.css';
import '../../../../styles/entry-list.css';

export async function getStaticPaths() {
	const langs: UILanguage[] = ['ko', 'jp', 'en'];
	const published = getPublishedExplainers(await getCollection('explainers'));
	return published.length > 0 ? langs.map((lang) => ({ params: { lang } })) : [];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const view = await getLibraryViewData(lang);
const isCanonical = lang === 'ko';
const canonicalURL = new URL(getExplainersIndexUrl('ko'), Astro.site);
const title = `${t('library.explainers.title')} - ${t('library.title')} - Hun-Bot Blog`;
const description = t('library.explainers.description');
// Only the explainer rows: getLibraryItems builds the same items the row expects.
const items = getLibraryItems([], [], lang, view.explainers);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} canonicalURL={canonicalURL.href} lang={lang} availableLangs={['ko']} />
		{!isCanonical && <meta name="robots" content="noindex, follow" />}
		<meta data-pagefind-meta="title[content]" content={t('library.explainers.title')} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content="ko" />
		<meta data-pagefind-filter="section[content]" content="library" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker belowTabs />
		<main id="main-content" class="atelier-page" data-pagefind-body={isCanonical ? true : undefined}>
			<LibraryMasthead lang={lang} description={description} />
			<LibraryTabs lang={lang} tabs={view.tabs} current="explainers" />

			<div class="page-frame library-archive">
				<ul class="entry-list">
					{items.map((item) => <ExplainerRow item={item} lang={lang} />)}
				</ul>
			</div>
		</main>
	</body>
</html>

<style>


	.library-archive {
		padding: 0.5rem 0 4rem;
	}
</style>
