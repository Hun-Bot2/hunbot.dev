---
// /{lang}/library/item/{id}/ — the owner's note about one 자료 item. Generated
// only for items that have a note (src/utils/item-notes.ts: a published
// `itemNotes` entry, or a pick whose Markdown body is its own note); an item
// without one has no page and keeps opening the original. The note is Korean;
// the ja and en routes show it under that language's chrome, noindex, canonical
// to the Korean page (docs/decisions/site-structure.md, Revision 2026-10-23b).
import { getCollection, render, type CollectionEntry } from 'astro:content';
import LibraryItemPost from '../../../../layouts/LibraryItemPost.astro';
import type { UILanguage } from '../../../../i18n/ui';
import { getBacklinksFor } from '../../../../utils/backlinks-sources';
import { estimateReadTime, estimateWordCount } from '../../../../utils/blog';
import { buildItemNoteIndex, getItemUrl, type ItemNote } from '../../../../utils/item-notes';
import { getLibraryItems } from '../../../../utils/library';
import { getPickSlug } from '../../../../utils/picks';

export async function getStaticPaths() {
	const langs: UILanguage[] = ['ko', 'jp', 'en'];
	const [resources, picks, notes] = await Promise.all([getCollection('resources'), getCollection('picks'), getCollection('itemNotes')]);
	const index = buildItemNoteIndex({ notes, picks, resources, pickSlug: getPickSlug });
	const entryFor = (pageId: string, origin: 'note' | 'pick'): CollectionEntry<'itemNotes'> | CollectionEntry<'picks'> =>
		origin === 'pick'
			? picks.find((pick) => getPickSlug(pick.id) === pageId)!
			: notes.find((note) => note.data.about.endsWith(`:${pageId}`) && note.data.draft !== true)!;

	return langs.flatMap((lang) =>
		[...index.values()].map((note) => ({
			params: { lang, id: note.pageId },
			props: { entry: entryFor(note.pageId, note.origin), note },
		})),
	);
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const { entry, note } = Astro.props as {
	entry: CollectionEntry<'itemNotes'> | CollectionEntry<'picks'>;
	note: ItemNote;
};
const { Content } = await render(entry);

const [resources, picks] = await Promise.all([getCollection('resources'), getCollection('picks')]);
const item = getLibraryItems(resources, picks, lang, [], new Map([[note.pageId, note]])).find((candidate) => candidate.note?.pageId === note.pageId)!;
const resource = note.ref.kind === 'resource' ? resources.find((candidate) => candidate.data.id === note.pageId) : undefined;
// An image on the item page only when the license allows republishing it.
const image = resource?.data.license.canRepublishAssets && item.image.kind !== 'typographic' ? item.image : null;

const backlinks = await getBacklinksFor(
	{ selfKey: `note:${note.pageId}`, paths: [getItemUrl('ko', note.pageId)], externalUrl: item.url },
	lang,
);
---

<LibraryItemPost
	lang={lang}
	pageId={note.pageId}
	title={item.title}
	url={item.url}
	kind={item.kind}
	area={item.area}
	topic={item.topic}
	description={item.description}
	writtenAt={note.writtenAt}
	updatedAt={note.updatedAt}
	readMinutes={estimateReadTime(estimateWordCount(note.body))}
	tags={note.tags}
	image={image}
	backlinks={backlinks}
>
	<Content />
</LibraryItemPost>
