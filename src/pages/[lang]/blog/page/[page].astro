---
import BaseHead from '../../../../components/BaseHead.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import FloatingLanguagePicker from '../../../../components/FloatingLanguagePicker.astro';
import PaginationNav from '../../../../components/blog/PaginationNav.astro';
import PostListCard from '../../../../components/blog/PostListCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../../../i18n/ui';
import {
	getBlogPageUrl,
	getPaginatedPosts,
	getPostsByLanguage,
	getTotalBlogPages,
} from '../../../../utils/blog';

export async function getStaticPaths() {
	const languages: UILanguage[] = ['ko', 'jp', 'en'];
	const allPosts = await getCollection('blog');

	return languages.flatMap((lang) => {
		const posts = getPostsByLanguage(allPosts, lang);
		const totalPages = getTotalBlogPages(posts);

		return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
			params: { lang, page: String(index + 2) },
		}));
	});
}

const { lang, page } = Astro.params;
const currentLang = lang as UILanguage;
const currentPage = Number(page);
const t = useTranslations(currentLang);

if (!Number.isInteger(currentPage) || currentPage < 2) {
	throw new Error(`Invalid blog page route: ${page}`);
}

const allPosts = await getCollection('blog');
const allLanguagePosts = getPostsByLanguage(allPosts, currentLang);
const totalPages = getTotalBlogPages(allLanguagePosts);

if (currentPage > totalPages) {
	throw new Error(`Blog page ${currentPage} exceeds total pages ${totalPages} for ${currentLang}.`);
}

const posts = getPaginatedPosts(allLanguagePosts, currentPage);
const title = `${t('blog.all-posts')} - ${currentPage}`;
const description = t('blog.pagination-status')
	.replace('{current}', String(currentPage))
	.replace('{total}', String(totalPages));
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			lang={currentLang}
			canonicalURL={new URL(getBlogPageUrl(currentLang, currentPage), Astro.site).href}
		/>
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="max-w-4xl mx-auto px-6 py-8">
			<h1 class="text-3xl font-bold mb-2">{t('blog.all-posts')}</h1>
			<p class="mb-8 text-sm font-medium text-slate-400">{description}</p>
			<div class="space-y-4">
				{posts.map((post) => <PostListCard post={post} />)}
			</div>
			<PaginationNav lang={currentLang} currentPage={currentPage} totalPages={totalPages} />
		</main>
		<Footer />
	</body>
</html>
