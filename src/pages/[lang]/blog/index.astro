---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FloatingLanguagePicker from '../../../components/FloatingLanguagePicker.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import PaginationNav from '../../../components/blog/PaginationNav.astro';
import { useTranslations, type UILanguage } from '../../../i18n/ui';
import { getBlogUrlFromId } from '../../../utils/blog-routing';
import { getPaginatedPosts, getPostsByLanguage, getTotalBlogPages } from '../../../utils/blog';

export function getStaticPaths() {
  const langs = ['ko', 'jp', 'en'];
  return langs.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = lang as UILanguage;
const t = useTranslations(currentLang);

const allPosts = await getCollection('blog');
const allLanguagePosts = getPostsByLanguage(allPosts, currentLang);
const currentPage = 1;
const totalPages = getTotalBlogPages(allLanguagePosts);
const posts = getPaginatedPosts(allLanguagePosts, currentPage);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t('nav.blog')} description={t('blog.all-posts')} />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main class="max-w-4xl mx-auto px-6 py-8">
			<h1 class="text-3xl font-bold mb-8">{t('blog.all-posts')}</h1>
			<div class="space-y-8">
				{posts.map((post) => {
					const postUrl = getBlogUrlFromId(post.id);
					return (
					<article class="border-b border-slate-700 pb-8">
						<header>
							<h2 class="text-2xl font-semibold mb-2">
								<a 
									href={postUrl}
									class="text-slate-100 hover:text-orange-500 transition-colors"
								>
									{post.data.title}
								</a>
							</h2>
							<div class="text-sm text-slate-400 mb-3">
								<FormattedDate date={post.data.pubDate} />
							</div>
						</header>
						{post.data.description && (
							<p class="text-slate-300 leading-relaxed">
								{post.data.description}
							</p>
						)}
					</article>
					);
				})}
			</div>
			<PaginationNav lang={currentLang} currentPage={currentPage} totalPages={totalPages} />
		</main>
		<Footer />
	</body>
</html>
