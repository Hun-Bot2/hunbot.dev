---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FloatingLanguagePicker from '../../../components/FloatingLanguagePicker.astro';
import BlogFilterBar from '../../../components/blog/BlogFilterBar.astro';
import PostListCard from '../../../components/blog/PostListCard.astro';
import { useTranslations, type UILanguage } from '../../../i18n/ui';
import {
	getAllPosts,
	getMultiPostSeries,
	getNormalizedCategoryCounts,
	getPostYears,
	getPostsByLanguage,
	normalizeCategory,
} from '../../../utils/blog';

export function getStaticPaths() {
	const langs = ['ko', 'jp', 'en'];
	return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = lang as UILanguage;
const t = useTranslations(currentLang);

const allPosts = await getAllPosts();
// Reverse-chronological is the primary axis. Category, year and series are
// facets layered on top, applied client-side over this complete list.
const posts = getPostsByLanguage(allPosts, currentLang);

const CATEGORY_LABEL_KEYS = {
	ai: 'blog.category-ai',
	devlog: 'blog.category-devlog',
	review: 'blog.category-review',
	misc: 'blog.category-misc',
} as const;

const categoryCounts = getNormalizedCategoryCounts(posts);
const categories = (['ai', 'devlog', 'review', 'misc'] as const)
	.filter((key) => categoryCounts.has(key))
	.map((key) => ({
		value: key,
		label: t(CATEGORY_LABEL_KEYS[key]),
		count: categoryCounts.get(key) ?? 0,
	}));

const years = getPostYears(posts).map((year) => ({
	value: String(year),
	label: String(year),
	count: posts.filter((post) => post.data.pubDate.getFullYear() === year).length,
}));

const series = getMultiPostSeries(posts).map((entry) => ({
	value: entry.name,
	label: entry.name,
	count: entry.count,
}));
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={t('nav.blog')} description={t('blog.all-posts')} lang={currentLang} />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="blog-index-page">
			<header class="blog-index-header">
				<h1>{t('blog.all-posts')}</h1>
			</header>

			{posts.length > 0 ? (
				<>
					<BlogFilterBar
						lang={currentLang}
						categories={categories}
						years={years}
						series={series}
						totalCount={posts.length}
					/>

					<ul class="blog-post-list" data-blog-posts>
						{posts.map((post) => (
							<li
								class="blog-post-item"
								data-post-card
								data-post-category={normalizeCategory(post.data.category)}
								data-post-year={String(post.data.pubDate.getFullYear())}
								data-post-series={post.data.series?.trim() ?? ''}
							>
								<PostListCard post={post} />
							</li>
						))}
					</ul>

					<p class="blog-empty" data-blog-empty hidden>{t('blog.filter-no-results')}</p>
				</>
			) : (
				<p class="blog-empty">{t('blog.no-posts')}</p>
			)}
		</main>
		<Footer />
		<script type="module" src="/scripts/blog-filters.js"></script>
	</body>
</html>

<style>
	.blog-index-page {
		width: min(100%, 72rem);
		margin: 0 auto;
		padding: 2rem 1.25rem 4rem;
		overflow-x: clip;
	}

	.blog-index-header {
		margin-bottom: 1.5rem;
	}

	.blog-index-header h1 {
		margin: 0;
		color: rgb(248, 249, 250);
		font-family: var(--font-heading);
		font-size: clamp(2rem, 4vw, 2.65rem);
		font-weight: 800;
		letter-spacing: 0;
		line-height: 1.1;
	}

	.blog-post-list {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* The hidden attribute must win over the grid item display. */
	.blog-post-item[hidden] {
		display: none;
	}

	.blog-empty {
		border: 1px solid rgba(248, 249, 250, 0.12);
		border-radius: 0.65rem;
		background: rgba(255, 255, 255, 0.045);
		padding: 1rem;
		color: rgba(203, 213, 225, 0.82);
	}

	:global(body.light-theme) .blog-index-header h1 {
		color: rgb(15, 23, 42);
	}

	:global(body.light-theme) .blog-empty {
		border-color: rgba(15, 23, 42, 0.12);
		background: rgba(255, 255, 255, 0.78);
		color: rgba(51, 65, 85, 0.86);
	}

	@media (max-width: 720px) {
		.blog-index-page {
			padding-inline: 1rem;
		}
	}
</style>
