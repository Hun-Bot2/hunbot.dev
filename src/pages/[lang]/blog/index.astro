---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FloatingLanguagePicker from '../../../components/FloatingLanguagePicker.astro';
import { getCollection } from 'astro:content';
import PostListCard from '../../../components/blog/PostListCard.astro';
import { useTranslations, type UILanguage } from '../../../i18n/ui';
import { getPostsByLanguage, sortPostsBySeries } from '../../../utils/blog';

export function getStaticPaths() {
  const langs = ['ko', 'jp', 'en'];
  return langs.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = lang as UILanguage;
const t = useTranslations(currentLang);

const allPosts = await getCollection('blog');
const allLanguagePosts = getPostsByLanguage(allPosts, currentLang);
const noSeriesLabel = t('blog.series-no-series');
const seriesCollator = new Intl.Collator(currentLang === 'jp' ? 'ja' : currentLang, {
	numeric: true,
	sensitivity: 'base',
});

const getSeriesSlug = (value: string) => {
	const slug = value
		.trim()
		.toLowerCase()
		.replace(/[^a-z0-9가-힣ぁ-んァ-ヶ一-龯]+/g, '-')
		.replace(/^-+|-+$/g, '');

	return slug || 'none';
};

const seriesMap = allLanguagePosts.reduce((map, post) => {
	const series = post.data.series?.trim() || noSeriesLabel;
	const posts = map.get(series) ?? [];
	posts.push(post);
	map.set(series, posts);
	return map;
}, new Map<string, typeof allLanguagePosts>());

const seriesGroups = Array.from(seriesMap.entries())
	.sort(([a], [b]) => {
		if (a === noSeriesLabel) return 1;
		if (b === noSeriesLabel) return -1;
		return seriesCollator.compare(a, b);
	})
	.map(([title, groupPosts], index) => ({
		title,
		id: `series-${index + 1}-${getSeriesSlug(title)}`,
		count: groupPosts.length,
		posts: title === noSeriesLabel ? groupPosts : sortPostsBySeries(groupPosts),
	}));

const formatSeriesCount = (count: number) =>
	t('blog.series-count').replace('{count}', String(count));
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={t('nav.blog')} description={t('blog.all-posts')} lang={currentLang} />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="blog-index-page">
			<header class="blog-index-header">
				<h1>{t('blog.all-posts')}</h1>
			</header>

			{seriesGroups.length > 0 ? (
				<div class="blog-index-layout">
					<aside class="blog-series-sidebar" aria-labelledby="blog-series-title">
						<h2 id="blog-series-title">{t('blog.series-sidebar-title')}</h2>
						<p>{t('blog.series-sidebar-description')}</p>
						<nav aria-label={t('blog.series-sidebar-title')} class="blog-series-nav">
							{seriesGroups.map((group) => (
								<a href={`#${group.id}`} class="blog-series-link">
									<span class="blog-series-link-title">{group.title}</span>
									<strong class="blog-series-count">{formatSeriesCount(group.count)}</strong>
								</a>
							))}
						</nav>
					</aside>

					<div class="blog-series-list">
						{seriesGroups.map((group) => (
							<section id={group.id} class="blog-series-section">
								<div class="blog-series-heading">
									<h2>{group.title}</h2>
									<span>{formatSeriesCount(group.count)}</span>
								</div>
								<div class="blog-series-posts">
									{group.posts.map((post) => <PostListCard post={post} />)}
								</div>
							</section>
						))}
					</div>
				</div>
			) : (
				<p class="blog-empty">{t('blog.no-posts')}</p>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-index-page {
		width: min(100%, 72rem);
		margin: 0 auto;
		padding: 2rem 1.25rem 4rem;
		overflow-x: clip;
	}

	.blog-index-header {
		margin-bottom: 1.5rem;
	}

	.blog-index-header h1 {
		margin: 0;
		color: rgb(248, 249, 250);
		font-family: var(--font-heading);
		font-size: clamp(2rem, 4vw, 2.65rem);
		font-weight: 800;
		letter-spacing: 0;
		line-height: 1.1;
	}

	.blog-index-layout {
		display: grid;
		gap: 1.25rem;
		align-items: start;
	}

	.blog-series-sidebar {
		min-width: 0;
		max-height: calc(100vh - 6rem);
		overflow: hidden;
		border: 1px solid rgba(248, 249, 250, 0.12);
		border-radius: 0.65rem;
		background: rgba(255, 255, 255, 0.045);
		padding: 0.85rem;
	}

	.blog-series-sidebar h2 {
		margin: 0;
		color: rgb(248, 249, 250);
		font-family: var(--font-heading);
		font-size: 0.98rem;
		font-weight: 800;
	}

	.blog-series-sidebar p {
		margin: 0.25rem 0 0.8rem;
		color: rgba(203, 213, 225, 0.72);
		font-size: 0.84rem;
		line-height: 1.45;
	}

	.blog-series-nav {
		display: grid;
		gap: 0.35rem;
		max-height: calc(100vh - 11rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding-right: 0.15rem;
	}

	.blog-series-link {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.55rem;
		min-width: 0;
		border-radius: 0.5rem;
		padding: 0.48rem 0.55rem;
		color: inherit;
		text-decoration: none;
		transition: background 160ms ease, color 160ms ease;
	}

	.blog-series-link:hover {
		background: rgba(255, 255, 255, 0.07);
		text-decoration: none;
	}

	.blog-series-link-title {
		min-width: 0;
		overflow: hidden;
		color: rgba(248, 249, 250, 0.9);
		font-family: var(--font-heading);
		font-size: 0.86rem;
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.blog-series-count {
		flex: 0 0 auto;
		min-width: 2.6rem;
		border: 1px solid rgba(248, 249, 250, 0.12);
		border-radius: 999px;
		padding: 0.12rem 0.42rem;
		background: rgba(255, 255, 255, 0.045);
		color: rgba(203, 213, 225, 0.82);
		font-family: var(--font-heading);
		font-size: 0.74rem;
		font-weight: 800;
		line-height: 1.35;
		text-align: center;
		white-space: nowrap;
	}

	.blog-series-list {
		display: grid;
		gap: 2rem;
		min-width: 0;
	}

	.blog-series-section {
		scroll-margin-top: 5.5rem;
	}

	.blog-series-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
		border-bottom: 1px solid rgba(248, 249, 250, 0.12);
		padding-bottom: 0.55rem;
	}

	.blog-series-heading h2 {
		margin: 0;
		color: rgb(248, 249, 250);
		font-family: var(--font-heading);
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: 0;
		line-height: 1.25;
	}

	.blog-series-heading span {
		flex: 0 0 auto;
		color: rgba(203, 213, 225, 0.78);
		font-size: 0.84rem;
		font-weight: 700;
	}

	.blog-series-posts {
		display: grid;
		gap: 0.75rem;
	}

	.blog-empty {
		border: 1px solid rgba(248, 249, 250, 0.12);
		border-radius: 0.65rem;
		background: rgba(255, 255, 255, 0.045);
		padding: 1rem;
		color: rgba(203, 213, 225, 0.82);
	}

	:global(body.light-theme) .blog-index-header h1,
	:global(body.light-theme) .blog-series-sidebar h2,
	:global(body.light-theme) .blog-series-heading h2 {
		color: rgb(15, 23, 42);
	}

	:global(body.light-theme) .blog-series-sidebar,
	:global(body.light-theme) .blog-empty {
		border-color: rgba(15, 23, 42, 0.12);
		background: rgba(255, 255, 255, 0.82);
	}

	:global(body.light-theme) .blog-series-sidebar p,
	:global(body.light-theme) .blog-series-count,
	:global(body.light-theme) .blog-series-heading span,
	:global(body.light-theme) .blog-empty {
		color: rgba(51, 65, 85, 0.78);
	}

	:global(body.light-theme) .blog-series-link-title {
		color: rgba(15, 23, 42, 0.88);
	}

	:global(body.light-theme) .blog-series-count {
		border-color: rgba(15, 23, 42, 0.12);
		background: rgba(15, 23, 42, 0.045);
	}

	:global(body.light-theme) .blog-series-link:hover {
		background: rgba(15, 23, 42, 0.055);
	}

	:global(body.light-theme) .blog-series-heading {
		border-bottom-color: rgba(15, 23, 42, 0.12);
	}

	@media (min-width: 980px) {
		.blog-index-layout {
			grid-template-columns: 15.5rem minmax(0, 1fr);
		}

		.blog-series-sidebar {
			position: sticky;
			top: 5rem;
		}
	}

	@media (max-width: 720px) {
		.blog-index-page {
			padding-inline: 1rem;
		}

		.blog-series-nav {
			display: flex;
			width: 100%;
			max-height: none;
			max-width: 100%;
			overflow-x: auto;
			overflow-y: hidden;
			overscroll-behavior-x: contain;
			padding-bottom: 0.2rem;
			padding-right: 0;
			touch-action: pan-x;
		}

		.blog-series-link {
			min-width: 9.75rem;
			max-width: 13rem;
		}
	}
</style>
