---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import FloatingLanguagePicker from '../../../components/FloatingLanguagePicker.astro';
import BlogFilterBar from '../../../components/blog/BlogFilterBar.astro';
import PostRow from '../../../components/blog/PostRow.astro';
import '../../../styles/lists.css';
import '../../../styles/entry-list.css';
import { useTranslations, type UILanguage } from '../../../i18n/ui';
import {
	getAllPosts,
	getMultiPostSeries,
	getNormalizedCategoryCounts,
	getPostYears,
	getPostsByLanguage,
	normalizeCategory,
} from '../../../utils/blog';

export function getStaticPaths() {
	const langs = ['ko', 'jp', 'en'];
	return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = lang as UILanguage;
const t = useTranslations(currentLang);

const allPosts = await getAllPosts();
const posts = getPostsByLanguage(allPosts, currentLang);

const CATEGORY_LABEL_KEYS = {
	ai: 'blog.category-ai',
	devlog: 'blog.category-devlog',
	review: 'blog.category-review',
	misc: 'blog.category-misc',
} as const;

const categoryCounts = getNormalizedCategoryCounts(posts);
const categories = (['ai', 'devlog', 'review', 'misc'] as const)
	.filter((key) => categoryCounts.has(key))
	.map((key) => ({
		value: key,
		label: t(CATEGORY_LABEL_KEYS[key]),
		count: categoryCounts.get(key) ?? 0,
	}));

const seriesNames = new Set(getMultiPostSeries(posts).map((entry) => entry.name));
const categoryLabels = Object.fromEntries(categories.map((category) => [category.value, category.label]));

const years = getPostYears(posts).map((year) => ({
	value: String(year),
	label: String(year),
	count: posts.filter((post) => post.data.pubDate.getFullYear() === year).length,
}));

const series = getMultiPostSeries(posts).map((entry) => ({
	value: entry.name,
	label: entry.name,
	count: entry.count,
}));

// Posts arrive newest first, so each year's group is already in order.
const postsByYear = posts.reduce((groups, post) => {
	const year = post.data.pubDate.getFullYear();
	const group = groups.find((entry) => entry.year === year);
	if (group) group.posts.push(post);
	else groups.push({ year, posts: [post] });
	return groups;
}, [] as { year: number; posts: typeof posts }[]);
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={t('nav.blog')} description={t('blog.all-posts')} lang={currentLang} />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="atelier-page blog-index-page">
			{posts.length > 0 ? (
				<Fragment>
					<section class="subpage-intro">
						<h1 class="eyebrow">{t('nav.blog')}</h1>
					</section>

					<BlogFilterBar
						lang={currentLang}
						categories={categories}
						years={years}
						series={series}
						totalCount={posts.length}
					/>

					<div class="writing-archive page-frame" data-blog-posts>
						{postsByYear.map((group) => (
							<section class="year-group" aria-label={String(group.year)} data-filter-section>
								<div class="year-separator"><span>{group.year}</span></div>
								<ul class="entry-list">
									{group.posts.map((post) => (
										<PostRow post={post} categoryLabels={categoryLabels} seriesNames={seriesNames} />
									))}
								</ul>
							</section>
						))}
					</div>

					<p class="blog-empty page-frame" data-blog-empty hidden>{t('blog.filter-no-results')}</p>
				</Fragment>
			) : (
				<section class="subpage-intro">
					<h1 class="eyebrow">{t('blog.all-posts')}</h1>
					<p class="blog-empty">{t('blog.no-posts')}</p>
				</section>
			)}
		</main>
		<script type="module" src="/scripts/blog-filters.js"></script>
	</body>
</html>

<style>
	/* The year heading carries the rule, so the title needs none of its own and
	   the archive starts right under it. */
	.subpage-intro {
		padding-bottom: 0.25rem;
		border-bottom: 0;
	}

	.writing-archive {
		padding-top: 0;
	}

	/* Quieter than the other archives: the year is a label, not a headline. */
	.year-separator {
		margin-top: 0;
		padding: 0.25rem 0 0.4rem;
	}

	.year-separator > span {
		font-size: 1.25rem;
	}

	.year-group + .year-group {
		margin-top: 1rem;
	}

	.blog-empty {
		margin-block: 0;
		padding: 1.5rem 0;
		font-size: 0.9375rem;
		color: var(--secondary);
	}
</style>
