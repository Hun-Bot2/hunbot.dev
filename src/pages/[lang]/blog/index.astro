---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import FloatingLanguagePicker from '../../../components/FloatingLanguagePicker.astro';
import BlogFilterBar from '../../../components/blog/BlogFilterBar.astro';
import PostListCard from '../../../components/blog/PostListCard.astro';
import '../../../styles/lists.css';
import { useTranslations, type UILanguage } from '../../../i18n/ui';
import {
	getAllPosts,
	getMultiPostSeries,
	getNormalizedCategoryCounts,
	getPostYears,
	getPostsByLanguage,
	normalizeCategory,
} from '../../../utils/blog';

export function getStaticPaths() {
	const langs = ['ko', 'jp', 'en'];
	return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = lang as UILanguage;
const t = useTranslations(currentLang);

const allPosts = await getAllPosts();
const posts = getPostsByLanguage(allPosts, currentLang);

const CATEGORY_LABEL_KEYS = {
	ai: 'blog.category-ai',
	devlog: 'blog.category-devlog',
	review: 'blog.category-review',
	misc: 'blog.category-misc',
} as const;

const categoryCounts = getNormalizedCategoryCounts(posts);
const categories = (['ai', 'devlog', 'review', 'misc'] as const)
	.filter((key) => categoryCounts.has(key))
	.map((key) => ({
		value: key,
		label: t(CATEGORY_LABEL_KEYS[key]),
		count: categoryCounts.get(key) ?? 0,
	}));

const years = getPostYears(posts).map((year) => ({
	value: String(year),
	label: String(year),
	count: posts.filter((post) => post.data.pubDate.getFullYear() === year).length,
}));

const series = getMultiPostSeries(posts).map((entry) => ({
	value: entry.name,
	label: entry.name,
	count: entry.count,
}));

const categoriesUrl = `/${currentLang}/blog/categories`;
const rssUrl = `/${currentLang}/rss.xml`;

// Posts arrive newest first, so each year's group is already in order.
const postsByYear = posts.reduce((groups, post) => {
	const year = post.data.pubDate.getFullYear();
	const group = groups.find((entry) => entry.year === year);
	if (group) group.posts.push(post);
	else groups.push({ year, posts: [post] });
	return groups;
}, [] as { year: number; posts: typeof posts }[]);
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={t('nav.blog')} description={t('blog.all-posts')} lang={currentLang} />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="atelier-page blog-index-page">
			{posts.length > 0 ? (
				<Fragment>
					<section class="subpage-intro">
						<h1 class="eyebrow">{t('blog.index.eyebrow').replace('{count}', String(posts.length))}</h1>
						<div class="blog-intro-row">
							<p>{t('blog.index.description')}</p>
							<nav class="blog-intro-links" aria-label={t('blog.all-posts')}>
								<a href={categoriesUrl} class="text-link">{t('blog.categories-title')}</a>
								<a href={rssUrl} class="text-link">{t('blog.index.rss')}</a>
							</nav>
						</div>
					</section>

					<BlogFilterBar
						lang={currentLang}
						categories={categories}
						years={years}
						series={series}
						totalCount={posts.length}
					/>

					<div class="writing-archive page-frame" data-blog-posts>
						{postsByYear.map((group) => (
							<section class="year-group" aria-label={String(group.year)}>
								<div class="year-separator"><span>{group.year}</span></div>
								<ul class="writing-list">
									{group.posts.map((post) => (
										<li
											data-post-card
											data-post-category={normalizeCategory(post.data.category)}
											data-post-year={String(post.data.pubDate.getFullYear())}
											data-post-series={post.data.series?.trim() ?? ''}
										>
											<PostListCard post={post} />
										</li>
									))}
								</ul>
							</section>
						))}
					</div>

					<p class="blog-empty page-frame" data-blog-empty hidden>{t('blog.filter-no-results')}</p>
				</Fragment>
			) : (
				<section class="subpage-intro">
					<h1 class="eyebrow">{t('blog.all-posts')}</h1>
					<p class="blog-empty">{t('blog.no-posts')}</p>
				</section>
			)}
		</main>
		<script type="module" src="/scripts/blog-filters.js"></script>
	</body>
</html>

<style>
	.subpage-intro .eyebrow {
		margin-bottom: 0.4rem;
	}

	.blog-intro-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
	}

	.blog-intro-row p {
		margin: 0;
		font: 400 0.9375rem/1.55 var(--font-serif);
		color: var(--secondary);
	}

	.blog-intro-links {
		display: flex;
		gap: 1.35rem;
	}

	.blog-intro-links a {
		display: inline-flex;
		align-items: center;
		min-height: 2.5rem;
	}

	.blog-empty {
		margin-block: 0;
		padding: 1.5rem 0;
		font-size: 0.9375rem;
		color: var(--secondary);
	}
</style>
