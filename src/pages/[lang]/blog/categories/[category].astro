---
import BaseHead from '../../../../components/BaseHead.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PostListCard from '../../../../components/blog/PostListCard.astro';
import '../../../../styles/lists.css';
import FloatingLanguagePicker from '../../../../components/FloatingLanguagePicker.astro';
import { useTranslations, type UILanguage } from '../../../../i18n/ui';
import { getBlogLanguageFromId } from '../../../../utils/blog-routing';
import { getAllPosts, filterPostsByLanguage, getCategoryKey, sortPostsByDateDesc } from '../../../../utils/blog';

export async function getStaticPaths() {
    const allPosts = await getAllPosts();
    const categoryKeys = new Set<string>();

    allPosts.forEach((post) => {
        const [lang] = post.id.split('/');
        if (!lang) return;
        const category = getCategoryKey(post);
        categoryKeys.add(`${lang}:${category}`);
    });

    return Array.from(categoryKeys).map((key) => {
        const [lang, category] = key.split(':');
        return { params: { lang, category } };
    });
}

const { lang, category } = Astro.params;
const currentLang = lang as UILanguage;
const t = useTranslations(currentLang);
const categoryValue = category ? decodeURIComponent(String(category)) : 'uncategorized';

const allPosts = await getAllPosts();
const posts = sortPostsByDateDesc(
    filterPostsByLanguage(allPosts, currentLang).filter((post) => getCategoryKey(post) === categoryValue),
);
const categoryAvailableLangs = Array.from(
    allPosts.reduce((langs, post) => {
        if (getCategoryKey(post) !== categoryValue) return langs;
        try {
            langs.add(getBlogLanguageFromId(post.id));
        } catch {
            // Ignore invalid content IDs here; collection validation handles them elsewhere.
        }
        return langs;
    }, new Set<UILanguage>()),
);

const categoryName = categoryValue;
const categoryDescription = `${t('blog.categories-title')}: ${categoryValue}`;
---

<!doctype html>
<html lang={lang}>
    <head>
        <BaseHead
            title={categoryName}
            description={categoryDescription}
            lang={currentLang}
            availableLangs={categoryAvailableLangs}
        />
    </head>
    <body>
        <Header />
        <FloatingLanguagePicker availableLangs={categoryAvailableLangs} />

        <main id="main-content" class="atelier-page">
            <section class="subpage-intro">
                <p class="eyebrow">
                    <a href={`/${lang}/blog/categories`} class="underlined-link-quiet">{t('blog.categories-title')}</a>
                    · {t('blog.category-count').replace('{count}', String(posts.length))}
                </p>
                <h1 class="category-title">{categoryName}</h1>
            </section>

            <div class="writing-archive page-frame">
                {posts.length === 0 ? (
                    <p class="category-empty">{t('blog.no-posts')}</p>
                ) : (
                    <ul class="writing-list">
                        {posts.map((post) => (
                            <li>
                                <PostListCard post={post} />
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </main>
        <Footer />
    </body>
</html>

<style>
    .subpage-intro .eyebrow {
        margin-bottom: 0.5rem;
    }

    .underlined-link-quiet {
        border-bottom: 1px solid var(--rule-strong);
    }

    .underlined-link-quiet:hover {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }

    .category-title {
        margin: 0;
        overflow-wrap: anywhere;
        font: 400 clamp(2rem, 4.5vw, 3.25rem) / 1.1 var(--font-serif);
        letter-spacing: -0.03em;
    }

    .category-empty {
        padding: 1.5rem 0;
        color: var(--secondary);
    }
</style>
