---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import '../../../styles/lists.css';
import FloatingLanguagePicker from '../../../components/FloatingLanguagePicker.astro';
import { useTranslations, type UILanguage } from '../../../i18n/ui';
import { getAllPosts, getCategoryCounts, filterPostsByLanguage } from '../../../utils/blog';

export function getStaticPaths() {
    const langs = ['ko', 'jp', 'en'];
    return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = lang as UILanguage;
const t = useTranslations(currentLang);

const allPosts = await getAllPosts();
const posts = filterPostsByLanguage(allPosts, currentLang);
const categoryMap = getCategoryCounts(posts);

const categories = Array.from(categoryMap.entries())
    .map(([key, count]) => ({ key, count }))
    .sort((a, b) => a.key.localeCompare(b.key, lang === 'jp' ? 'ja' : lang === 'ko' ? 'ko' : 'en'));
---

<!doctype html>
<html lang={lang}>
    <head>
        <BaseHead title={t('blog.categories-title')} description={t('blog.categories-description')} />
    </head>
    <body>
        <Header />
        <FloatingLanguagePicker />

        <main id="main-content" class="atelier-page">
            <section class="subpage-intro">
                <h1 class="eyebrow">{t('blog.categories-title')} · {categories.length}</h1>
            </section>

            <div class="page-frame category-index">
                {categories.length === 0 ? (
                    <p class="category-empty">{t('blog.no-categories')}</p>
                ) : (
                    <ul class="rule-list">
                        {categories.map((category) => (
                            <li>
                                <a href={`/${lang}/blog/categories/${encodeURIComponent(category.key)}/`} class="category-row">
                                    <span class="category-name">{category.key}</span>
                                    <span class="category-count">{t('blog.category-count').replace('{count}', String(category.count))}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </main>
    </body>
</html>

<style>
    .subpage-intro .eyebrow {
        margin-bottom: 0.4rem;
    }

    .category-index {
        padding-top: 0.25rem;
    }

    .category-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 0;
    }

    .category-name {
        min-width: 0;
        overflow-wrap: anywhere;
        font: 400 1.25rem/1.25 var(--font-serif);
        letter-spacing: -0.01em;
        transition: color 160ms ease;
    }

    .category-row:hover .category-name,
    .category-row:focus-visible .category-name {
        color: var(--accent);
    }

    .category-count {
        flex: none;
        font: 400 0.6875rem/1.45 var(--font-mono);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--secondary);
    }

    .category-empty {
        padding: 1.5rem 0;
        color: var(--secondary);
    }
</style>
