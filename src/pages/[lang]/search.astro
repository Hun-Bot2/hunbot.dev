---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import { useTranslations, type UILanguage } from '../../i18n/ui';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = t('search.title');
const description = t('search.description');
const emptyText = t('search.empty');
const unavailableText = t('search.unavailable');
const buttonText = t('nav.search');
const searchFilters = [
	{ value: 'all', label: t('search.filter.all') },
	{ value: 'blog', label: t('search.filter.blog') },
	{ value: 'library', label: t('search.filter.library') },
];
const pagefindTranslations = {
	placeholder: t('search.placeholder'),
	zero_results: t('search.zero-results'),
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="search-shell mx-auto max-w-4xl px-6 py-10" data-pagefind-ignore>
			<section class="mb-8">
				<h1 class="text-3xl font-bold text-slate-100 mb-3">{title}</h1>
				<p class="text-slate-400 leading-relaxed">{description}</p>
				<p class="mt-2 text-sm text-slate-500">{t('search.guidance')}</p>
			</section>
			<div class="search-filter-bar" aria-label={t('search.filters-label')}>
				{searchFilters.map((filter) => (
					<button
						type="button"
						data-section-filter={filter.value}
						aria-pressed={filter.value === 'all' ? 'true' : 'false'}
						class:list={['search-filter-button', filter.value === 'all' && 'is-active']}
					>
						{filter.label}
					</button>
				))}
			</div>
			<form id="search-fallback" class="search-fallback" method="get" role="search">
				<label class="sr-only" for="search-fallback-input">{title}</label>
				<input
					id="search-fallback-input"
					name="q"
					type="search"
					placeholder={t('search.placeholder')}
					autocomplete="off"
				/>
				<button type="submit">{buttonText}</button>
			</form>
			<div id="search" aria-label={title}></div>
			<p class="search-empty text-sm text-slate-500 mt-4">{emptyText}</p>
		</main>
		<Footer />
		<script src="/pagefind/pagefind-ui.js" defer></script>
		<script define:vars={{ lang, pagefindTranslations, unavailableText }}>
			window.addEventListener('DOMContentLoaded', () => {
				const searchRoot = document.querySelector('#search');
				const emptyState = document.querySelector('.search-empty');
				const fallbackForm = document.querySelector('#search-fallback');
				const fallbackInput = document.querySelector('#search-fallback-input');
				const filterButtons = Array.from(document.querySelectorAll('[data-section-filter]'));
				const initialQuery = new URLSearchParams(window.location.search).get('q');
				let currentSectionFilter = 'all';

				const buildSearchFilters = () => {
					if (currentSectionFilter === 'all') return { language: [lang] };
					return { language: [lang], section: [currentSectionFilter] };
				};

				const updateFilterButtons = () => {
					filterButtons.forEach((button) => {
						const isActive = button.getAttribute('data-section-filter') === currentSectionFilter;
						button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
						button.classList.toggle('is-active', isActive);
					});
				};

				if (!searchRoot) return;

				if (initialQuery && fallbackInput instanceof HTMLInputElement) {
					fallbackInput.value = initialQuery;
					emptyState?.classList.add('hidden');
				}

				const PagefindUI = window.PagefindUI;

				if (!PagefindUI) {
					searchRoot.innerHTML = `<p class="text-sm text-slate-500">${unavailableText}</p>`;
					return;
				}

				const search = new PagefindUI({
					element: '#search',
					showSubResults: true,
					showImages: false,
					resetStyles: false,
					bundlePath: '/pagefind/',
					showEmptyFilters: false,
					translations: pagefindTranslations,
				});

				fallbackForm?.classList.add('hidden');
				search.triggerFilters(buildSearchFilters());
				filterButtons.forEach((button) => {
					button.addEventListener('click', () => {
						currentSectionFilter = button.getAttribute('data-section-filter') || 'all';
						updateFilterButtons();
						search.triggerFilters(buildSearchFilters());
						emptyState?.classList.add('hidden');
					});
				});

				if (initialQuery) {
					search.triggerSearch(initialQuery);
					emptyState?.classList.add('hidden');
				}

				searchRoot.addEventListener('input', () => {
					emptyState?.classList.add('hidden');
				}, { once: true });
			});
		</script>
	</body>
</html>

<style>
	.search-shell {
		--pagefind-ui-primary: #f97316;
		--pagefind-ui-text: rgb(248, 250, 252);
		--pagefind-ui-background: rgb(15, 23, 42);
		--pagefind-ui-border: rgb(51, 65, 85);
		--pagefind-ui-tag: rgba(249, 115, 22, 0.16);
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 0.5rem;
		--pagefind-ui-font: var(--font-body);
	}

	.search-fallback {
		display: flex;
		gap: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.search-filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}

	.search-filter-button {
		min-height: 2.25rem;
		border: 1px solid rgba(148, 163, 184, 0.35);
		border-radius: 999px;
		background: rgba(15, 23, 42, 0.55);
		color: rgb(203, 213, 225);
		padding: 0.4rem 0.85rem;
		font: inherit;
		font-size: 0.875rem;
		font-weight: 700;
		transition:
			background 160ms ease,
			border-color 160ms ease,
			color 160ms ease;
	}

	.search-filter-button:hover,
	.search-filter-button.is-active {
		border-color: rgba(249, 115, 22, 0.58);
		background: rgba(249, 115, 22, 0.14);
		color: rgb(255, 237, 213);
	}

	.search-fallback input {
		width: 100%;
		min-height: 3rem;
		border: 1px solid rgb(51, 65, 85);
		border-radius: 0.5rem;
		background: rgb(15, 23, 42);
		color: rgb(248, 250, 252);
		padding: 0.75rem 1rem;
		font: inherit;
	}

	.search-fallback button {
		min-height: 3rem;
		border: 1px solid #f97316;
		border-radius: 0.5rem;
		background: #f97316;
		color: white;
		padding: 0.75rem 1rem;
		font: inherit;
		font-weight: 700;
		white-space: nowrap;
	}

	.search-fallback.hidden {
		display: none;
	}

	:global(body.light-theme) .search-shell {
		--pagefind-ui-text: rgb(15, 23, 42);
		--pagefind-ui-background: rgb(255, 255, 255);
		--pagefind-ui-border: rgb(203, 213, 225);
	}

	:global(body.light-theme) .search-fallback input {
		background: rgb(255, 255, 255);
		color: rgb(15, 23, 42);
		border-color: rgb(203, 213, 225);
	}

	:global(body.light-theme) .search-filter-button {
		background: rgb(255, 255, 255);
		color: rgb(51, 65, 85);
		border-color: rgb(203, 213, 225);
	}

	:global(body.light-theme) .search-filter-button:hover,
	:global(body.light-theme) .search-filter-button.is-active {
		background: rgba(249, 115, 22, 0.1);
		color: rgb(154, 52, 18);
		border-color: rgba(194, 65, 12, 0.28);
	}

	:global(.pagefind-ui__search-input) {
		background-color: var(--pagefind-ui-background);
		color: var(--pagefind-ui-text);
	}

	:global(.pagefind-ui__result-link) {
		color: var(--pagefind-ui-text);
		text-decoration: none;
	}

	:global(.pagefind-ui__result-link:hover) {
		color: var(--pagefind-ui-primary);
	}
</style>
