---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import '../../styles/lists.css';
import { useTranslations, type UILanguage } from '../../i18n/ui';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = t('search.title');
const description = t('search.description');
const emptyText = t('search.empty');
const unavailableText = t('search.unavailable');
const buttonText = t('nav.search');
const searchFilters = [
	{ value: 'all', label: t('search.filter.all') },
	{ value: 'blog', label: t('search.filter.blog') },
	{ value: 'library', label: t('search.filter.library') },
];
const pagefindTranslations = {
	placeholder: t('search.placeholder'),
	zero_results: t('search.zero-results'),
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="search-shell atelier-page" data-pagefind-ignore>
			<section class="subpage-intro">
				<h1 class="eyebrow">{title}</h1>
				<p class="intro-copy">{description}</p>
				<p class="intro-note">{t('search.guidance')}</p>
			</section>
			<div class="page-frame">
				<div class="search-filter-bar" aria-label={t('search.filters-label')}>
					{searchFilters.map((filter) => (
						<button
							type="button"
							data-section-filter={filter.value}
							aria-pressed={filter.value === 'all' ? 'true' : 'false'}
							class:list={['search-filter-button', filter.value === 'all' && 'is-active']}
						>
							{filter.label}
						</button>
					))}
				</div>
				<form id="search-fallback" class="search-fallback" method="get" role="search">
					<label class="sr-only" for="search-fallback-input">{title}</label>
					<input
						id="search-fallback-input"
						name="q"
						type="search"
						placeholder={t('search.placeholder')}
						autocomplete="off"
					/>
					<button type="submit" class="btn-pill">{buttonText}</button>
				</form>
				<div id="search" aria-label={title}></div>
				<p class="search-empty">{emptyText}</p>
			</div>
		</main>
		<script src="/pagefind/pagefind-ui.js" defer></script>
		<script define:vars={{ lang, pagefindTranslations, unavailableText }}>
			window.addEventListener('DOMContentLoaded', () => {
				const searchRoot = document.querySelector('#search');
				const emptyState = document.querySelector('.search-empty');
				const fallbackForm = document.querySelector('#search-fallback');
				const fallbackInput = document.querySelector('#search-fallback-input');
				const filterButtons = Array.from(document.querySelectorAll('[data-section-filter]'));
				const initialQuery = new URLSearchParams(window.location.search).get('q');
				let currentSectionFilter = 'all';

				const buildSearchFilters = () => {
					if (currentSectionFilter === 'all') return { language: [lang] };
					return { language: [lang], section: [currentSectionFilter] };
				};

				const updateFilterButtons = () => {
					filterButtons.forEach((button) => {
						const isActive = button.getAttribute('data-section-filter') === currentSectionFilter;
						button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
						button.classList.toggle('is-active', isActive);
					});
				};

				if (!searchRoot) return;

				if (initialQuery && fallbackInput instanceof HTMLInputElement) {
					fallbackInput.value = initialQuery;
					emptyState?.classList.add('hidden');
				}

				const PagefindUI = window.PagefindUI;

				if (!PagefindUI) {
					searchRoot.innerHTML = `<p class="search-unavailable">${unavailableText}</p>`;
					return;
				}

				const search = new PagefindUI({
					element: '#search',
					showSubResults: true,
					showImages: false,
					resetStyles: false,
					bundlePath: '/pagefind/',
					showEmptyFilters: false,
					translations: pagefindTranslations,
				});

				fallbackForm?.classList.add('hidden');
				search.triggerFilters(buildSearchFilters());
				filterButtons.forEach((button) => {
					button.addEventListener('click', () => {
						currentSectionFilter = button.getAttribute('data-section-filter') || 'all';
						updateFilterButtons();
						search.triggerFilters(buildSearchFilters());
						emptyState?.classList.add('hidden');
					});
				});

				if (initialQuery) {
					search.triggerSearch(initialQuery);
					emptyState?.classList.add('hidden');
				}

				searchRoot.addEventListener('input', () => {
					emptyState?.classList.add('hidden');
				}, { once: true });
			});
		</script>
	</body>
</html>

<style>
	/* Pagefind reads these variables from the nearest ancestor; every value is a
	   token, so light and dark need no overrides here. */
	.search-shell {
		--pagefind-ui-scale: 1;
		--pagefind-ui-primary: var(--accent);
		--pagefind-ui-text: var(--ink);
		--pagefind-ui-background: var(--paper);
		--pagefind-ui-border: var(--rule-strong);
		--pagefind-ui-tag: var(--paper-deep);
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 0;
		--pagefind-ui-image-border-radius: 0;
		--pagefind-ui-font: var(--font-sans);
	}

	/* Section filter: mono underline tabs, like the Library and blog filters. */
	.search-filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5rem;
		margin-top: 0.75rem;
	}

	.search-filter-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 2.5rem;
		padding: 0;
		border: 0;
		background: none;
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
		cursor: pointer;
		transition: color 160ms ease;
	}

	.search-filter-button::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.6rem;
		height: 1px;
		background: transparent;
	}

	.search-filter-button:hover {
		color: var(--ink);
	}

	.search-filter-button.is-active {
		color: var(--accent);
	}

	.search-filter-button.is-active::after {
		background: var(--accent);
	}

	/* No-JS fallback form and the Pagefind input share one look: serif, ink underline. */
	.search-fallback {
		display: flex;
		align-items: flex-end;
		gap: 1rem;
		margin: 0.5rem 0 1.5rem;
	}

	.search-fallback.hidden {
		display: none;
	}

	.search-fallback input {
		flex: 1;
		min-width: 0;
		height: 4rem;
		padding: 0;
		border: 0;
		border-bottom: 1px solid var(--ink);
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		font: 400 1.5rem/1.2 var(--font-serif);
	}

	.search-fallback input::placeholder {
		color: var(--secondary);
		opacity: 0.7;
	}

	.search-fallback input:focus-visible,
	.search-shell :global(.pagefind-ui .pagefind-ui__search-input:focus-visible) {
		outline: 0;
		border-bottom-color: var(--accent);
	}

	.search-fallback .btn-pill {
		min-height: 2.5rem;
		cursor: pointer;
		white-space: nowrap;
	}

	.search-empty,
	.search-shell :global(.search-unavailable) {
		margin: 1rem 0 0;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--secondary);
	}

	.search-empty.hidden {
		display: none;
	}

	/* ── Pagefind UI ────────────────────────────────────────────── */

	.search-shell :global(.pagefind-ui__form) {
		margin-top: 0.5rem;
	}

	.search-shell :global(.pagefind-ui__form:before) {
		top: 1.375rem;
		left: 0.125rem;
		opacity: 1;
		background-color: var(--secondary);
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__search-input) {
		height: 4rem;
		padding: 0 6rem 0 2.5rem;
		border: 0;
		border-bottom: 1px solid var(--ink);
		border-radius: 0;
		background: transparent;
		color: var(--ink);
		font: 400 1.5rem/1.2 var(--font-serif);
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__search-input::placeholder) {
		color: var(--secondary);
		opacity: 0.7;
	}

	/* The clear button: a plain mono text button. Pagefind paints it with its own
	   background box and absolute geometry, so reset those explicitly. */
	.search-shell :global(.pagefind-ui .pagefind-ui__search-clear) {
		top: 0;
		right: 0;
		height: 4rem;
		padding: 0 0 0 1rem;
		border: 0;
		border-radius: 0;
		background: transparent;
		font: 400 0.6875rem/1 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
		transition: color 160ms ease;
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__search-clear:hover),
	.search-shell :global(.pagefind-ui .pagefind-ui__search-clear:focus) {
		background: transparent;
		color: var(--accent);
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__search-clear:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__message) {
		height: auto;
		padding: 1rem 0 0.75rem;
		font: 400 0.6875rem/1.4 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__result) {
		padding: 1.1rem 0 1.25rem;
		border-top: 1px solid var(--rule);
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__result-inner) {
		margin-top: 0;
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__result-title) {
		font: 400 1.1875rem/1.3 var(--font-serif);
		letter-spacing: -0.01em;
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__result-link) {
		color: var(--ink);
		text-decoration: none;
		transition: color 160ms ease;
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__result-link:hover) {
		color: var(--accent);
		text-decoration: none;
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__result-excerpt) {
		margin-top: 0.35rem;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--secondary);
	}

	.search-shell :global(.pagefind-ui mark) {
		padding: 0 0.1em;
		background: color-mix(in srgb, var(--accent) 22%, transparent);
		color: var(--ink);
	}

	/* Sub results hang under their parent, indented. */
	.search-shell :global(.pagefind-ui .pagefind-ui__result-nested) {
		padding-left: 1.25rem;
		margin-top: 0.5rem;
		border-left: 1px solid var(--rule);
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__result-nested .pagefind-ui__result-link) {
		font-size: 1rem;
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__result-nested .pagefind-ui__result-link:before) {
		display: none;
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__button) {
		width: auto;
		height: 2.5rem;
		padding: 0 1.1rem;
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		background: transparent;
		font: 400 0.6875rem/1 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__button:hover) {
		border-color: var(--ink);
		background: transparent;
		color: var(--ink);
	}

	/* The facet panel Pagefind builds from the indexed filters. */
	.search-shell :global(.pagefind-ui .pagefind-ui__filter-name),
	.search-shell :global(.pagefind-ui .pagefind-ui__filter-label) {
		font-size: 0.8125rem;
		font-weight: 400;
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__filter-name) {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.search-shell :global(.pagefind-ui .pagefind-ui__filter-block) {
		border-bottom-width: 1px;
	}
</style>
