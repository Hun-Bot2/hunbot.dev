---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import LibraryIcon from '../../components/library/LibraryIcon.astro';
import LibraryPageStyles from '../../components/library/LibraryPageStyles.astro';
import PaperRow from '../../components/research/PaperRow.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../i18n/ui';
import { getAllPosts } from '../../utils/blog';
import { getBlogUrlFromPost } from '../../utils/blog-routing';
import { decks } from '../../data/decks';
import {
	formatPaperAuthors,
	getAcademicReviewsByLanguage,
	getAcademicReviewUrlFromEntry,
	getPublishedAcademicReviews,
} from '../../utils/academic-review-routing';
import { learningPaths } from '../../data/learningPaths';
import {
	getLearningPathUrl,
	getLocalizedPathText,
	getVisibleLearningPaths,
	resolveLearningPathSteps,
} from '../../utils/learning-paths';
import {
	getActiveTopics,
	getFeaturedTopics,
	getTopicDescription,
	getTopicLabel,
} from '../../utils/library';
import {
	getPostsForPaper,
	getReviewForPaper,
	getSelectedNotYetStudied,
	getStudyLog,
	getTopicLabelsForPaper,
	getTopicsWithLinkedPapers,
} from '../../utils/research';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = `${t('research.title')} - Hun-Bot Blog`;
const description = t('research.meta.description');

const allPapers = await getCollection('papers');
const allTopics = await getCollection('topics');
const allReviews = getPublishedAcademicReviews(await getCollection('academicReviews'));
const allPosts = await getAllPosts();

const reviews = getAcademicReviewsByLanguage(allReviews, lang);
const studyLog = getStudyLog(allPapers);
const selected = getSelectedNotYetStudied(allPapers);
const topicsWithPapers = getTopicsWithLinkedPapers(allTopics, allPapers);

const visiblePaths = getVisibleLearningPaths(learningPaths, allPosts, lang).map((path) => ({
	path,
	steps: resolveLearningPathSteps(path, allPosts, lang),
}));

// Decks and Featured Topics render unconditionally below (there is always at
// least one listed deck and one active topic today), so the hub as a whole
// is never empty anymore. The honest empty line is scoped to just the
// paper/study-log part (docs/decisions/site-structure.md).
const hasStudyContent = studyLog.length > 0 || selected.length > 0;

const listedDeckCount = decks.filter((deck) => deck.placement === 'paper' || deck.placement === 'project').length;

const featuredTopics = getFeaturedTopics(getActiveTopics(allTopics), 6);
const linkableTopicIds = new Set(topicsWithPapers.map(({ topic }) => topic.data.id));

type PaperEntry = (typeof studyLog)[number];

function getRowProps(paper: PaperEntry) {
	const review = getReviewForPaper(allReviews, paper.data.id);
	return {
		reviewUrl: review ? getAcademicReviewUrlFromEntry(review) : null,
		postUrls: getPostsForPaper(allPosts, paper.data.id).map((post) => getBlogUrlFromPost(post)),
		topicLabels: getTopicLabelsForPaper(paper, allTopics, lang),
	};
}

const formatTopicItemCount = (count: number) => t('research.topic-item-count').replace('{count}', String(count));
const formatStepCount = (count: number) => t('paths.step-count').replace('{count}', String(count));
const formatItemCount = (count: number) => t('library.item-count').replace('{count}', String(count));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<LibraryPageStyles />
		<meta data-pagefind-meta="title[content]" content={t('research.title')} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="research" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="atelier-page" data-pagefind-body>
			<section class="subpage-intro">
				<h1 class="eyebrow">{t('research.title')}</h1>
			</section>

			<div class="page-frame">
				{!hasStudyContent && <p class="empty-line">{t('research.empty')}</p>}

				{studyLog.length > 0 && (
					<section class="research-section" aria-labelledby="research-study-log-heading">
						<div class="section-head">
							<div class="column-heading">
								<h2 id="research-study-log-heading">{t('research.section.study-log.title')}</h2>
							</div>
							<p class="section-note">{t('research.section.study-log.description')}</p>
						</div>
						<ul class="atelier-rows">
							{studyLog.map((paper) => {
								const row = getRowProps(paper);
								return (
									<PaperRow paper={paper} lang={lang} state={row.reviewUrl ? 'reviewed' : 'studied'} {...row} />
								);
							})}
						</ul>
					</section>
				)}

				{selected.length > 0 && (
					<section class="research-section" aria-labelledby="research-selected-heading">
						<div class="section-head">
							<div class="column-heading">
								<h2 id="research-selected-heading">{t('research.section.selected.title')}</h2>
							</div>
							<p class="section-note">{t('research.section.selected.description')}</p>
						</div>
						<ul class="atelier-rows">
							{selected.map((paper) => (
								<PaperRow
									paper={paper}
									lang={lang}
									state="queue"
									topicLabels={getTopicLabelsForPaper(paper, allTopics, lang)}
									showAcceptance={false}
								/>
							))}
						</ul>
					</section>
				)}

				{reviews.length > 0 && (
					<section class="research-section" aria-labelledby="research-reviews-heading">
						<div class="section-head">
							<div class="column-heading">
								<h2 id="research-reviews-heading">{t('research.section.reviews.title')}</h2>
							</div>
						</div>
						<ul class="atelier-rows">
							{reviews.map((review) => {
								const meta = [
									review.data.paper.venue,
									review.data.paper.year ? String(review.data.paper.year) : null,
									formatPaperAuthors(review.data.paper.authors),
								].filter(Boolean).join(' · ');
								return (
									<li class="atelier-row">
										<a href={getAcademicReviewUrlFromEntry(review)} class="atelier-row-link">
											<div class="atelier-row-head">
												<h3>{review.data.title}</h3>
											</div>
											{meta && (
												<div class="atelier-row-meta">
													<span>{meta}</span>
												</div>
											)}
										</a>
									</li>
								);
							})}
						</ul>
					</section>
				)}

				{visiblePaths.length > 0 && (
					<section class="research-section" aria-labelledby="research-paths-heading">
						<div class="section-head">
							<div class="column-heading">
								<h2 id="research-paths-heading">{t('paths.title')}</h2>
							</div>
							<p class="section-note">{t('paths.subtitle')}</p>
						</div>
						<ul class="atelier-rows">
							{visiblePaths.map(({ path, steps }) => (
								<li class="atelier-row">
									<a href={getLearningPathUrl(lang, path.id)} class="atelier-row-link">
										<div class="atelier-row-head">
											<h3>{getLocalizedPathText(path.title, lang)}</h3>
										</div>
										<div class="atelier-row-meta">
											<span>{formatStepCount(steps.length)}</span>
										</div>
										<p class="atelier-row-note">{getLocalizedPathText(path.description, lang)}</p>
									</a>
								</li>
							))}
						</ul>
					</section>
				)}

				{topicsWithPapers.length > 0 && (
					<section class="research-section" aria-labelledby="research-topics-heading">
						<div class="section-head">
							<div class="column-heading">
								<h2 id="research-topics-heading">{t('research.section.topics.title')}</h2>
							</div>
							<p class="section-note">{t('research.section.topics.description')}</p>
						</div>
						<ul class="atelier-rows">
							{topicsWithPapers.map(({ topic, papers }) => (
								<li class="atelier-row">
									<a href={`/${lang}/research/topics/${topic.data.id}/`} class="atelier-row-link">
										<div class="atelier-row-head">
											<h3>{getTopicLabel(topic, lang)}</h3>
										</div>
										<div class="atelier-row-meta">
											<span>{formatTopicItemCount(papers.length)}</span>
										</div>
									</a>
								</li>
							))}
						</ul>
					</section>
				)}

				{featuredTopics.length > 0 && (
					<section class="research-section" aria-labelledby="research-featured-topics-heading">
						<div class="section-head">
							<div class="column-heading">
								<h2 id="research-featured-topics-heading">{t('research.section.featured-topics.title')}</h2>
							</div>
							<p class="section-note">{t('research.section.featured-topics.description')}</p>
						</div>
						<ul class="atelier-rows">
							{featuredTopics.map((topic) => {
								const isLinked = linkableTopicIds.has(topic.data.id);
								const label = getTopicLabel(topic, lang);
								const topicDescription = getTopicDescription(topic, lang);
								const keywords = topic.data.positiveKeywords.slice(0, 5);
								const content = (
									<>
										<div class="atelier-row-head">
											<h3>{label}</h3>
										</div>
										<p class="atelier-row-note">{topicDescription}</p>
										{keywords.length > 0 && (
											<div class="chip-list atelier-row-chips" aria-label={t('library.topic-keywords')}>
												{keywords.map((keyword) => <span class="chip">{keyword}</span>)}
											</div>
										)}
									</>
								);

								return (
									<li class="atelier-row">
										{isLinked ? (
											<a href={`/${lang}/research/topics/${topic.data.id}/`} class="atelier-row-link">
												{content}
											</a>
										) : (
											content
										)}
									</li>
								);
							})}
						</ul>
					</section>
				)}

				{listedDeckCount > 0 && (
					<section class="research-section" aria-labelledby="research-decks-heading">
						<div class="section-head">
							<div class="column-heading">
								<h2 id="research-decks-heading">{t('research.section.decks.title')}</h2>
							</div>
						</div>
						<ul class="atelier-rows">
							<li class="atelier-row">
								<a href={`/${lang}/research/decks/`} class="atelier-row-link">
									<div class="atelier-row-head">
										<h3>{t('library.section.decks.title')}</h3>
									</div>
									<div class="atelier-row-meta">
										<span>{formatItemCount(listedDeckCount)}</span>
									</div>
								</a>
							</li>
						</ul>
					</section>
				)}
			</div>
		</main>
	</body>
</html>
