---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import LibraryIcon from '../../components/library/LibraryIcon.astro';
import LibraryPageStyles from '../../components/library/LibraryPageStyles.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../i18n/ui';
import { getAllPosts } from '../../utils/blog';
import { getBlogUrlFromPost } from '../../utils/blog-routing';
import { decks } from '../../data/decks';
import { getAcceptanceStatusDisplayName, getHonorDisplayName } from '../../data/paperVocabularies';
import { getVenueDisplayName } from '../../data/venues';
import {
	formatPaperAuthors,
	getAcademicReviewsByLanguage,
	getAcademicReviewUrlFromEntry,
	getPublishedAcademicReviews,
} from '../../utils/academic-review-routing';
import { learningPaths } from '../../data/learningPaths';
import {
	getLearningPathUrl,
	getLocalizedPathText,
	getVisibleLearningPaths,
	resolveLearningPathSteps,
} from '../../utils/learning-paths';
import {
	getActiveTopics,
	getFeaturedTopics,
	getPaperTldr,
	getTopicDescription,
	getTopicLabel,
} from '../../utils/library';
import {
	getPostsForPaper,
	getReviewForPaper,
	getSelectedNotYetStudied,
	getStudyLog,
	getTopicsWithLinkedPapers,
	type AcademicReviewEntry,
	type BlogEntry,
} from '../../utils/research';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = `${t('research.title')} - Hun-Bot Blog`;
const description = t('research.meta.description');

const allPapers = await getCollection('papers');
const allTopics = await getCollection('topics');
const allReviews = getPublishedAcademicReviews(await getCollection('academicReviews'));
const allPosts = await getAllPosts();

const reviews = getAcademicReviewsByLanguage(allReviews, lang);
const studyLog = getStudyLog(allPapers);
const selected = getSelectedNotYetStudied(allPapers);
const topicsWithPapers = getTopicsWithLinkedPapers(allTopics, allPapers);

const visiblePaths = getVisibleLearningPaths(learningPaths, allPosts, lang).map((path) => ({
	path,
	steps: resolveLearningPathSteps(path, allPosts, lang),
}));

// Decks and Featured Topics render unconditionally below (there is always at
// least one listed deck and one active topic today), so the hub as a whole
// is never empty anymore. The honest empty line is scoped to just the
// paper/study-log part (docs/decisions/site-structure.md).
const hasStudyContent = studyLog.length > 0 || selected.length > 0;

const listedDeckCount = decks.filter((deck) => deck.placement === 'paper' || deck.placement === 'project').length;

const featuredTopics = getFeaturedTopics(getActiveTopics(allTopics), 6);
const linkableTopicIds = new Set(topicsWithPapers.map(({ topic }) => topic.data.id));

type PaperEntry = (typeof studyLog)[number];

function getLinksForPaper(paper: PaperEntry): { review: AcademicReviewEntry | null; posts: BlogEntry[] } {
	return {
		review: getReviewForPaper(allReviews, paper.data.id),
		posts: getPostsForPaper(allPosts, paper.data.id),
	};
}

const panelClass = 'library-panel';
const subtlePillClass = 'library-pill';
const actionLinkClass = 'library-action';
const externalActionClass = `${actionLinkClass} library-action--external`;
const formatTopicItemCount = (count: number) => t('research.topic-item-count').replace('{count}', String(count));
const formatStepCount = (count: number) => t('paths.step-count').replace('{count}', String(count));
const formatItemCount = (count: number) => t('library.item-count').replace('{count}', String(count));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<LibraryPageStyles />
		<meta data-pagefind-meta="title[content]" content={t('research.title')} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="research" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="library-page mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8" data-pagefind-body>
			<section class="mb-8 max-w-5xl space-y-3">
				<div class="space-y-2">
					<h1 class="text-4xl font-bold tracking-normal text-slate-100 sm:text-5xl">{t('research.title')}</h1>
					<p class="text-xl leading-relaxed text-slate-300">{t('research.subtitle')}</p>
					<p class="leading-relaxed text-slate-400">{description}</p>
				</div>
			</section>

			{!hasStudyContent && (
				<section class={`${panelClass} mb-10`}>
					<p class="leading-relaxed text-slate-400">{t('research.empty')}</p>
				</section>
			)}

			{studyLog.length > 0 && (
				<section class="mb-10 space-y-4" aria-labelledby="research-study-log-heading">
					<div>
						<h2 id="research-study-log-heading" class="text-2xl font-bold text-slate-100">
							{t('research.section.study-log.title')}
						</h2>
						<p class="mt-1 text-slate-400">{t('research.section.study-log.description')}</p>
					</div>
					<div class="grid gap-4 lg:grid-cols-3">
						{studyLog.map((paper) => {
							const { review, posts } = getLinksForPaper(paper);
							return (
								<article class={panelClass}>
									<div class="mb-3 flex flex-wrap gap-2">
										{getVenueDisplayName(paper.data.venue) && (
											<span class={subtlePillClass}>{getVenueDisplayName(paper.data.venue)}</span>
										)}
										{paper.data.year && <span class={subtlePillClass}>{paper.data.year}</span>}
										{getAcceptanceStatusDisplayName(paper.data.acceptanceStatus) && (
											<span class={subtlePillClass}>{getAcceptanceStatusDisplayName(paper.data.acceptanceStatus)}</span>
										)}
										{paper.data.honors.map((honor) => (
											<span class={subtlePillClass}>{getHonorDisplayName(honor)}</span>
										))}
									</div>
									<h3 class="mb-2 text-lg font-semibold text-slate-100">{paper.data.title}</h3>
									<p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
										{t('research.studied-at').replace('{date}', paper.data.studiedAt as string)}
									</p>
									<p class="mb-5 text-sm leading-relaxed text-slate-400">{getPaperTldr(paper, lang)}</p>
									<div class="flex flex-wrap gap-2">
										<a href={paper.data.url} target="_blank" rel="noopener noreferrer" class={externalActionClass}>
											{t('research.view-source')}
											<LibraryIcon name="external" />
										</a>
										{review && (
											<a href={getAcademicReviewUrlFromEntry(review)} class={actionLinkClass}>
												{t('research.view-review')}
												<LibraryIcon name="arrow-right" />
											</a>
										)}
										{posts.map((post) => (
											<a href={getBlogUrlFromPost(post)} class={actionLinkClass}>
												{t('research.view-post')}
												<LibraryIcon name="arrow-right" />
											</a>
										))}
									</div>
								</article>
							);
						})}
					</div>
				</section>
			)}

			{selected.length > 0 && (
				<section class="mb-10 space-y-4" aria-labelledby="research-selected-heading">
					<div>
						<h2 id="research-selected-heading" class="text-2xl font-bold text-slate-100">
							{t('research.section.selected.title')}
						</h2>
						<p class="mt-1 text-slate-400">{t('research.section.selected.description')}</p>
					</div>
					<div class="research-selected-grid grid gap-4 lg:grid-cols-3">
						{selected.map((paper) => (
							<article class={`${panelClass} research-selected-panel`}>
								<div class="mb-3 flex flex-wrap gap-2">
									<span class="library-badge library-badge--muted">{t('research.section.selected.badge')}</span>
									{getVenueDisplayName(paper.data.venue) && (
										<span class={subtlePillClass}>{getVenueDisplayName(paper.data.venue)}</span>
									)}
									{paper.data.year && <span class={subtlePillClass}>{paper.data.year}</span>}
								</div>
								<h3 class="mb-3 text-lg font-semibold text-slate-100">{paper.data.title}</h3>
								<p class="mb-5 text-sm leading-relaxed text-slate-400">{getPaperTldr(paper, lang)}</p>
								<a href={paper.data.url} target="_blank" rel="noopener noreferrer" class={externalActionClass}>
									{t('research.view-source')}
									<LibraryIcon name="external" />
								</a>
							</article>
						))}
					</div>
				</section>
			)}

			{reviews.length > 0 && (
				<section class="mb-10 space-y-4" aria-labelledby="research-reviews-heading">
					<div>
						<h2 id="research-reviews-heading" class="text-2xl font-bold text-slate-100">
							{t('research.section.reviews.title')}
						</h2>
					</div>
					<div class="grid gap-4 lg:grid-cols-3">
						{reviews.map((review) => {
							const paperSource = [
								review.data.paper.venue,
								review.data.paper.year ? String(review.data.paper.year) : null,
							].filter(Boolean).join(' · ');
							return (
								<a href={getAcademicReviewUrlFromEntry(review)} class={`${panelClass} library-panel-link`}>
									{paperSource && (
										<div class="mb-3 flex flex-wrap gap-2">
											<span class={subtlePillClass}>{paperSource}</span>
										</div>
									)}
									<h3 class="mb-3 text-lg font-semibold text-slate-100">{review.data.title}</h3>
									<p class="text-sm leading-relaxed text-slate-400">{formatPaperAuthors(review.data.paper.authors)}</p>
								</a>
							);
						})}
					</div>
				</section>
			)}

			{visiblePaths.length > 0 && (
				<section class="mb-10 space-y-4" aria-labelledby="research-paths-heading">
					<div>
						<h2 id="research-paths-heading" class="text-2xl font-bold text-slate-100">
							{t('paths.title')}
						</h2>
						<p class="mt-1 text-slate-400">{t('paths.subtitle')}</p>
					</div>
					<div class="grid gap-4 md:grid-cols-2">
						{visiblePaths.map(({ path, steps }) => (
							<a href={getLearningPathUrl(lang, path.id)} class={`${panelClass} library-panel-link`}>
								<h3 class="mb-3 text-lg font-semibold text-slate-100">{getLocalizedPathText(path.title, lang)}</h3>
								<p class="mb-5 text-sm leading-relaxed text-slate-400">{getLocalizedPathText(path.description, lang)}</p>
								<div class="library-panel-footer">
									<span class="font-medium library-muted-label">{formatStepCount(steps.length)}</span>
									<span class="library-section-button">
										{t('paths.open-path')}
										<LibraryIcon name="arrow-right" />
									</span>
								</div>
							</a>
						))}
					</div>
				</section>
			)}

			{topicsWithPapers.length > 0 && (
				<section class="mb-10 space-y-4" aria-labelledby="research-topics-heading">
					<div>
						<h2 id="research-topics-heading" class="text-2xl font-bold text-slate-100">
							{t('research.section.topics.title')}
						</h2>
						<p class="mt-1 text-slate-400">{t('research.section.topics.description')}</p>
					</div>
					<div class="grid gap-4 md:grid-cols-2">
						{topicsWithPapers.map(({ topic, papers }) => (
							<a href={`/${lang}/research/topics/${topic.data.id}/`} class={`${panelClass} library-panel-link`}>
								<h3 class="mb-3 text-lg font-semibold text-slate-100">{getTopicLabel(topic, lang)}</h3>
								<div class="library-panel-footer">
									<span class="font-medium library-muted-label">{formatTopicItemCount(papers.length)}</span>
									<span class="library-section-button">
										{t('library.open-section')}
										<LibraryIcon name="arrow-right" />
									</span>
								</div>
							</a>
						))}
					</div>
				</section>
			)}

			{listedDeckCount > 0 && (
				<section class="mb-10 space-y-4" aria-labelledby="research-decks-heading">
					<div>
						<h2 id="research-decks-heading" class="text-2xl font-bold text-slate-100">
							{t('research.section.decks.title')}
						</h2>
					</div>
					<div class="grid gap-4 md:grid-cols-2">
						<a href={`/${lang}/research/decks/`} class={`${panelClass} library-panel-link`}>
							<h3 class="mb-3 text-lg font-semibold text-slate-100">{t('library.section.decks.title')}</h3>
							<div class="library-panel-footer">
								<span class="font-medium library-muted-label">{formatItemCount(listedDeckCount)}</span>
								<span class="library-section-button">
									{t('library.open-section')}
									<LibraryIcon name="arrow-right" />
								</span>
							</div>
						</a>
					</div>
				</section>
			)}

			{featuredTopics.length > 0 && (
				<section class="mb-10 space-y-4" aria-labelledby="research-featured-topics-heading">
					<div>
						<h2 id="research-featured-topics-heading" class="text-2xl font-bold text-slate-100">
							{t('research.section.featured-topics.title')}
						</h2>
						<p class="mt-1 text-slate-400">{t('research.section.featured-topics.description')}</p>
					</div>
					<div class="grid gap-4 md:grid-cols-2">
						{featuredTopics.map((topic) => {
							const isLinked = linkableTopicIds.has(topic.data.id);
							const label = getTopicLabel(topic, lang);
							const topicDescription = getTopicDescription(topic, lang);
							const keywords = topic.data.positiveKeywords.slice(0, 5);
							const keywordPills = keywords.length > 0 && (
								<div class="mt-4 flex flex-wrap gap-2" aria-label={t('library.topic-keywords')}>
									{keywords.map((keyword) => <span class={subtlePillClass}>{keyword}</span>)}
								</div>
							);

							return isLinked ? (
								<a href={`/${lang}/research/topics/${topic.data.id}/`} class={`${panelClass} library-panel-link`}>
									<h3 class="mb-3 text-lg font-semibold text-slate-100">{label}</h3>
									<p class="text-sm leading-relaxed text-slate-400">{topicDescription}</p>
									{keywordPills}
								</a>
							) : (
								<article class={panelClass}>
									<h3 class="mb-3 text-lg font-semibold text-slate-100">{label}</h3>
									<p class="text-sm leading-relaxed text-slate-400">{topicDescription}</p>
									{keywordPills}
								</article>
							);
						})}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.research-selected-panel {
		opacity: 0.86;
	}

	.research-selected-panel:hover,
	.research-selected-panel:focus-within {
		opacity: 1;
	}
</style>
