---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../i18n/ui';
import { decks } from '../../data/decks';
import {
	getActiveTopics,
	getApprovedPapers,
	getApprovedResources,
	getFeaturedResources,
	getPaperTldr,
	getResourceSummary,
	getTopicDescription,
	getTopicLabel,
} from '../../utils/library';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = `${t('library.title')} - Hun-Bot Blog`;
const description = t('library.description');
const searchUrl = `/${lang}/search/`;

const allResources = await getCollection('resources');
const allPapers = await getCollection('papers');
const allTopics = await getCollection('topics');

const approvedResources = getApprovedResources(allResources);
const approvedPapers = getApprovedPapers(allPapers);
const activeTopics = getActiveTopics(allTopics);

const featuredResources = getFeaturedResources(approvedResources, 3);
const featuredPapers = approvedPapers.slice(0, 3);
const featuredTopics = activeTopics.slice(0, 6);

const resourcesBySection = approvedResources.reduce<Record<string, number>>((counts, resource) => {
	counts[resource.data.section] = (counts[resource.data.section] ?? 0) + 1;
	return counts;
}, {});

const formatCount = (count: number) => t('library.item-count').replace('{count}', String(count));

const sectionCards = [
	{
		id: 'design',
		title: t('library.section.design.title'),
		description: t('library.section.design.description'),
		count: resourcesBySection.design ?? 0,
	},
	{
		id: 'vibe-coding',
		title: t('library.section.vibe-coding.title'),
		description: t('library.section.vibe-coding.description'),
		count: resourcesBySection['vibe-coding'] ?? 0,
	},
	{
		id: 'dev-docs',
		title: t('library.section.dev-docs.title'),
		description: t('library.section.dev-docs.description'),
		count: resourcesBySection['dev-docs'] ?? 0,
	},
	{
		id: 'ai-papers',
		title: t('library.section.ai-papers.title'),
		description: t('library.section.ai-papers.description'),
		count: approvedPapers.length,
	},
	{
		id: 'useful-feeds',
		title: t('library.section.useful-feeds.title'),
		description: t('library.section.useful-feeds.description'),
		count: resourcesBySection['useful-feeds'] ?? 0,
	},
	{
		id: 'decks',
		title: t('library.section.decks.title'),
		description: t('library.section.decks.description'),
		count: decks.length,
	},
];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<meta data-pagefind-meta="title[content]" content={t('library.title')} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="library" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8" data-pagefind-body>
			<section class="mb-12 max-w-3xl space-y-5">
				<p class="inline-flex rounded-lg border border-orange-400/40 bg-orange-500/10 px-3 py-1 text-sm font-semibold text-orange-300">
					{t('library.human-reviewed')}
				</p>
				<div class="space-y-4">
					<h1 class="text-4xl font-bold tracking-normal text-slate-100 sm:text-5xl">{t('library.title')}</h1>
					<p class="text-xl leading-relaxed text-slate-300">{t('library.subtitle')}</p>
					<p class="leading-relaxed text-slate-400">{description}</p>
				</div>
			</section>

			<section class="mb-14 space-y-6" aria-labelledby="library-sections-heading">
				<div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
					<div>
						<h2 id="library-sections-heading" class="text-2xl font-bold text-slate-100">
							{t('library.sections.title')}
						</h2>
						<p class="mt-2 max-w-2xl text-slate-400">{t('library.sections.description')}</p>
					</div>
				</div>
				<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
					{sectionCards.map((section) => {
						const isAvailable = section.count > 0;
						return (
							<article class="rounded-lg border border-slate-700 bg-slate-900/70 p-5">
								<div class="mb-4 flex items-start justify-between gap-4">
									<h3 class="text-lg font-semibold text-slate-100">{section.title}</h3>
									<span class:list={[
										'rounded-lg border px-2 py-1 text-xs font-semibold',
										isAvailable
											? 'border-emerald-400/40 bg-emerald-500/10 text-emerald-200'
											: 'border-slate-600 bg-slate-800 text-slate-300',
									]}>
										{isAvailable ? t('library.available') : t('library.coming-soon')}
									</span>
								</div>
								<p class="min-h-[4rem] text-sm leading-relaxed text-slate-400">{section.description}</p>
								<div class="mt-5 flex items-center justify-between gap-3 border-t border-slate-800 pt-4 text-sm">
									<span class="font-medium text-slate-300">{formatCount(section.count)}</span>
									<span class="text-slate-500">{t('library.section-pages-deferred')}</span>
								</div>
							</article>
						);
					})}
				</div>
			</section>

			<section class="mb-14 space-y-6" aria-labelledby="featured-resources-heading">
				<div>
					<h2 id="featured-resources-heading" class="text-2xl font-bold text-slate-100">
						{t('library.featured-resources')}
					</h2>
					<p class="mt-2 text-slate-400">{t('library.featured-resources.description')}</p>
				</div>
				<div class="grid gap-4 lg:grid-cols-3">
					{featuredResources.map((resource) => (
						<article class="rounded-lg border border-slate-700 bg-slate-900/70 p-5">
							<div class="mb-3 flex flex-wrap gap-2">
								<span class="rounded-lg bg-slate-800 px-2 py-1 text-xs font-semibold text-slate-300">{resource.data.section}</span>
								<span class="rounded-lg bg-slate-800 px-2 py-1 text-xs font-semibold text-slate-300">{resource.data.type}</span>
							</div>
							<h3 class="mb-3 text-lg font-semibold text-slate-100">{resource.data.title}</h3>
							<p class="mb-5 text-sm leading-relaxed text-slate-400">{getResourceSummary(resource, lang)}</p>
							<a
								href={resource.data.url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex min-h-10 items-center rounded-lg border border-orange-400/60 px-3 py-2 text-sm font-semibold text-orange-200 transition-colors hover:bg-orange-500/10"
							>
								{t('library.view-resource')}
							</a>
						</article>
					))}
				</div>
			</section>

			<section class="mb-14 space-y-6" aria-labelledby="featured-topics-heading">
				<div>
					<h2 id="featured-topics-heading" class="text-2xl font-bold text-slate-100">
						{t('library.featured-topics')}
					</h2>
					<p class="mt-2 text-slate-400">{t('library.featured-topics.description')}</p>
				</div>
				<div class="grid gap-4 md:grid-cols-2">
					{featuredTopics.map((topic) => (
						<article class="rounded-lg border border-slate-700 bg-slate-900/70 p-5">
							<h3 class="mb-3 text-lg font-semibold text-slate-100">{getTopicLabel(topic, lang)}</h3>
							<p class="text-sm leading-relaxed text-slate-400">{getTopicDescription(topic, lang)}</p>
							{topic.data.positiveKeywords.length > 0 && (
								<div class="mt-4 flex flex-wrap gap-2" aria-label={t('library.topic-keywords')}>
									{topic.data.positiveKeywords.slice(0, 5).map((keyword) => (
										<span class="rounded-lg bg-slate-800 px-2 py-1 text-xs text-slate-300">{keyword}</span>
									))}
								</div>
							)}
						</article>
					))}
				</div>
			</section>

			{featuredPapers.length > 0 && (
				<section class="mb-14 space-y-6" aria-labelledby="featured-papers-heading">
					<div>
						<h2 id="featured-papers-heading" class="text-2xl font-bold text-slate-100">
							{t('library.featured-papers')}
						</h2>
						<p class="mt-2 text-slate-400">{t('library.featured-papers.description')}</p>
					</div>
					<div class="grid gap-4 lg:grid-cols-3">
						{featuredPapers.map((paper) => (
							<article class="rounded-lg border border-slate-700 bg-slate-900/70 p-5">
								<div class="mb-3 flex flex-wrap gap-2">
									{paper.data.venue && (
										<span class="rounded-lg bg-slate-800 px-2 py-1 text-xs font-semibold text-slate-300">{paper.data.venue}</span>
									)}
									{paper.data.year && (
										<span class="rounded-lg bg-slate-800 px-2 py-1 text-xs font-semibold text-slate-300">{paper.data.year}</span>
									)}
									<span class="rounded-lg bg-slate-800 px-2 py-1 text-xs font-semibold text-slate-300">{paper.data.priority}</span>
								</div>
								<h3 class="mb-3 text-lg font-semibold text-slate-100">{paper.data.title}</h3>
								<p class="mb-5 text-sm leading-relaxed text-slate-400">{getPaperTldr(paper, lang)}</p>
								<a
									href={paper.data.url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex min-h-10 items-center rounded-lg border border-orange-400/60 px-3 py-2 text-sm font-semibold text-orange-200 transition-colors hover:bg-orange-500/10"
								>
									{t('library.view-paper')}
								</a>
							</article>
						))}
					</div>
				</section>
			)}

			<section class="grid gap-4 rounded-lg border border-slate-700 bg-slate-900/70 p-5 md:grid-cols-[1fr_auto] md:items-center">
				<div>
					<h2 class="text-xl font-bold text-slate-100">{t('library.review-note.title')}</h2>
					<p class="mt-2 leading-relaxed text-slate-400">{t('library.review-note.body')}</p>
				</div>
				<a
					href={searchUrl}
					class="inline-flex min-h-10 items-center justify-center rounded-lg bg-orange-500 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-orange-400"
				>
					{t('library.search-cta')}
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
