---
// 외부 링크 tab — the Library's default route (docs/decisions/site-structure.md,
// revision 2026-09-27). Data comes entirely from the `picks` collection now:
// the old section-card grid, Featured Resources, and Featured Topics are
// gone. `getFeaturedTopics`/`getFeaturedResources` in src/utils/library.ts
// are left in place (tests and a later commit still use them) even though
// this page no longer calls them.
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import LibraryPageStyles from '../../components/library/LibraryPageStyles.astro';
import LibraryTabs from '../../components/library/LibraryTabs.astro';
import PickCard from '../../components/library/PickCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../i18n/ui';
import { librarySections as pickLibrarySections } from '../../data/librarySections';
import { pickTiers, recentPicksLimit } from '../../data/libraryPolicy';
import { computePickTier, getPickSectionCounts, type PopularitySnapshot } from '../../utils/picks';
import { sortStable } from '../../utils/ordering';
import popularity from '../../data/popularity.json';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = `${t('library.title')} - Hun-Bot Blog`;
const description = t('library.description');

const allPicks = await getCollection('picks');
const publishedPicks = allPicks.filter((pick) => pick.data.draft !== true);
const totalPickCount = publishedPicks.length;

// Section filter chips: hide a section entirely at 0 published picks
// (docs/decisions/site-structure.md#5 — empty sections are hidden, not
// shown as "0개 / 준비 중"). Shared with each pick section page so the two
// surfaces cannot disagree about which sections are visible.
const sectionCounts = getPickSectionCounts(publishedPicks);
const visibleSections = pickLibrarySections
	.map((section) => ({ slug: section.slug, label: section.label, count: sectionCounts.get(section.slug) ?? 0 }))
	.filter((section) => section.count > 0);

// "최근 추가": the latest published picks by addedAt, newest first.
// sortStable's own id tiebreak keeps this deterministic across builds.
const recentPicks = sortStable(publishedPicks, (a, b) => b.data.addedAt.localeCompare(a.data.addedAt)).slice(
	0,
	recentPicksLimit,
);

// Tier groups in pickTiers order (필수 / 인기 / 발굴), each stably sorted by
// title; an empty tier is skipped entirely.
const tierGroups = pickTiers
	.map((tier) => ({
		tier,
		picks: sortStable(
			publishedPicks.filter((pick) => computePickTier(pick.data, popularity as PopularitySnapshot, pickTiers).tier === tier.id),
			(a, b) => a.data.title.localeCompare(b.data.title),
		),
	}))
	.filter((group) => group.picks.length > 0);

const now = new Date();
const panelClass = 'library-panel';
const chipAllLabel = t('library.chip.all').replace('{count}', String(totalPickCount));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<LibraryPageStyles />
		<meta data-pagefind-meta="title[content]" content={t('library.title')} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="library" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="library-page mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8" data-pagefind-body>
			<section class="mb-8 max-w-5xl space-y-3">
				<div class="space-y-2">
					<h1 class="text-4xl font-bold tracking-normal text-slate-100 sm:text-5xl">{t('library.title')}</h1>
					<p class="text-xl leading-relaxed text-slate-300">{t('library.subtitle')}</p>
					<p class="leading-relaxed text-slate-400">{description}</p>
				</div>
				<LibraryTabs lang={lang} active="external-links" />
			</section>

			{totalPickCount === 0 ? (
				<section class={`${panelClass} mb-10`}>
					<p class="text-slate-400">{t('library.empty.no-picks')}</p>
				</section>
			) : (
				<>
					<section class="mb-8 space-y-3" aria-label={chipAllLabel}>
						<div class="flex flex-wrap gap-2">
							<a href={`/${lang}/library/`} class="library-chip" aria-current="page">
								{chipAllLabel}
							</a>
							{visibleSections.map((section) => (
								<a href={`/${lang}/library/${section.slug}/`} class="library-chip">
									{section.label[lang]} {section.count}
								</a>
							))}
						</div>
					</section>

					{recentPicks.length > 0 && (
						<section class="mb-10 space-y-4" aria-labelledby="library-recent-heading">
							<h2 id="library-recent-heading" class="text-2xl font-bold text-slate-100">
								{t('library.recent-added')}
							</h2>
							<div class="grid gap-4 lg:grid-cols-3">
								{recentPicks.map((pick) => <PickCard pick={pick} lang={lang} now={now} showSection={true} />)}
							</div>
						</section>
					)}

					{tierGroups.map((group) => (
						<section class="mb-10 space-y-4" aria-labelledby={`library-tier-${group.tier.id}-heading`}>
							<div>
								<h2 id={`library-tier-${group.tier.id}-heading`} class="text-2xl font-bold text-slate-100">
									{group.tier.label[lang]}
								</h2>
								<p class="mt-1 text-slate-400">{group.tier.description[lang]}</p>
							</div>
							<div class="grid gap-4 lg:grid-cols-3">
								{group.picks.map((pick) => <PickCard pick={pick} lang={lang} now={now} showSection={true} />)}
							</div>
						</section>
					))}
				</>
			)}
		</main>
		<Footer />
	</body>
</html>
