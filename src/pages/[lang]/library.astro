---
// The Library (docs/decisions/site-structure.md, revisions 2026-10-04,
// 2026-10-23 and 2026-10-23c): the one curated list of external tools, repos
// and sites you use, as a card grid under category tabs (분야). Resources and
// picks render together (src/utils/library.ts's getLibraryItems) —
// /{lang}/library/useful-feeds/ redirects here. Explainers, signals and weekly
// notes are the Reading section's (/{lang}/reading/). The tabs filter the grid
// through public/scripts/blog-filters.js (facet `area`).
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import AreaTabs from '../../components/library/AreaTabs.astro';
import ResourceCard from '../../components/library/ResourceCard.astro';
import { useTranslations, type UILanguage } from '../../i18n/ui';
import { getAreaTabs } from '../../utils/library-area-tabs';
import { getLibraryViewData } from '../../utils/library-views';
import '../../styles/lists.css';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = `${t('library.title')} - Hun-Bot Blog`;
const description = t('library.description');

const { items } = await getLibraryViewData(lang);
const tabs = getAreaTabs(items, lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<meta data-pagefind-meta="title[content]" content={t('library.title')} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="library" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="atelier-page library-page" data-pagefind-body>
			<section class="subpage-intro subpage-intro--flush">
				<h1 class="eyebrow">{t('library.title')}</h1>
			</section>

			{items.length === 0 ? (
				<p class="page-frame library-empty">{t('library.empty')}</p>
			) : (
				<Fragment>
					<AreaTabs lang={lang} tabs={tabs} storageKey="hunbot-library-area" />

					<div class="page-frame library-archive" data-blog-posts>
						<ul class="library-grid">
							{items.map((item) => <ResourceCard item={item} lang={lang} />)}
						</ul>
					</div>

					<p class="page-frame library-empty" data-blog-empty hidden>{t('library.filter-no-results')}</p>
				</Fragment>
			)}
		</main>
		<script type="module" src="/scripts/blog-filters.js"></script>
	</body>
</html>

<style>
	/* The card grid is wider than the 980px reading column: four cards need room.
	   Only this page's frame (label, tabs, grid) widens, so they share one left edge. */
	.library-page {
		--content-max: 1180px;
	}

	.library-archive {
		padding: 1.5rem 0 1rem;
	}

	.library-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 560px) {
		.library-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 820px) {
		.library-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 1100px) {
		.library-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.library-empty {
		margin-block: 1rem 4rem;
		color: var(--secondary);
	}
</style>
