---
// The Library (docs/decisions/site-structure.md, revision 2026-10-04): one
// list of external tools, repos and sites as image cards, filtered with the
// same floating filter the blog uses. It used to be split into 외부 링크
// (`picks`) and Useful Feeds (`resources` from research-os) tabs — a
// distinction of where an item was written, which visitors cannot see — so
// both collections now render here together (src/utils/library.ts's
// getLibraryItems) and /{lang}/library/useful-feeds/ redirects here.
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import BlogFilterBar from '../../components/blog/BlogFilterBar.astro';
import LibraryRow from '../../components/library/LibraryRow.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../i18n/ui';
import { getLibraryItems } from '../../utils/library';
import { getLibraryKindLabel, getLibraryTopicLabel } from '../../utils/library-labels';
import { getLibraryArea, libraryAreas } from '../../data/libraryAreas';
import '../../styles/lists.css';
import '../../styles/entry-list.css';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = `${t('library.title')} - Hun-Bot Blog`;
const description = t('library.description');

const items = getLibraryItems(await getCollection('resources'), await getCollection('picks'), lang);

// Facet options with counts, most common first (ties by label).
function facetOptions(values: string[], label: (value: string) => string) {
	const counts = new Map<string, number>();
	for (const value of values) counts.set(value, (counts.get(value) ?? 0) + 1);
	return [...counts]
		.map(([value, count]) => ({ value, label: label(value), count }))
		.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
}

// 분야 keeps the registry order (src/data/libraryAreas.ts), 기타 last; each
// 주제 chip belongs to its items' area, so picking an area narrows the topics.
const areaOrder = [...libraryAreas.map((area) => area.id), 'other'];
const areaOptions = facetOptions(items.map((item) => item.area), (area) => getLibraryArea(area).label[lang]).sort(
	(a, b) => areaOrder.indexOf(a.value) - areaOrder.indexOf(b.value),
);
const areaOfTopic = new Map(items.map((item) => [item.topic, item.area]));
const topicOptions = facetOptions(items.map((item) => item.topic), (topic) => getLibraryTopicLabel(topic, lang))
	.map((option) => ({ ...option, parent: { facet: 'area', value: areaOfTopic.get(option.value)! } }))
	.sort((a, b) => areaOrder.indexOf(a.parent.value) - areaOrder.indexOf(b.parent.value));

// One section per area that has items, in registry order (기타 last).
const sections = areaOrder
	.map((id) => ({ id, label: getLibraryArea(id).label[lang], items: items.filter((item) => item.area === id) }))
	.filter((section) => section.items.length > 0);

const filterGroups = [
	{ facet: 'area', label: t('library.filter-area'), options: areaOptions },
	{ facet: 'topic', label: t('library.filter-topic'), options: topicOptions },
	{ facet: 'kind', label: t('library.filter-kind'), options: facetOptions(items.map((item) => item.kind), (kind) => getLibraryKindLabel(kind, lang)) },
];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<meta data-pagefind-meta="title[content]" content={t('library.title')} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="library" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="atelier-page" data-pagefind-body>
			<section class="subpage-intro">
				<h1 class="eyebrow">{t('library.title')}</h1>
			</section>

			{items.length === 0 ? (
				<p class="page-frame library-empty">{t('library.empty')}</p>
			) : (
				<Fragment>
					<BlogFilterBar
						lang={lang}
						groups={filterGroups}
						storageKey="hunbot-library-filters"
						resultsTemplate={t('library.filter-results')}
						label={t('library.filter-label')}
						totalCount={items.length}
					/>

					<div class="page-frame library-archive" data-blog-posts>
						{sections.map((section) => (
							<section class="library-section" id={`area-${section.id}`} aria-labelledby={`area-${section.id}-title`} data-filter-section>
								<div class="library-section-head">
									<h2 id={`area-${section.id}-title`}>{section.label}</h2>
								</div>
								<ul class="entry-list">
									{section.items.map((item) => (
										<LibraryRow
											item={item}
											kindLabel={getLibraryKindLabel(item.kind, lang)}
											topicLabel={getLibraryTopicLabel(item.topic, lang)}
										/>
									))}
								</ul>
							</section>
						))}
					</div>

					<p class="page-frame library-empty" data-blog-empty hidden>{t('library.filter-no-results')}</p>
				</Fragment>
			)}
		</main>
		<script type="module" src="/scripts/blog-filters.js"></script>
	</body>
</html>

<style>
	/* The section heading carries the rule, so the title needs none of its own and
	   the archive starts right under it. */
	.subpage-intro {
		padding-bottom: 0.25rem;
		border-bottom: 0;
	}

	.library-archive {
		padding: 0 0 1rem;
	}

	/* Same quiet section heading as the Writing archive's years. */
	.library-section + .library-section {
		margin-top: 1rem;
	}

	.library-section[hidden] {
		display: none;
	}

	.library-section-head {
		padding: 0.25rem 0 0.4rem;
		border-bottom: 1px solid var(--rule-strong);
	}

	.library-section-head h2 {
		margin: 0;
		font: 400 1.25rem/1.3 var(--font-serif);
		letter-spacing: -0.02em;
	}

	.library-empty {
		margin-block: 0 4rem;
		color: var(--secondary);
	}


</style>
