---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import LibraryIcon from '../../components/library/LibraryIcon.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { useTranslations } from '../../i18n/ui';
import type { UILanguage } from '../../i18n/ui';
import { decks } from '../../data/decks';
import {
	formatPaperAuthors,
	getAcademicReviewsByLanguage,
	getAcademicReviewUrlFromEntry,
} from '../../utils/academic-review-routing';
import { getBlogUrlFromId } from '../../utils/blog-routing';
import {
	getHomepageLibraryPicks,
	getHomepageSectionCounts,
	getLatestBlogPosts,
	getLatestBriefPosts,
	getPostsForLanguage,
} from '../../utils/homepage';
import {
	getLibrarySectionPath,
	librarySections,
} from '../../utils/library';

export function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'jp' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang ?? 'ko') as UILanguage;
const t = useTranslations(currentLang);
const languageBasePath = `/${currentLang}`;
const blogUrl = `${languageBasePath}/blog`;
const libraryUrl = `${languageBasePath}/library`;
const reviewsUrl = `${languageBasePath}/reviews`;

const allPosts = await getCollection('blog');
const allResources = await getCollection('resources');
const allPapers = await getCollection('papers');
const allAcademicReviews = await getCollection('academicReviews');

const posts = getPostsForLanguage(allPosts, currentLang);
const latestBriefs = getLatestBriefPosts(posts, 3);
const latestPosts = getLatestBlogPosts(posts, 6);
const libraryPicks = getHomepageLibraryPicks(allResources, allPapers, 3);
const sectionCounts = getHomepageSectionCounts(allResources, allPapers, decks);
const academicReviews = getAcademicReviewsByLanguage(allAcademicReviews, currentLang).slice(0, 3);

const sectionCards = librarySections.map((section) => {
	const title = t(`library.section.${section.translationKey}.title` as Parameters<typeof t>[0]);
	const description = t(`home.library.${section.translationKey}.description` as Parameters<typeof t>[0]);
	const count = sectionCounts[section.id] ?? 0;

	return {
		...section,
		title,
		description,
		count,
		href: getLibrarySectionPath(currentLang, section.id),
		isAvailable: count > 0,
	};
});

const formatCount = (count: number) => t('library.item-count').replace('{count}', String(count));
const getPickTitle = (pick: (typeof libraryPicks)[number]) =>
	pick.kind === 'resource' ? pick.resource.data.title : pick.paper.data.title;
const getPickHref = (pick: (typeof libraryPicks)[number]) =>
	pick.kind === 'resource' ? pick.resource.data.url : pick.paper.data.url;
const getPickSectionLabel = (pick: (typeof libraryPicks)[number]) => {
	if (pick.kind === 'paper') return t('library.section.ai-papers.title');

	const section = librarySections.find(
		(item) => item.kind === 'resources' && item.resourceSection === pick.resource.data.section,
	);
	return section
		? t(`library.section.${section.translationKey}.title` as Parameters<typeof t>[0])
		: t('library.title');
};
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={t('home.meta.title')} description={t('home.meta.description')} lang={currentLang} />
		<meta data-pagefind-meta="title[content]" content={t('home.meta.title')} />
		<meta data-pagefind-meta="description[content]" content={t('home.meta.description')} />
		<meta data-pagefind-filter="language[content]" content={currentLang} />
		<meta data-pagefind-filter="section[content]" content="home" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<div class="global-wrapper" data-is-root-path="true">
			<main id="main-content" class="home-page" data-pagefind-body>
				<section class="home-section home-latest" aria-labelledby="home-latest-title">
					<div class="home-section-heading">
						<div>
							<h2 id="home-latest-title">{t('home.latest.title')}</h2>
						</div>
						<a href={blogUrl} class="home-text-link home-text-link-blog">
							<LibraryIcon name="article" class="home-action-icon" />
							<span>{t('home.latest.view-all')}</span>
							<LibraryIcon name="arrow-right" class="home-action-icon" />
						</a>
					</div>
					{latestPosts.length > 0 ? (
						<div class="home-post-grid">
							{latestPosts.map((post) => {
								const hero = post.data.heroImage ?? '/images/blank.png';
								return (
									<a href={getBlogUrlFromId(post.id)} class="home-post-card">
										<img src={hero} alt={post.data.title} loading="lazy" decoding="async" />
										<div>
											<p class="home-post-meta"><FormattedDate date={post.data.pubDate} /></p>
											<h3>{post.data.title}</h3>
											<p>{post.data.description}</p>
										</div>
									</a>
								);
							})}
						</div>
					) : (
						<div class="home-empty">{t('blog.no-posts')}</div>
					)}
				</section>

				<section class="home-feature-row" aria-label={t('home.feature-row-label')}>
					<section class="home-feature-panel home-picks" aria-labelledby="home-picks-title">
						<div class="home-section-heading">
							<div>
								<h2 id="home-picks-title">{t('home.picks.title')}</h2>
							</div>
						</div>
						{libraryPicks.length > 0 ? (
							<div class="home-pick-grid">
								{libraryPicks.map((pick) => (
									<a
										href={getPickHref(pick)}
										target="_blank"
										rel="noopener noreferrer"
										class="home-pick-card"
									>
										<span class="home-pick-label">{getPickSectionLabel(pick)}</span>
										<h3>{getPickTitle(pick)}</h3>
										<span class="home-card-icon-button" aria-hidden="true">
											<LibraryIcon name="external" class="home-action-icon" />
										</span>
									</a>
								))}
							</div>
						) : (
							<div class="home-empty">{t('home.picks.empty')}</div>
						)}
					</section>

					<section class="home-feature-panel home-reviews" aria-labelledby="home-reviews-title">
						<div class="home-section-heading">
							<div>
								<h2 id="home-reviews-title">{t('home.reviews.title')}</h2>
							</div>
							<a href={reviewsUrl} class="home-text-link home-text-link-review">
								<LibraryIcon name="article" class="home-action-icon" />
								<span>{t('home.reviews.view-all')}</span>
								<LibraryIcon name="arrow-right" class="home-action-icon" />
							</a>
						</div>
						{academicReviews.length > 0 ? (
							<div class="home-review-list">
								{academicReviews.map((review) => {
									const paper = review.data.paper;
									const source = [paper.venue, paper.year ? String(paper.year) : null].filter(Boolean).join(' · ');
									return (
										<a href={getAcademicReviewUrlFromEntry(review)} class="home-review-card">
											<div class="home-review-topline">
												<span>{source || t('home.reviews.paper')}</span>
												<FormattedDate date={review.data.pubDate} />
											</div>
											<h3>{review.data.title}</h3>
											<p>{paper.title}</p>
											<div class="home-review-footer">
												<span>{formatPaperAuthors(paper.authors)}</span>
												<LibraryIcon name="arrow-right" class="home-action-icon" />
											</div>
										</a>
									);
								})}
							</div>
						) : (
							<div class="home-empty">{t('home.reviews.empty')}</div>
						)}
					</section>
				</section>

				<section class="home-section home-library" aria-labelledby="home-library-title">
					<div class="home-section-heading">
						<div>
							<h2 id="home-library-title">{t('home.explore.title')}</h2>
						</div>
						<a href={libraryUrl} class="home-text-link home-text-link-primary">
							<LibraryIcon name="book-open" class="home-action-icon" />
							<span>{t('home.primary-cta')}</span>
							<LibraryIcon name="arrow-right" class="home-action-icon" />
						</a>
					</div>
					<div class="home-section-grid">
						{sectionCards.map((section) =>
							section.isAvailable ? (
								<a href={section.href} class="home-section-card">
									<div class="home-card-topline">
										<span>{section.title}</span>
										<span class="home-status home-status-available">{t('library.available')}</span>
									</div>
									<p>{section.description}</p>
									<div class="home-card-footer">
										<strong class="home-count-badge">{formatCount(section.count)}</strong>
										<span class="home-card-button">
											{t('library.open-section')}
											<LibraryIcon name="arrow-right" class="home-action-icon" />
										</span>
									</div>
								</a>
							) : (
								<article class="home-section-card home-section-card-disabled">
									<div class="home-card-topline">
										<span>{section.title}</span>
										<span class="home-status">{t('library.coming-soon')}</span>
									</div>
									<p>{section.description}</p>
									<div class="home-card-footer">
										<strong class="home-count-badge home-count-badge-muted">{formatCount(section.count)}</strong>
										<span class="home-card-note">{t('library.section-pages-deferred')}</span>
									</div>
								</article>
							)
						)}
					</div>
				</section>

				{latestBriefs.length > 0 && (
					<section class="home-section home-briefs" aria-labelledby="home-briefs-title">
						<div class="home-section-heading">
							<div>
								<h2 id="home-briefs-title">{t('home.briefs.title')}</h2>
							</div>
						</div>
						<div class="home-brief-list">
							{latestBriefs.map((post) => (
								<a href={getBlogUrlFromId(post.id)} class="home-brief-card">
									<FormattedDate date={post.data.pubDate} />
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							))}
						</div>
					</section>
				)}
			</main>
		</div>
		<Footer />
	</body>
</html>

<style>
	.home-page {
		--home-surface: linear-gradient(180deg, rgba(59, 55, 49, 0.94), rgba(47, 44, 40, 0.92));
		--home-surface-strong: linear-gradient(180deg, rgba(67, 61, 53, 0.96), rgba(52, 47, 42, 0.94));
		--home-border: rgba(251, 191, 36, 0.14);
		--home-border-strong: rgba(251, 146, 60, 0.34);
		--home-muted: rgba(226, 232, 240, 0.64);
		--home-faint: rgba(255, 237, 213, 0.72);
		--home-text: rgb(248, 249, 250);
		--home-accent: #fed7aa;
		--home-accent-soft: rgba(249, 115, 22, 0.11);
		--home-panel-shadow: 0 18px 44px rgba(0, 0, 0, 0.2);
		--home-blog-surface: rgba(255, 255, 255, 0.045);
		--home-blog-surface-strong: rgba(255, 255, 255, 0.075);
		--home-blog-border: rgba(248, 249, 250, 0.12);
		--home-blog-border-strong: rgba(248, 249, 250, 0.2);
		width: min(100%, var(--homepage-wide, 80rem));
		margin: 0 auto;
		padding: 1.25rem 1rem 4rem;
		color: var(--home-text);
	}

	:global(body.light-theme) .home-page {
		--home-surface: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(255, 247, 237, 0.86));
		--home-surface-strong: linear-gradient(180deg, rgb(255, 255, 255), rgba(255, 247, 237, 0.96));
		--home-border: rgba(194, 65, 12, 0.16);
		--home-border-strong: rgba(194, 65, 12, 0.22);
		--home-muted: #64748b;
		--home-faint: #9a3412;
		--home-text: rgb(15, 23, 42);
		--home-accent: #9a3412;
		--home-accent-soft: rgba(249, 115, 22, 0.1);
		--home-panel-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
		--home-blog-surface: rgba(255, 255, 255, 0.78);
		--home-blog-surface-strong: rgb(255, 255, 255);
		--home-blog-border: rgba(15, 23, 42, 0.12);
		--home-blog-border-strong: rgba(15, 23, 42, 0.2);
	}

	.home-page a {
		color: inherit !important;
		text-decoration: none;
	}

	.home-page :where(h1, h2, h3, p) {
		margin: 0;
		letter-spacing: 0;
	}

	.home-page :where(h1, h2, h3) {
		color: var(--home-text);
		line-height: 1.08;
	}

	.home-page :where(p) {
		color: var(--home-muted);
		line-height: 1.7;
	}

	.home-page :where(a, button):focus-visible {
		outline: 2px solid rgba(251, 146, 60, 0.82);
		outline-offset: 4px;
	}

	.home-text-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		flex: 0 0 auto;
		min-height: 2.45rem;
		min-width: max-content;
		border-radius: 0.5rem;
		border: 1px solid var(--home-blog-border);
		padding: 0.58rem 0.85rem;
		background: var(--home-blog-surface);
		color: var(--home-text) !important;
		font-family: var(--font-heading);
		font-size: 0.88rem;
		font-weight: 700;
		line-height: 1.2;
		white-space: nowrap;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
		transition:
			transform 160ms ease,
			border-color 160ms ease,
			background 160ms ease,
			box-shadow 160ms ease;
	}

	.home-text-link > span {
		display: inline-flex;
		align-items: center;
		white-space: nowrap;
	}

	.home-text-link:hover {
		transform: translateY(-1px);
		border-color: var(--home-blog-border-strong);
		background: var(--home-blog-surface-strong);
		box-shadow: 0 12px 26px rgba(0, 0, 0, 0.16);
		text-decoration: none;
	}

	.home-text-link-primary {
		border-color: rgba(251, 146, 60, 0.46);
		background: linear-gradient(180deg, rgba(249, 115, 22, 0.22), rgba(194, 65, 12, 0.18));
		color: #ffedd5 !important;
		box-shadow: 0 10px 26px rgba(249, 115, 22, 0.14);
	}

	.home-text-link-primary:hover,
	.home-text-link-primary:focus-visible {
		border-color: rgba(251, 146, 60, 0.68);
		background: linear-gradient(180deg, rgba(249, 115, 22, 0.3), rgba(194, 65, 12, 0.24));
		color: #fff7ed !important;
		box-shadow: 0 14px 32px rgba(249, 115, 22, 0.18);
	}

	.home-text-link-blog {
		border-color: rgba(52, 211, 153, 0.34);
		background: linear-gradient(180deg, rgba(16, 185, 129, 0.16), rgba(5, 150, 105, 0.12));
		color: #bbf7d0 !important;
		box-shadow: 0 10px 26px rgba(16, 185, 129, 0.12);
	}

	.home-text-link-blog:hover,
	.home-text-link-blog:focus-visible {
		border-color: rgba(52, 211, 153, 0.56);
		background: linear-gradient(180deg, rgba(16, 185, 129, 0.24), rgba(5, 150, 105, 0.18));
		color: #dcfce7 !important;
		box-shadow: 0 14px 32px rgba(16, 185, 129, 0.16);
	}

	.home-text-link-review {
		border-color: rgba(125, 211, 252, 0.28);
		background: linear-gradient(180deg, rgba(14, 165, 233, 0.14), rgba(2, 132, 199, 0.1));
		color: #bae6fd !important;
		box-shadow: 0 10px 26px rgba(14, 165, 233, 0.1);
	}

	.home-text-link-review:hover,
	.home-text-link-review:focus-visible {
		border-color: rgba(125, 211, 252, 0.48);
		background: linear-gradient(180deg, rgba(14, 165, 233, 0.22), rgba(2, 132, 199, 0.16));
		color: #e0f2fe !important;
		box-shadow: 0 14px 32px rgba(14, 165, 233, 0.14);
	}

	:global(body.light-theme) .home-text-link-primary {
		border-color: rgba(194, 65, 12, 0.28);
		background: linear-gradient(180deg, rgba(249, 115, 22, 0.16), rgba(255, 247, 237, 0.96));
		color: #9a3412 !important;
		box-shadow: 0 12px 26px rgba(194, 65, 12, 0.1);
	}

	:global(body.light-theme) .home-text-link-primary:hover,
	:global(body.light-theme) .home-text-link-primary:focus-visible {
		border-color: rgba(194, 65, 12, 0.4);
		background: linear-gradient(180deg, rgba(249, 115, 22, 0.22), rgba(255, 247, 237, 1));
		color: #7c2d12 !important;
	}

	:global(body.light-theme) .home-text-link-blog {
		border-color: rgba(4, 120, 87, 0.24);
		background: linear-gradient(180deg, rgba(16, 185, 129, 0.12), rgba(236, 253, 245, 0.98));
		color: #047857 !important;
		box-shadow: 0 12px 26px rgba(4, 120, 87, 0.09);
	}

	:global(body.light-theme) .home-text-link-blog:hover,
	:global(body.light-theme) .home-text-link-blog:focus-visible {
		border-color: rgba(4, 120, 87, 0.36);
		background: linear-gradient(180deg, rgba(16, 185, 129, 0.18), rgba(236, 253, 245, 1));
		color: #065f46 !important;
	}

	:global(body.light-theme) .home-text-link-review {
		border-color: rgba(3, 105, 161, 0.22);
		background: linear-gradient(180deg, rgba(14, 165, 233, 0.12), rgba(240, 249, 255, 0.98));
		color: #0369a1 !important;
		box-shadow: 0 12px 26px rgba(3, 105, 161, 0.08);
	}

	:global(body.light-theme) .home-text-link-review:hover,
	:global(body.light-theme) .home-text-link-review:focus-visible {
		border-color: rgba(3, 105, 161, 0.34);
		background: linear-gradient(180deg, rgba(14, 165, 233, 0.18), rgba(240, 249, 255, 1));
		color: #075985 !important;
	}

	:global(.home-page .home-action-icon) {
		width: 1rem;
		height: 1rem;
		flex: 0 0 auto;
		stroke-width: 2.2;
	}

	.home-pick-card,
	.home-review-card,
	.home-section-card {
		border: 1px solid var(--home-border);
		border-radius: 0.5rem;
		background: var(--home-surface);
		box-shadow: var(--home-panel-shadow);
	}

	.home-brief-card,
	.home-post-card,
	.home-empty {
		border: 1px solid var(--home-blog-border);
		border-radius: 0.5rem;
		background: var(--home-blog-surface);
	}

	.home-section {
		margin-top: 2.65rem;
	}

	.home-feature-row {
		display: grid;
		gap: 1.2rem;
		margin-top: 2.65rem;
	}

	.home-feature-panel {
		min-width: 0;
	}

	.home-feature-panel .home-section-heading {
		align-items: center;
		min-height: 2.45rem;
	}

	.home-section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.home-section-heading h2 {
		color: var(--home-text);
		font-size: 1.65rem;
		font-weight: 800;
	}

	.home-pick-grid,
	.home-section-grid,
	.home-post-grid {
		display: grid;
		gap: 0.75rem;
	}

	.home-pick-grid {
		max-width: 46rem;
		gap: 0.35rem;
	}

	.home-pick-card,
	.home-review-card,
	.home-section-card,
	.home-brief-card,
	.home-post-card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 0.85rem;
		transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
	}

	.home-pick-card {
		display: grid;
		grid-template-columns: minmax(4.5rem, auto) minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.55rem;
		padding: 0.42rem 0.58rem;
	}

	.home-card-icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.8rem;
		height: 1.8rem;
		border-radius: 999px;
		border: 1px solid rgba(251, 146, 60, 0.26);
		background: rgba(249, 115, 22, 0.1);
		color: var(--home-accent);
		transition:
			background 160ms ease,
			border-color 160ms ease,
			transform 160ms ease;
	}

	.home-pick-card:hover,
	.home-review-card:hover,
	.home-section-card:hover {
		transform: translateY(-2px);
		border-color: var(--home-border-strong);
		background: var(--home-surface-strong);
		text-decoration: none;
	}

	.home-review-card {
		border-color: rgba(125, 211, 252, 0.18);
		background: linear-gradient(180deg, rgba(14, 165, 233, 0.095), rgba(255, 255, 255, 0.04));
	}

	.home-review-card:hover,
	.home-review-card:focus-visible {
		border-color: rgba(125, 211, 252, 0.34);
		background: linear-gradient(180deg, rgba(14, 165, 233, 0.14), rgba(255, 255, 255, 0.06));
	}

	:global(body.light-theme) .home-review-card {
		border-color: rgba(3, 105, 161, 0.16);
		background: linear-gradient(180deg, rgba(240, 249, 255, 0.92), rgba(255, 255, 255, 0.96));
	}

	:global(body.light-theme) .home-review-card:hover,
	:global(body.light-theme) .home-review-card:focus-visible {
		border-color: rgba(3, 105, 161, 0.28);
		background: linear-gradient(180deg, rgba(224, 242, 254, 0.96), rgba(255, 255, 255, 1));
	}

	.home-pick-card:hover .home-card-icon-button,
	.home-pick-card:focus-visible .home-card-icon-button {
		border-color: rgba(251, 146, 60, 0.5);
		background: rgba(249, 115, 22, 0.18);
		transform: translateX(2px);
	}

	.home-brief-card:hover,
	.home-post-card:hover {
		transform: translateY(-2px);
		border-color: var(--home-blog-border-strong);
		background: var(--home-blog-surface-strong);
		text-decoration: none;
	}

