---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import LibraryIcon from '../../components/library/LibraryIcon.astro';
import { getCollection } from 'astro:content';
import { getAllPosts } from '../../utils/blog';
import FormattedDate from '../../components/FormattedDate.astro';
import { useTranslations } from '../../i18n/ui';
import type { UILanguage } from '../../i18n/ui';
import {
	formatPaperAuthors,
	getAcademicReviewsByLanguage,
	getAcademicReviewUrlFromEntry,
	getPublishedAcademicReviews,
} from '../../utils/academic-review-routing';
import { getBlogUrlFromId } from '../../utils/blog-routing';
import {
	getLatestBlogPosts,
	getLatestBriefPosts,
	getPostsForLanguage,
} from '../../utils/homepage';
import { getLibrarySectionPath, getUsefulFeedItems } from '../../utils/library';
import { librarySections } from '../../data/librarySections';
import { recentPicksLimit } from '../../data/libraryPolicy';
import { getPickFacts, getPickSectionCounts, getPickSlug, getRecentPicks, formatStarCount, type PopularitySnapshot } from '../../utils/picks';
import popularity from '../../data/popularity.json';
import PostThumb from '../../components/blog/PostThumb.astro';
import ResourceVisual from '../../components/art/ResourceVisual.astro';
import { formatPostDate } from '../../utils/display';
import '../../styles/lists.css';

export function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'jp' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang ?? 'ko') as UILanguage;
const t = useTranslations(currentLang);
const languageBasePath = `/${currentLang}`;
const blogUrl = `${languageBasePath}/blog`;
const libraryUrl = `${languageBasePath}/library`;
const usefulFeedsUrl = `${languageBasePath}/library/useful-feeds`;
const researchUrl = `${languageBasePath}/research`;

const allPosts = await getAllPosts();
const allResources = await getCollection('resources');
const allAcademicReviews = await getCollection('academicReviews');
const allPicks = await getCollection('picks');

const posts = getPostsForLanguage(allPosts, currentLang);
const latestBriefs = getLatestBriefPosts(posts, 3);
const latestPosts = getLatestBlogPosts(posts, 6);
const academicReviews = getAcademicReviewsByLanguage(
	getPublishedAcademicReviews(allAcademicReviews),
	currentLang,
).slice(0, 3);

// Useful Feeds panel (docs/decisions/site-structure.md#3, revision 2026-09-27):
// up to 3 newest approved resources, rendered exactly as delivered — the same
// shared helper /{lang}/library/useful-feeds.astro uses, so the two surfaces
// cannot silently disagree about what "newest" means.
const usefulFeedItems = getUsefulFeedItems(allResources, currentLang).slice(0, 3);

// Library block (docs/decisions/site-structure.md#4): up to `recentPicksLimit`
// most recently added published picks. Below 3 published picks, a compact
// card list has nothing to compare itself against, so the block falls back
// to section cards (only for sections that actually have a published pick)
// plus a Useful Feeds link card. At zero picks that fallback is just the
// Useful Feeds card.
const publishedPickCount = allPicks.filter((pick) => pick.data.draft !== true).length;
const hasEnoughRecentPicks = publishedPickCount >= 3;
const recentPicks = hasEnoughRecentPicks ? getRecentPicks(allPicks, recentPicksLimit) : [];

const pickSectionCounts = getPickSectionCounts(allPicks.filter((pick) => pick.data.draft !== true));
const sectionsWithPicks = hasEnoughRecentPicks
	? []
	: librarySections
			.map((section) => ({ ...section, count: pickSectionCounts.get(section.slug) ?? 0 }))
			.filter((section) => section.count > 0);

function getPickSectionLabel(pick: (typeof allPicks)[number]) {
	const section = librarySections.find((item) => item.slug === pick.data.section);
	return section?.label[currentLang] ?? pick.data.section;
}

function getPickStarLine(pick: (typeof allPicks)[number]) {
	const facts = getPickFacts(pick.data, popularity as PopularitySnapshot);
	if (facts.stars === null || !facts.starsAsOf) return null;
	return t('library.pick.stars-as-of').replace('{stars}', formatStarCount(facts.stars)).replace('{date}', facts.starsAsOf);
}

function getPickKindLabel(pick: (typeof allPicks)[number]) {
	return t(`library.pick.kind.${pick.data.kind}` as Parameters<typeof t>[0]);
}

const featuredPost = latestPosts[0];
const otherPosts = latestPosts.slice(1);

const formatCount = (count: number) => t('library.item-count').replace('{count}', String(count));
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={t('home.meta.title')} description={t('home.meta.description')} lang={currentLang} />
		<meta data-pagefind-meta="title[content]" content={t('home.meta.title')} />
		<meta data-pagefind-meta="description[content]" content={t('home.meta.description')} />
		<meta data-pagefind-filter="language[content]" content={currentLang} />
		<meta data-pagefind-filter="section[content]" content="home" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<div class="global-wrapper" data-is-root-path="true">
			<main id="main-content" class="atelier-page home-page" data-pagefind-body>
				<div class="home-primary page-frame">
					<section class="home-section home-latest" aria-labelledby="home-latest-title">
						<div class="column-heading">
							<h2 id="home-latest-title">{t('home.latest.title')}</h2>
							<a href={blogUrl} class="home-link">{t('home.latest.view-all')}</a>
						</div>
						{featuredPost ? (
							<Fragment>
								<a href={getBlogUrlFromId(featuredPost.id)} class="home-featured">
									<PostThumb post={featuredPost} sizes="(max-width: 539px) 100vw, 144px" />
									<div class="home-featured-copy">
										<p class="eyebrow">{t('home.featured.label')} · <FormattedDate date={featuredPost.data.pubDate} /></p>
										<h3>{featuredPost.data.title}</h3>
										<p class="home-featured-description">{featuredPost.data.description}</p>
									</div>
								</a>
								{otherPosts.length > 0 && (
									<ul class="rule-list home-post-list">
										{otherPosts.map((post) => (
											<li>
												<a href={getBlogUrlFromId(post.id)} class="home-post-row">
													<time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
													<PostThumb post={post} sizes="64px" />
													<h3>{post.data.title}</h3>
												</a>
											</li>
										))}
									</ul>
								)}
							</Fragment>
						) : (
							<div class="home-empty">{t('blog.no-posts')}</div>
						)}
					</section>

					<section class="home-feature-panel home-reviews" aria-labelledby="home-reviews-title">
						<div class="column-heading">
							<h2 id="home-reviews-title">{t('home.reviews.title')}</h2>
							<a href={researchUrl} class="home-link">{t('home.reviews.view-all')}</a>
						</div>
						{academicReviews.length > 0 ? (
							<ul class="rule-list home-review-list">
								{academicReviews.map((review) => {
									const paper = review.data.paper;
									const source = [paper.venue, paper.year ? String(paper.year) : null].filter(Boolean).join(' · ');
									return (
										<li>
											<a href={getAcademicReviewUrlFromEntry(review)} class="home-review-row">
												<div class="home-review-topline">
													<span class="chip state-chip--reviewed">{t('home.reviews.state')}</span>
													<span class="home-review-source">{source || t('home.reviews.paper')}</span>
												</div>
												<h3>{review.data.title}</h3>
												<p>{paper.title}</p>
												<span class="home-review-authors">{formatPaperAuthors(paper.authors)}</span>
											</a>
										</li>
									);
								})}
							</ul>
						) : (
							<div class="home-empty">{t('home.reviews.empty')}</div>
						)}
					</section>
				</div>

				<div class="home-band">
					<div class="page-frame">
						<section class="home-section home-feeds" aria-labelledby="home-feeds-title">
							<div class="column-heading">
								<h2 id="home-feeds-title">{t('home.feeds.title')}</h2>
								<a href={usefulFeedsUrl} class="home-link">{t('home.feeds.view-all')}</a>
							</div>
							{usefulFeedItems.length > 0 ? (
								<ul class="rule-list home-feed-list">
									{usefulFeedItems.map((item) => (
										<li>
											<a href={item.url} target="_blank" rel="noopener noreferrer" class="home-feed-row">
												<span class="home-feed-source">{item.source}</span>
												<h3>{item.title}</h3>
												<span class="home-feed-date">{item.date}</span>
											</a>
										</li>
									))}
								</ul>
							) : (
								<div class="home-empty">{t('home.feeds.empty')}</div>
							)}
						</section>

						<section class="home-section home-library" aria-labelledby="home-library-title">
							<div class="column-heading">
								<h2 id="home-library-title">{t('home.library.selected')}</h2>
								<a href={libraryUrl} class="home-link">{t('home.primary-cta')}</a>
							</div>
							{hasEnoughRecentPicks ? (
								<ul class="home-pick-grid">
									{recentPicks.map((pick) => {
										const starLine = getPickStarLine(pick);
										return (
											<li>
												<a href={pick.data.url} target="_blank" rel="noopener noreferrer" class="home-pick">
													<ResourceVisual kind={pick.data.kind} seed={getPickSlug(pick.id)} />
													<p class="home-pick-label">{getPickKindLabel(pick)} · {getPickSectionLabel(pick)}</p>
													<h3>{pick.data.title}</h3>
													{starLine && <p class="home-pick-meta">{starLine}</p>}
												</a>
											</li>
										);
									})}
								</ul>
							) : (
								<ul class="home-pick-grid home-section-grid">
									{sectionsWithPicks.map((section) => (
										<li>
											<a href={getLibrarySectionPath(currentLang, section.slug)} class="home-section-card">
												<p class="home-pick-label">{section.label[currentLang]}</p>
												<p class="home-section-card-text">{section.description[currentLang]}</p>
												<div class="home-section-card-footer">
													<span class="chip">{formatCount(section.count)}</span>
													<span class="home-section-card-open">{t('library.open-section')}</span>
												</div>
											</a>
										</li>
									))}
									<li>
										<a href={usefulFeedsUrl} class="home-section-card">
											<p class="home-pick-label">{t('library.tab.useful-feeds')}</p>
											<p class="home-section-card-text">{t('library.useful-feeds.intro')}</p>
											<div class="home-section-card-footer">
												<span class="home-section-card-open">{t('library.open-section')}</span>
											</div>
										</a>
									</li>
								</ul>
							)}
						</section>
					</div>
				</div>

				{latestBriefs.length > 0 && (
					<section class="home-section home-briefs page-frame" aria-labelledby="home-briefs-title">
						<div class="column-heading">
							<h2 id="home-briefs-title">{t('home.briefs.title')}</h2>
						</div>
						<ul class="rule-list home-brief-list">
							{latestBriefs.map((post) => (
								<li>
									<a href={getBlogUrlFromId(post.id)} class="home-brief-row">
										<time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</a>
								</li>
							))}
						</ul>
					</section>
				)}
			</main>
		</div>
		<Footer />
	</body>
</html>

<style>
	.home-page {
		padding-bottom: 0;
	}

	/* ── Primary: latest writing | academic reviews ── */
	.home-primary {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.8fr);
		gap: 0 2.5rem;
		padding-top: 2rem;
		padding-bottom: 2.5rem;
	}

	.home-latest,
	.home-reviews {
		min-width: 0;
	}

	h3 {
		margin: 0;
	}

	.column-heading h2 {
		word-break: keep-all;
	}

	/* Featured post */
	.home-featured {
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: 1.25rem;
		align-items: stretch;
		padding-bottom: 1.5rem;
	}

	.home-featured :global(.post-thumb) {
		width: 100%;
		height: 100%;
		min-height: 9.5rem;
	}

	.home-featured-copy {
		min-width: 0;
	}

	.home-featured-copy .eyebrow {
		margin-bottom: 0.6rem;
	}

	.home-featured-copy h3 {
		margin-bottom: 0.75rem;
		font: 400 clamp(1.75rem, 2.7vw, 2.5rem) / 1.12 var(--font-serif);
		letter-spacing: -0.03em;
		overflow-wrap: anywhere;
		transition: color 160ms ease;
	}

	.home-featured:hover h3 {
		color: var(--accent);
	}

	.home-featured-description {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		max-width: 36rem;
		margin: 0 0 1rem;
		font-size: 0.875rem;
		line-height: 1.65;
		color: var(--secondary);
	}

	/* Post rows */
	.home-post-row {
		display: grid;
		grid-template-columns: 5.5rem 64px minmax(0, 1fr);
		gap: 0 0.9rem;
		align-items: center;
		padding: 0.7rem 0;
	}

	.home-post-row time,
	.home-brief-row time {
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.06em;
		color: var(--secondary);
	}

	.home-post-row :global(.post-thumb) {
		width: 64px;
		height: 43px;
	}

	.home-post-row h3 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font: 400 1.0625rem/1.25 var(--font-serif);
		transition: color 160ms ease;
	}

	.home-post-row:hover h3,
	.home-brief-row:hover h3,
	.home-feed-row:hover h3,
	.home-review-row:hover h3,
	.home-pick:hover h3 {
		color: var(--accent);
	}

	/* Reviews */
	.home-review-row {
		display: grid;
		gap: 0.3rem;
		padding: 0.85rem 0;
	}

	.home-review-topline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.75rem;
	}

	.home-review-source,
	.home-review-authors {
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.home-review-row h3 {
		font: 400 1.1875rem/1.25 var(--font-serif);
		transition: color 160ms ease;
	}

	.home-review-row p {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--secondary);
	}

	.home-review-authors {
		text-transform: none;
	}

	.home-empty {
		padding: 0.2rem 0 0.4rem;
		font-size: 0.875rem;
		color: var(--secondary);
	}

	/* ── Useful feeds + library picks (same paper as the page) ── */
	.home-band > .page-frame {
		padding-block: 0 2.5rem;
	}

	.home-band .home-library {
		margin-top: 2.5rem;
	}

	.home-feed-row {
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr) auto;
		gap: 0 1rem;
		align-items: baseline;
		padding: 0.8rem 0;
	}

	.home-feed-source,
	.home-feed-date,
	.home-pick-label {
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--secondary);
	}

	.home-feed-source {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.home-feed-row h3 {
		font: 400 1.1875rem/1.25 var(--font-serif);
		transition: color 160ms ease;
	}

	.home-pick-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-pick {
		display: block;
	}

	.home-pick .home-pick-label {
		margin: 0.9rem 0 0.4rem;
	}

	.home-pick h3 {
		font: 400 1.375rem/1.15 var(--font-serif);
		letter-spacing: -0.02em;
		transition: color 160ms ease;
	}

	.home-pick-meta {
		margin: 0.4rem 0 0;
		font-size: 0.8125rem;
		color: var(--secondary);
	}

	/* Fewer than three picks: section cards */
	.home-section-card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		height: 100%;
	}

	.home-section-card:hover .home-section-card-open {
		color: var(--accent);
	}

	.home-section-card .home-pick-label {
		margin: 0;
	}

	.home-section-card-text {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--secondary);
	}

	.home-section-card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: auto;
		padding-top: 0.6rem;
	}

	.home-section-card-open {
		font: 400 0.6875rem/1.45 var(--font-mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	/* ── Briefs ── */
	.home-briefs {
		padding-block: 2.5rem 4rem;
	}

	.home-brief-row {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		gap: 0.25rem 1rem;
		padding: 0.85rem 0;
	}

	.home-brief-row h3 {
		font: 400 1.1875rem/1.25 var(--font-serif);
		transition: color 160ms ease;
	}

	.home-brief-row p {
		grid-column: 2;
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--secondary);
	}

	/* ── Breakpoints (540 / 800 / 1100) ── */
	@media (max-width: 799px) {
		.home-primary {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-reviews {
			margin-top: 2.5rem;
		}

		.home-pick-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 539px) {
		.home-featured {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-featured :global(.post-thumb) {
			height: 8rem;
			min-height: 0;
		}

		.home-post-row {
			grid-template-columns: 64px minmax(0, 1fr);
			gap: 0.15rem 0.9rem;
		}

		.home-post-row time {
			grid-column: 2;
			grid-row: 1;
		}

		.home-post-row :global(.post-thumb) {
			grid-column: 1;
			grid-row: 1 / span 2;
		}

		.home-post-row h3 {
			grid-column: 2;
			grid-row: 2;
		}

		.home-feed-row {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.2rem;
		}

		.home-feed-source {
			order: -1;
		}

		.home-pick-grid {
			grid-template-columns: minmax(0, 1fr);
			--resource-art-height: 10rem;
		}

		.home-brief-row {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-brief-row p {
			grid-column: 1;
		}
	}
</style>
