---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { useTranslations } from '../../i18n/ui';
import type { UILanguage } from '../../i18n/ui';
import { getBlogUrlFromId } from '../../utils/blog-routing';

export function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'jp' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang ?? 'ko') as UILanguage;
const t = useTranslations(currentLang);
const languageBasePath = `/${currentLang}`;
const blogUrl = `${languageBasePath}/blog`;
const libraryUrl = `${languageBasePath}/library`;
const pathsUrl = `${languageBasePath}/paths`;
const searchUrl = `${languageBasePath}/search`;

// Filter posts by language and get latest posts
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.id.startsWith(`${currentLang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts.slice(0, 4);
const remaining = posts.slice(4);
const focusCards = [
	{
		title: t('home.focus.build.title'),
		description: t('home.focus.build.description'),
	},
	{
		title: t('home.focus.papers.title'),
		description: t('home.focus.papers.description'),
	},
	{
		title: t('home.focus.library.title'),
		description: t('home.focus.library.description'),
	},
];
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<BaseHead title={t('home.meta.title')} description={t('home.meta.description')} lang={currentLang} />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<div class="global-wrapper" data-is-root-path="true">
			<main id="main-content" class="max-w-5xl mx-auto px-4 py-10 space-y-16">
				<section class="home-hero" aria-labelledby="home-title">
					<p class="home-eyebrow">{t('home.eyebrow')}</p>
					<div class="home-hero-grid">
						<div class="space-y-5">
							<h1 id="home-title" class="home-title">{t('home.title')}</h1>
							<p class="home-subtitle">{t('home.subtitle')}</p>
							<p class="home-description">{t('home.description')}</p>
							<div class="home-actions" aria-label={t('home.actions-label')}>
								<a href={libraryUrl} class="home-action home-action-primary">{t('home.primary-cta')}</a>
								<a href={blogUrl} class="home-action">{t('home.secondary-cta')}</a>
								<a href={pathsUrl} class="home-action">{t('home.paths-cta')}</a>
								<a href={searchUrl} class="home-action">{t('home.search-cta')}</a>
							</div>
						</div>
						<div class="home-focus-list" aria-label={t('home.focus-label')}>
							{focusCards.map((card) => (
								<article class="home-focus-card">
									<h2>{card.title}</h2>
									<p>{card.description}</p>
								</article>
							))}
						</div>
					</div>
				</section>

				<section>
					<h1 class="text-3xl font-bold mb-4 flex items-center justify-between">
						<span>{t('blog.recent-posts')}</span>
					</h1>
					<div class="featured-container">
						<div class="featured-scroller" role="region" aria-label={t('blog.recent-posts')}>
							{featured.map((post) => {
								const postUrl = getBlogUrlFromId(post.id);
								const hero = post.data.heroImage ?? '/images/blank.png';
								return (
									<a href={postUrl} class="featured-card group">
										<div class="featured-card__image">
											<img src={hero} alt={post.data.title} loading="lazy" decoding="async" />
										</div>
										<div class="featured-card__body">
											<p class="featured-card__meta">
												<FormattedDate date={post.data.pubDate} />
											</p>
											<h2 class="featured-card__title">{post.data.title}</h2>
											<p>{post.data.description}</p>
										</div>
									</a>
								);
							})}
							{featured.length === 0 && (
								<div class="text-slate-500 dark:text-slate-400">{t('blog.no-posts')}</div>
							)}
						</div>
					</div>
				</section>

				{remaining.length > 0 && (
					<section>
						<h2 class="text-2xl font-semibold mb-6 text-slate-900 dark:text-white">{t('blog.all-posts')}</h2>
						<ol style="list-style: none; padding: 0; margin: 0;">
							{remaining.map((post) => {
								const postUrl = getBlogUrlFromId(post.id);
								return (
									<li class="border-b border-slate-200/40 dark:border-slate-700/40 py-5">
										<a href={postUrl} class="post-list-link">
											<h3 class="post-list-title">{post.data.title}</h3>
											<p class="post-list-meta"><FormattedDate date={post.data.pubDate} /></p>
											{post.data.description && <p class="post-list-desc">{post.data.description}</p>}
										</a>
									</li>
								);
							})}
						</ol>
					</section>
				)}
			</main>
		</div>
		<Footer />
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const container = document.querySelector('.featured-container');
				const scroller = container?.querySelector('.featured-scroller');
				if (!container || !scroller) return;

				const updateShadow = () => {
					const hasOverflow = scroller.scrollWidth - scroller.clientWidth > 4;
					const nearEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 4;
					container.dataset.scrollable = hasOverflow && !nearEnd ? 'true' : 'false';
				};

				updateShadow();
				window.addEventListener('resize', updateShadow);
				scroller.addEventListener('scroll', updateShadow, { passive: true });
			});
		</script>
	</body>
</html>

<style>
	.home-hero {
		border-radius: 1.5rem;
		border: 1px solid rgba(148, 163, 184, 0.22);
		background:
			linear-gradient(135deg, rgba(15, 23, 42, 0.08), rgba(249, 115, 22, 0.08)),
			rgba(255, 255, 255, 0.68);
		padding: clamp(1.5rem, 4vw, 2.5rem);
		box-shadow: 0 24px 70px rgba(15, 23, 42, 0.08);
	}

	.dark .home-hero {
		border-color: rgba(248, 249, 250, 0.12);
		background:
			linear-gradient(135deg, rgba(248, 249, 250, 0.08), rgba(249, 115, 22, 0.08)),
			rgba(15, 23, 42, 0.4);
		box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
	}

	.home-eyebrow {
		margin-bottom: 1rem;
		color: rgb(234, 88, 12);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.dark .home-eyebrow {
		color: rgb(251, 146, 60);
	}

	.home-hero-grid {
		display: grid;
		gap: 2rem;
		align-items: end;
	}

	@media (min-width: 860px) {
		.home-hero-grid {
			grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
		}
	}

	.home-title {
		max-width: 13ch;
		color: rgb(15, 23, 42);
		font-size: clamp(2.5rem, 7vw, 4.75rem);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: 0;
	}

	.dark .home-title {
		color: rgb(248, 249, 250);
	}

	.home-subtitle {
		max-width: 42rem;
		color: rgb(51, 65, 85);
		font-size: clamp(1.15rem, 2.2vw, 1.5rem);
		line-height: 1.65;
	}

	.dark .home-subtitle {
		color: rgb(226, 232, 240);
	}

	.home-description {
		max-width: 44rem;
		color: rgb(100, 116, 139);
		font-size: 1rem;
		line-height: 1.75;
	}

	.dark .home-description {
		color: rgb(148, 163, 184);
	}

	.home-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.home-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.75rem;
		border-radius: 999px;
		border: 1px solid rgba(148, 163, 184, 0.35);
		padding: 0.7rem 1rem;
		color: rgb(30, 41, 59);
		font-size: 0.95rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
	}

	.home-action:hover {
		transform: translateY(-1px);
		border-color: rgba(249, 115, 22, 0.6);
		background: rgba(249, 115, 22, 0.08);
	}

	.home-action-primary {
		border-color: rgba(249, 115, 22, 0.8);
		background: rgb(249, 115, 22);
		color: white;
	}

	.home-action-primary:hover {
		background: rgb(234, 88, 12);
	}

	.dark .home-action {
		border-color: rgba(248, 249, 250, 0.14);
		color: rgb(226, 232, 240);
	}

	.dark .home-action-primary {
		border-color: rgba(251, 146, 60, 0.9);
		color: white;
	}

	.home-focus-list {
		display: grid;
		gap: 0.85rem;
	}

	.home-focus-card {
		border-radius: 1rem;
		border: 1px solid rgba(148, 163, 184, 0.22);
		background: rgba(255, 255, 255, 0.62);
		padding: 1rem;
	}

	.dark .home-focus-card {
		border-color: rgba(248, 249, 250, 0.1);
		background: rgba(15, 23, 42, 0.55);
	}

	.home-focus-card h2 {
		margin: 0 0 0.45rem;
		color: rgb(15, 23, 42);
		font-size: 1rem;
		font-weight: 800;
	}

	.dark .home-focus-card h2 {
		color: rgb(248, 249, 250);
	}

	.home-focus-card p {
		margin: 0;
		color: rgb(71, 85, 105);
		font-size: 0.92rem;
		line-height: 1.65;
	}

	.dark .home-focus-card p {
		color: rgb(203, 213, 225);
	}

	.featured-container {
		position: relative;
	}

	.featured-container {
		position: relative;
		margin-inline: -1rem;
		padding-inline: 1rem;
		padding-bottom: 3rem;
	}

	.featured-container::after {
		content: '';
		position: absolute;
		right: 1rem;
		top: 0.5rem;
		bottom: 0.85rem;
		width: 3rem;
		pointer-events: none;
		background: linear-gradient(to right, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.85) 100%);
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	:global(body.light-theme) .featured-container::after {
		background: linear-gradient(to right, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.95) 100%);
	}

	.featured-container[data-scrollable='true']::after {
		opacity: 1;
	}

	.featured-scroller {
		display: flex;
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding: 0 1rem;
		padding-bottom: 0.35rem;
	}

	.featured-scroller::-webkit-scrollbar {
		height: 6px;
	}

	.featured-scroller::-webkit-scrollbar-thumb {
		background: rgba(148, 163, 184, 0.4);
		border-radius: 999px;
	}

	.featured-card {
		scroll-snap-align: start;
		border-radius: 1.5rem;
		border: 1px solid rgba(248, 249, 250, 0.1);
		background: rgba(255, 255, 255, 0.04);
		display: flex;
		flex-direction: column;
		text-decoration: none;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
		min-width: clamp(260px, 30vw, 320px);
		padding: 1.2rem;
		gap: 0.85rem;
	}

	.featured-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
	}

	.featured-card__image {
		width: 100%;
		height: 165px;
		border-radius: 1rem;
		overflow: hidden;
		background: rgba(15, 23, 42, 0.6);
	}

	.featured-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.featured-card:hover .featured-card__image img {
		transform: scale(1.04);
	}

	.featured-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		padding-inline: 0.15rem;
	}

	.featured-card__body > *:last-child {
		margin-top: auto;
	}

	.featured-card__meta {
		font-size: 0.875rem;
		color: rgba(148, 163, 184, 0.8);
	}

	.featured-card__title {
		font-size: 1.35rem;
		font-weight: 600;
		line-height: 1.4;
		margin-top: 0;
	}

	@media (max-width: 640px) {
		.featured-scroller {
			grid-auto-columns: 88%;
			padding-left: 1rem;
			margin-left: -1rem;
		}
	}

	.post-list-link {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		color: inherit;
		text-decoration: none;
	}

	.post-list-title {
		font-size: 1.35rem;
		font-weight: 600;
		color: rgb(15, 23, 42);
	}

	.post-list-meta {
		font-size: 0.95rem;
		color: rgba(100, 116, 139, 0.9);
	}

	.post-list-desc {
		font-size: 1rem;
		color: rgba(51, 65, 85, 0.95);
	}

	.dark .post-list-title {
		color: rgb(248, 249, 250);
	}

	.dark .post-list-meta {
		color: rgba(148, 163, 184, 0.9);
	}

	.dark .post-list-desc {
		color: rgba(203, 213, 225, 0.9);
	}
</style>
