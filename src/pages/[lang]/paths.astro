---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import LibraryIcon from '../../components/library/LibraryIcon.astro';
import LibraryPageStyles from '../../components/library/LibraryPageStyles.astro';
import { getAllPosts } from '../../utils/blog';
import { useTranslations, type UILanguage } from '../../i18n/ui';
import { learningPaths } from '../../data/learningPaths';
import {
	getLearningPathUrl,
	getLocalizedPathText,
	getVisibleLearningPaths,
	resolveLearningPathSteps,
} from '../../utils/learning-paths';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = `${t('paths.title')} - Hun-Bot Blog`;
const description = t('paths.meta.description');
const allPosts = await getAllPosts();
const visiblePaths = getVisibleLearningPaths(learningPaths, allPosts, lang).map((path) => ({
	path,
	steps: resolveLearningPathSteps(path, allPosts, lang),
}));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<LibraryPageStyles />
		<meta data-pagefind-meta="title[content]" content={t('paths.title')} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="paths" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main id="main-content" class="atelier-page" data-pagefind-body>
			<section class="subpage-intro">
				<h1 class="eyebrow">{t('paths.title')}</h1>
				<p class="intro-copy">{t('paths.subtitle')}</p>
				<p class="intro-note">{description}</p>
			</section>

			<div class="page-frame">
				<section class="research-section" aria-label={t('paths.title')}>
					<ul class="atelier-rows">
						{visiblePaths.map(({ path, steps }) => (
							<li class="atelier-row">
								<a
									href={getLearningPathUrl(lang, path.id)}
									class="atelier-row-link"
									aria-label={`${getLocalizedPathText(path.title, lang)}: ${t('paths.open-path')}`}
								>
									<div class="atelier-row-head">
										<h2>{getLocalizedPathText(path.title, lang)}</h2>
										<span class="action-label">
											{t('paths.open-path')}
											<LibraryIcon name="arrow-right" />
										</span>
									</div>
									<div class="atelier-row-meta">
										<span>{t('paths.step-count').replace('{count}', String(steps.length))}</span>
										<div class="chip-list" aria-label={t('paths.supporting-label')}>
											{path.topicIds.map((topicId) => <span class="chip">{topicId}</span>)}
											{path.resourceIds.length > 0 && (
												<span class="chip">{t('paths.resources-count').replace('{count}', String(path.resourceIds.length))}</span>
											)}
											{path.deckIds.length > 0 && (
												<span class="chip">{t('paths.decks-count').replace('{count}', String(path.deckIds.length))}</span>
											)}
										</div>
									</div>
									<p class="atelier-row-note">{getLocalizedPathText(path.description, lang)}</p>
								</a>
							</li>
						))}
					</ul>
					{visiblePaths.length === 0 && <p class="empty-line">{t('paths.empty')}</p>}
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
