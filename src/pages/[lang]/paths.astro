---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingLanguagePicker from '../../components/FloatingLanguagePicker.astro';
import LibraryIcon from '../../components/library/LibraryIcon.astro';
import LibraryPageStyles from '../../components/library/LibraryPageStyles.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type UILanguage } from '../../i18n/ui';
import { learningPaths } from '../../data/learningPaths';
import {
	getLearningPathUrl,
	getLocalizedPathText,
	getVisibleLearningPaths,
	resolveLearningPathSteps,
} from '../../utils/learning-paths';

export function getStaticPaths() {
	return [
		{ params: { lang: 'ko' } },
		{ params: { lang: 'jp' } },
		{ params: { lang: 'en' } },
	];
}

const lang = (Astro.params.lang ?? 'ko') as UILanguage;
const t = useTranslations(lang);
const title = `${t('paths.title')} - Hun-Bot Blog`;
const description = t('paths.meta.description');
const allPosts = await getCollection('blog');
const visiblePaths = getVisibleLearningPaths(learningPaths, allPosts, lang).map((path) => ({
	path,
	steps: resolveLearningPathSteps(path, allPosts, lang),
}));
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} lang={lang} />
		<LibraryPageStyles />
		<meta data-pagefind-meta="title[content]" content={t('paths.title')} />
		<meta data-pagefind-meta="description[content]" content={description} />
		<meta data-pagefind-filter="language[content]" content={lang} />
		<meta data-pagefind-filter="section[content]" content="paths" />
	</head>
	<body>
		<Header />
		<FloatingLanguagePicker />
		<main class="library-page mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8" data-pagefind-body>
			<section class="mb-12 max-w-5xl space-y-4">
				<h1 class="text-4xl font-bold tracking-normal text-slate-100 sm:text-5xl">{t('paths.title')}</h1>
				<p class="text-xl leading-relaxed text-slate-300">{t('paths.subtitle')}</p>
				<p class="leading-relaxed text-slate-400">{description}</p>
			</section>

			<section class="grid gap-4 md:grid-cols-2" aria-label={t('paths.title')}>
				{visiblePaths.map(({ path, steps }) => (
					<a
						href={getLearningPathUrl(lang, path.id)}
						class="library-panel library-panel-link"
						aria-label={`${getLocalizedPathText(path.title, lang)}: ${t('paths.open-path')}`}
					>
						<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
							<h2 class="text-xl font-semibold text-slate-100">{getLocalizedPathText(path.title, lang)}</h2>
							<span class="library-badge library-badge--available">{t('paths.available')}</span>
						</div>
						<p class="text-sm leading-relaxed text-slate-400">{getLocalizedPathText(path.description, lang)}</p>
						<div class="mt-5 flex flex-wrap gap-2" aria-label={t('paths.supporting-label')}>
							{path.topicIds.map((topicId) => <span class="library-pill">{topicId}</span>)}
							{path.resourceIds.length > 0 && (
								<span class="library-pill">{t('paths.resources-count').replace('{count}', String(path.resourceIds.length))}</span>
							)}
							{path.deckIds.length > 0 && (
								<span class="library-pill">{t('paths.decks-count').replace('{count}', String(path.deckIds.length))}</span>
							)}
						</div>
						<div class="library-panel-footer">
							<span class="font-medium text-slate-300">
								{t('paths.step-count').replace('{count}', String(steps.length))}
							</span>
							<span class="library-section-button">
								{t('paths.open-path')}
								<LibraryIcon name="arrow-right" />
							</span>
						</div>
					</a>
				))}
				{visiblePaths.length === 0 && (
					<article class="library-panel">
						<p class="text-sm leading-relaxed text-slate-400">{t('paths.empty')}</p>
					</article>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
